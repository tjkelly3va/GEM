{
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(py:*)",
      "Bash(pdftotext:*)",
      "Bash(pdffonts:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git remote -v)"
