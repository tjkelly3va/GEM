    gem:llmScopingNote """HCPCS modifier slot 3 appended to the service line's procedure code (raw STRING); part of the positional array gem:procModifier1..5. The modifier value space corresponds to gem:HCPCSmodifier individuals. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "procModifier3" ;
    gem:memberOfOntology gem:gemOntology .

