    gem:description "A 'Service From Date' is a date datatype property that contains the beginning date of the service period billed on a Medicare claim service line." ;
    gem:llmScopingNote """Service-line start date of service. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:date ;
