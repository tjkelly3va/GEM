gem:shortDescription a owl:AnnotationProperty ;
    rdfs:subPropertyOf gem:description ;
    gem:prefLabel "Short Description" ;
    gem:description "A 'Short Description' is a datatype property that provides a brief human-readable description of what a schema element or instance represents. " ;
    gem:llmDetailedDefinition "A 'Short Description' is an annotation that provides a brief human-readable description of what a schema element or instance represents. " ;
    gem:memberOfOntology gem:gemOntology .

gem:sourceAttribute a owl:DatatypeProperty ;
    gem:prefLabel "Source Attribute" ;
    gem:description "A 'Source Attribute' is a datatype property that contains the field name of the attribute that is sourcing this data value." ;
    gem:llmScopingNote """Provenance/lineage field (the source field name feeding a data value); ontology plumbing with domain owl:Thing. Not coverage-domain content.""" ;
    rdfs:domain owl:Thing ;
    rdfs:range  xsd:string ;
    gem:memberOfOntology gem:gemOntology .

