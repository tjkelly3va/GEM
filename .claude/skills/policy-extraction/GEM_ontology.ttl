gem:transactionId a owl:DatatypeProperty ;
    gem:prefLabel "Transaction Id" ;
    gem:description "A 'Transaction Id' is a string datatype property that contains the unique identifier of the claim transaction submitted to or processed by CMS." ;
    gem:llmScopingNote """Transaction identifier. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "tranId" ;
    gem:memberOfOntology gem:gemOntology .

gem:typeOfService a owl:DatatypeProperty ;
    gem:prefLabel "Type of Service" ;
    gem:description "A 'Type of Service' is a datatype property that contains ..." ;
    gem:llmScopingNote """Type-of-service code; an external CMS code set, not enumerated here. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "typeOfService" ;
    gem:memberOfOntology gem:gemOntology .

gem:units a owl:DatatypeProperty ;
    gem:prefLabel "Units" ;
    gem:description "A 'Units' is a datatype property that contains ..." ;
    gem:llmScopingNote """Quantity/units value on a service line. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:ServiceLine ;
    rdfs:range  xsd:double ;
    gem:sourceAttribute "units" ;
    gem:memberOfOntology gem:gemOntology .

gem:unitsOfService a owl:DatatypeProperty ;
    gem:prefLabel "Units of Service" ;
    gem:description "A 'Units of Service' is a datatype property that contains ..." ;
    gem:llmScopingNote """Units of service billed on the service line. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:HistoricServiceLine ;
    rdfs:range  xsd:double ;
    gem:sourceAttribute "unitsOfService" ;
    gem:memberOfOntology gem:gemOntology .

gem:workflowDescription a owl:AnnotationProperty ;
    gem:prefLabel "Workflow Description" ;
    gem:description "A 'Workflow Description' is an annotation that records how an individual or term came to be in the graph, rather than what it is. It is the extraction process's own notepad: session provenance, URI and manual-token derivation, source-resolution method and pending state, borderline decisions and the reasoning behind them, and cross-references to the methodology files. It exists so that gem:description can be reserved for data consumers -- a concise account of what the entity is, in terms a consumer of the graph needs. Data consumers should read gem:description; gem:workflowDescription carries no coverage-domain content and can be ignored by claim-facing queries." ;
    gem:llmDetailedDefinition "A 'Workflow Description' is process metadata written by the extraction agent for the extraction agent. Never treat its content as an assertion about Medicare coverage: it describes how the record was built, not what the policy says. Typical content includes the session in which an individual was minted or revised, why one modeling option was chosen over another, how a transmittal's manual token was derived and at what priority, whether a source URL is resolved or pending and why, and pointers to SKILL.md, gem_reference.md, gem_rule_categories.md or the worklist's deferred proposals. Introduced at S151 to end the overloading of gem:description, which had accumulated workflow prose on 16% of described subjects -- concentrated on transmittals, NCAs and change requests, where it displaced the consumer-facing account entirely. Single-valued per subject. Ordered immediately after gem:description. Note that the corpus is only forward-compliant as of S151: individuals minted before that session may still carry workflow prose inside gem:description, and the backfill sweep is a deferred proposal." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .


# ============================================================================
# LLM ANNOTATION PROPERTIES
# ============================================================================
# The following annotation properties provide reasoning scaffolding for a
# large language model (LLM) consuming this ontology in a Graph RAG prompt.
# They supplement gem:description (written for human readers) with machine-
# oriented guidance that helps the LLM traverse structures, understand
# controlled vocabularies, and calibrate reasoning confidence.
# -----------------------------------------------------------------------------

gem:llmDetailedDefinition a owl:AnnotationProperty ;
    gem:prefLabel "LLM Detailed Definition" ;
    gem:description "An extended explanation of an ontological term's meaning, modeling rationale, and disambiguation guidance, written for LLM consumption." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:llmEnumeratedValues a owl:AnnotationProperty ;
    gem:prefLabel "LLM Enumerated Values" ;
    gem:description "A closed list of valid string values for a datatype property, with a short definition of each value, written for LLM consumption." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:llmTraversalHint a owl:AnnotationProperty ;
    gem:prefLabel "LLM Traversal Hint" ;
    gem:description "Procedural guidance for navigating a chain or graph structure formed by this property, including start points, traversal direction, and terminal conditions, written for LLM consumption." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:llmCardinalityNote a owl:AnnotationProperty ;
    gem:prefLabel "LLM Cardinality Note" ;
    gem:description "Expected count, multiplicity constraints, or structural rules for this property's usage on instances, stated in natural language, written for LLM consumption." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:llmInverseNote a owl:AnnotationProperty ;
    gem:prefLabel "LLM Inverse Note" ;
    gem:description "Clarifies whether inverse or symmetric relationships are explicitly materialized in the data or must be inferred, and what this means for query strategy, written for LLM consumption." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:llmScopingNote a owl:AnnotationProperty ;
    gem:prefLabel "LLM Scoping Note" ;
    gem:description "Boundary conditions, applicability constraints, or contextual limitations on when this schema element applies, written for LLM consumption." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .


# ============================================================================
# Policy extraction terms
# ============================================================================
#
#  The terms below support the extraction of structured, codeable data from
#  Medicare coverage policy documents (NCDs, LCDs, and MCD Articles) into the
#  GEM ontology.
#
#  Three subclasses of gem:CMSpolicy distinguish the policy document types.
#  gem:referencesPolicy links a policy to another policy it cites.  The
#  covered / non-covered ICD diagnosis properties carry coverage polarity and
#  are sub-properties of the existing polarity-neutral gem:refersToICDdiagnosis,
#  so a query on the neutral property still returns both polarities.
#  gem:ProviderCredential and gem:requiresProviderCredential capture the
#  provider, supplier, and facility qualification concepts a policy invokes.
#

# -----------------------------------------------------------------------------
#    Class Definitions
# -----------------------------------------------------------------------------
gem:ArticlePolicy a owl:Class ;
    rdfs:subClassOf gem:CMSpolicy ;
    gem:prefLabel "Article Policy" ;
    gem:description "An 'Article Policy' is a class of CMS Policy that is an MCD Article -- especially a Billing and Coding Article -- a document issued by a Medicare Administrative Contractor that supplies billing, coding, and related guidance associated with a Local Coverage Determination. Articles are where ICD-10 diagnosis tables and HCPCS code lists most often appear." ;
    gem:llmDetailedDefinition """An MCD Article, typically a Billing and Coding Article attached to an LCD. This is the document type where ICD-10 diagnosis tables and HCPCS code lists most often physically appear, so for CODE-level coverage questions the Article is frequently the richest node even when the coverage RATIONALE lives on the parent LCD or NCD.""" ;
    gem:llmScopingNote """When tracing 'which codes does policy X cover', follow to the associated Article: the NCD/LCD prose may name concepts while the Article holds the enumerated codes.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:BenefitCategory a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    gem:prefLabel "Benefit Category" ;
    gem:description "A 'Benefit Category' is one of the named Medicare benefit categories under which an item or service may fall (e.g. \"Durable Medical Equipment\", \"Ambulance Services\", \"Diagnostic Laboratory Tests\"). Benefit-category individuals are a flat controlled vocabulary of the categories named by processed CMS policies. The class records the policy-level scoping of items and services by Medicare administrative category and is distinct from gem:ClinicalConcept (clinical/physiological terms) and gem:HCPCSprocedure (claim-side codes). Introduced by NCD 310.1, which enumerates the categories whose routine costs are eligible for clinical-trial coverage." ;
    gem:llmDetailedDefinition """A named Medicare benefit category an item or service falls under (e.g. Durable Medical Equipment, Diagnostic Laboratory Tests, Ambulance Services). Statutory/administrative scoping, distinct from clinical concepts (gem:ClinicalConcept) and from claim codes (gem:HCPCSprocedure). Linked from a policy via gem:refersToBenefitCategory (presence, not polarity).""" ;
    gem:llmScopingNote """A statute/NCD-level concept: LCDs carry no benefit category, so do not expect gem:refersToBenefitCategory on a gem:LCDpolicy.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:ClinicalConcept a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    gem:prefLabel "Clinical Concept" ;
    gem:description "A 'Clinical Concept' is a class of clinical, physiological, diagnostic, or therapeutic concept relevant to the domain of a CMS Policy -- for example a condition, finding, measurement, test, therapy, or item of equipment. Members are a flat controlled vocabulary of concept individuals discovered in policy text. Concept-to-concept hierarchy (skos:broader / skos:narrower) and synonym consolidation are deliberately deferred to a later human-reviewed taxonomy pass; this class carries no granularity subtyping. The set of gem:ClinicalConcept individuals and their policy links serves as the concept-review list for medical-professional relevance review." ;
    gem:llmDetailedDefinition """The flat controlled vocabulary of clinical / physiologic / diagnostic / therapeutic terms discovered in policy text; the DENSEST reference layer in the graph (~2000 policy links via gem:refersToClinicalConcept). No concept-to-concept hierarchy (skos:broader/narrower) or synonym consolidation is asserted -- both deferred -- so semantically similar ideas may exist as DISTINCT individuals; do not assume a single canonical concept per idea.""" ;
    gem:llmScopingNote """Presence-only: gem:refersToClinicalConcept records that a concept APPEARS in a policy, NOT how (covered / excluded / criterion). For coverage polarity, go to the policy's rules and covers*/excludes* code links, not to the concept link.""" ;
    gem:llmTraversalHint """A policy links to concepts via gem:refersToClinicalConcept; a code group via gem:identifiesClinicalConcept; a coverage restriction via gem:restrictionConcept; a measurement condition attaches to the concept via gem:hasMeasurementContext. To find every policy touching a concept, query the concept in the object position of gem:refersToClinicalConcept.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:HealthcareSetting a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    gem:prefLabel "Healthcare Setting" ;
    gem:description "A 'Healthcare Setting' is the place of care -- the physical or administrative site at which an item or service is furnished -- as named in a CMS policy's text (for example the patient's home, a physician's office, an outpatient hospital department, or a clinic). Members are a controlled vocabulary of setting individuals discovered in policy text, mirroring gem:ClinicalConcept, with hierarchy expressed among the individuals themselves via skos:broader (e.g. a named clinic type is skos:broader gemi:settingClinic; an outpatient hospital department is skos:broader gemi:settingHospital) -- there are no granularity subclasses. Member labels are the bare place phrase, qualifier-first, no parentheses, never the word 'setting'; the URI is 'setting' + UpperCamelCase(prefLabel). A setting individual is polarity- and rule-neutral: it names a place, not a coverage decision or a coding artifact. Statement-kind distinctions (a device described as 'designed for home use' vs an item 'covered in the home') and claim-coding detail (place-of-service codes, type-of-bill) are rule-scoped and remain in the referencing rule's verbatim text, not on the setting. A policy links to every setting its text names with gem:refersToHealthcareSetting (presence, polarity-neutral). What the policy SAYS about a setting is carried separately by the polarity family introduced at Session 197 -- gem:coversInHealthcareSetting, its closed-list sub-property gem:exclusivelyCoversInHealthcareSetting, and gem:excludesHealthcareSetting -- asserted on the gem:PolicyRule that makes the statement. The presence link and the polarity links are independent observations; a rule-scoped statement is contained in its policy and does not propagate to it. Introduced 2026-07-04 (Session 117) as work item [70]; hierarchy moved from OWL subclassing to skos:broader among individuals and the gem:ClinicSetting subclass retired 2026-07-16 (Session 152) as work item [95]. The individuals form a poly-hierarchy rooted at gemi:settingAnywhere across two orthogonal axes: a facility axis (gemi:settingInstitution over hospital, clinic and hospice and their named types) and an episode axis (gemi:settingInpatient and gemi:settingOutpatient); a place that is both -- e.g. an outpatient or inpatient hospital department -- carries a skos:broader edge to each axis, so a member may have more than one parent. Direct parents use skos:broader; ancestor closure uses skos:broaderTransitive under OWL entailment (Session 175)." ;
    gem:llmDetailedDefinition """A place of care named in policy text (patient's home, physician's office, outpatient hospital department, clinic). A controlled vocabulary of individuals; hierarchy is skos:broader among the individuals (e.g. gemi:settingIndependentClinic skos:broader gemi:settingClinic), NOT OWL subclassing -- there are no granularity subclasses. Polarity-neutral -- it names a place, not a coverage decision. Linked from a policy by gem:refersToHealthcareSetting (presence). Coverage polarity is carried by gem:coversInHealthcareSetting / gem:exclusivelyCoversInHealthcareSetting / gem:excludesHealthcareSetting, normally on a gem:PolicyRule subject; those are sub-properties of the presence predicate but do not replace it.""" ;
    gem:llmScopingNote """A setting individual carries no coverage polarity and no claim-coding detail: place-of-service codes, type-of-bill, and distinctions like 'designed for home use' vs 'covered in the home' stay in the referencing rule's verbatim text. To retrieve a setting family, follow skos:broader inbound from the parent individual (query direction: child skos:broader parent); do not look for setting subclasses. Sparsely populated in current data.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:MeasurementContext a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    gem:prefLabel "Measurement Context" ;
    gem:description "A 'Measurement Context' is the physiologic or temporal condition under which a clinical measurement, test, or therapy is characterized in a CMS policy's text -- for example at rest, during exercise, during sleep, or during the day. Members are a flat controlled vocabulary of context individuals, mirroring gem:ClinicalConcept and gem:HealthcareSetting. The context is normalized (e.g. 'nocturnal', 'overnight', and 'during sleep' all map to gemi:contextDuringSleep); the verbatim source phrasing remains in the referencing concept's label and in the policy's rule text. A concept links to its context via gem:hasMeasurementContext, separating the measurement finding from the condition under which it was taken so a query can retrieve, e.g., all exercise-context findings without parsing composite concept names. Introduced 2026-07-05 (Session 118) as work item [1]." ;
    gem:llmDetailedDefinition """The physiologic or temporal condition under which a measurement, test, or therapy is characterized (at rest, during exercise, during sleep, during the day). Normalized -- e.g. 'nocturnal', 'overnight', and 'during sleep' all map to gemi:contextDuringSleep. Attached to a gem:ClinicalConcept via gem:hasMeasurementContext, separating the finding from the condition under which it was taken so a query can retrieve e.g. all exercise-context findings without parsing composite concept names.""" ;
    gem:llmScopingNote """Sits ON the clinical concept, not on the policy; the verbatim source phrasing remains in the concept's label. Sparsely populated in current data.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:CMSpolicy a owl:Class ;
    gem:prefLabel "CMS Policy" ;
    gem:description "A 'CMS Policy' is a class that provides links to documents that describe the rules, guidelines, and coverage determinations set by the Centers for Medicare & Medicaid Services (CMS). These govern how public healthcare programs (Medicare, Medicaid, and CHIP) operate, what medical services are considered necessary, and how healthcare providers are reimbursed." ;
    gem:llmDetailedDefinition """gem:CMSpolicy is the root class for every coverage-policy DOCUMENT in the graph. Its subclasses are the extractable coverage determinations (gem:NCDpolicy, gem:LCDpolicy, gem:ArticlePolicy) plus the change/reference document types (gem:TransmittalPolicy, gem:ProgramMemorandumPolicy, gem:ChangeRequest, gem:CMSmanualChapter) and the deliberative gem:NCAdocument. It is the rdfs:domain of nearly every policy-side property and the rdfs:range of gem:referencesPolicy. Coverage CONTENT does not live on the CMSpolicy individual itself; it lives on the gem:PolicyRule / gem:PolicyGroup / code-link structure hung off it. Distinguish sharply from the claim-side classes (gem:MedicareClaim, gem:ServiceLine, gem:EditRequest, gem:Beneficiary), which are NOT policies and never appear as gem:referencesPolicy targets.""" ;
    gem:llmScopingNote """A CMSpolicy individual may be a fully-extracted policy OR a bare stub. If its gem:nextPlannedStep is gem:planPromote it is a stub minted only because another policy referenced it: its coverage rules and code links are NOT yet in the graph, so an absence of rules under it means 'not yet extracted', not 'covers nothing'. Confirm gem:nextPlannedStep = gem:planDone before treating missing content as authoritative.""" ;
    gem:llmTraversalHint """From a CMSpolicy individual: to answer 'what does this policy cover/exclude', traverse gem:hasPolicyRule -> gem:PolicyRule, then each rule's gem:coversCondition / gem:excludesCondition / gem:coversProcedure / gem:excludesProcedure (and the exclusivelyCovers* variants) to reach ICD/HCPCS codes; also gem:hasCoverageQualifier / gem:hasCoverageExclusion / gem:hasCoverageRestriction and gem:refersToClinicalConcept for narrative criteria. To trace document lineage, follow gem:revisesPolicy / gem:revisedByPolicy (revision chain) and gem:referencesPolicy (all citations). To learn the document's currentness and work-state, read gem:isInEffect and gem:nextPlannedStep.""" ;
    gem:isaPrimaryClass true ;
    gem:memberOfOntology gem:gemOntology .

gem:CodeGroup a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    gem:prefLabel "Code Group" ;
    gem:description "A 'Code Group' is a named, reusable set of billing codes -- drawn from any of HCPCS (Level II), CPT (Level I), or ICD-10-CM -- that generalizes a collection of codes under a single queryable term, so a query can name the group instead of enumerating individual code strings. Membership is expressed two ways, used singly or together: an enumerated curated core via skos:narrower to each member code IRI (for arbitrary sets that have no code-prefix pattern, e.g. Respiratory Assist Devices = E0470-E0472), and -- for prefix-defined structural groups such as the HCPCS Level II letter categories -- a gem:memberCodePattern regular expression matched against code IRIs (declared 2026-06-30, Session 104, when the HCPCS Level II letter categories were minted). A Code Group is a cross-policy controlled-vocabulary individual in the gemi: namespace, reused across policies; it is NOT policy-specific (contrast gem:PolicyGroup, whose instances are not shared across policies) and NOT a node in any code system's own hierarchy (contrast gem:ICDgrouping, the ICD-10 block/chapter ranges). Code groups may overlap (a code may belong to several groups); no disjointness is asserted. A group MAY identify zero or more gem:ClinicalConcept individuals via gem:identifiesClinicalConcept, and carries a responsible party via gem:codeGroupOwner (a sub-property of dcterms:rightsHolder; CMS-policy-derived groups carry \"CMS\"). Subclass of skos:Concept (matching gem:ClinicalConcept, gem:BenefitCategory, gem:ICDconcept), which keeps skos:narrower domain/range-consistent; this is the project's first committed use of skos:narrower hierarchy, which gem:ClinicalConcept deliberately defers. Introduced 2026-06-30 (Session 103)." ;
    gem:llmDetailedDefinition """A named, reusable CROSS-POLICY set of billing codes (HCPCS Level II, CPT Level I, or ICD-10-CM) in the gemi: namespace, so a query can name the group instead of enumerating code strings. Membership is expressed two ways, singly or together: enumerated skos:narrower to each member code IRI, and/or a gem:memberCodePattern regex matched against code IRIs (for prefix-defined structural groups like the HCPCS letter categories). Distinguish from gem:PolicyGroup (policy-specific, not shared, an anchor-scope) and from gem:ICDgrouping (a node in ICD-10's own block/chapter hierarchy). Groups may overlap; no disjointness is asserted.""" ;
    gem:llmScopingNote """gem:refersToCodeGroup links to groups are DERIVED/materialized (recomputed from policy code references intersected with current membership), not source assertions.""" ;
    gem:llmTraversalHint """To resolve a group's members: collect its skos:narrower targets AND, for each gem:memberCodePattern, REGEX-match STR(?code) over individuals typed gem:HCPCSprocedure / gem:CPTprocedure / gem:ICDdiagnosis. A policy links to a group it touches via gem:refersToCodeGroup; a group links to the concept(s) it represents via gem:identifiesClinicalConcept.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:CoverageQualifier a owl:Class ;
    gem:prefLabel "Coverage Qualifier" ;
    gem:description "A 'Coverage Qualifier' is an abstract parent class representing a condition that qualifies the scope of an otherwise-positive coverage decision attached to a gem:CoverageOutcome. Two concrete subclasses share this parent because they both qualify the coverage decision in the same structural role on the outcome: gem:CoverageRestriction (narrows what is covered) and gem:CoverageExclusion (carves out a sub-case that is not covered). Instances are never asserted directly against this class; they are typed as members of one of the concrete subclasses. The abstract framing supports cross-cutting queries via gem:hasCoverageQualifier, which transparently includes both subclass kinds via RDFS inference over the sub-properties gem:hasCoverageRestriction and gem:hasCoverageExclusion. Follows the S60 abstract-umbrella precedent established for gem:AnchoredCodingScope over gem:PolicyGroup + gem:PolicyCodingRule. Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72 codifying the S68-resolved CoverageQualifier hierarchy; see gem_structured_rule_guide.md §Schema Model for the full design." ;
    gem:llmDetailedDefinition """Abstract parent of the two THEN-clause qualifiers on a gem:CoverageOutcome: gem:CoverageRestriction (narrows what IS covered) and gem:CoverageExclusion (carves out a sub-case that is NOT covered). Never instantiated directly; reached via the umbrella property gem:hasCoverageQualifier.""" ;
    gem:llmScopingNote """This element belongs to the deferred structured coverage-outcome layer (Phase 2/3 of work item #72). In the current instance data it carries NO instances/edges: the coverage narrowing it is meant to structure currently lives verbatim in gem:ruleDescription on the associated gem:PolicyRule (frequently a gem:ruleType_nonCoverage or gem:ruleType_coverageScope rule). Do not rely on this element at retrieval time in the present data; read the rule text. Treat this note as forward-looking and re-check population status at each checkpoint.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:CoverageExclusion a owl:Class ;
    rdfs:subClassOf gem:CoverageQualifier ;
    gem:prefLabel "Coverage Exclusion" ;
    gem:description "A 'Coverage Exclusion' is a concrete subclass of gem:CoverageQualifier that explicitly carves out a sub-case which is NOT covered within an otherwise-positive coverage outcome. Distinct from gem:CoverageRestriction because exclusions name something that is not covered (e.g., NCD 240.2 Group I sleep bullet's 'Portable oxygen, therefore, would not be covered in this situation'), while restrictions narrow what is covered (e.g., the same bullet's 'coverage is provided only for use of oxygen during sleep'). The semantic distinction is real and durable: type-driven dispatch by downstream consumers benefits from the distinct typing. Attached to a gem:CoverageOutcome via gem:hasCoverageExclusion (a sub-property of gem:hasCoverageQualifier). The clinical concept being excluded is named via gem:excludedConcept; the human-readable description via gem:exclusionDescription. Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72; see gem_structured_rule_guide.md §Schema Model." ;
    gem:llmDetailedDefinition """Concrete qualifier naming a sub-case that is NOT covered within an otherwise-positive outcome. Contrast gem:CoverageRestriction, which narrows what IS covered. The excluded concept is named via gem:excludedConcept; the human-readable text via gem:exclusionDescription.""" ;
    gem:llmScopingNote """This element belongs to the deferred structured coverage-outcome layer (Phase 2/3 of work item #72). In the current instance data it carries NO instances/edges: the coverage narrowing it is meant to structure currently lives verbatim in gem:ruleDescription on the associated gem:PolicyRule (frequently a gem:ruleType_nonCoverage or gem:ruleType_coverageScope rule). Do not rely on this element at retrieval time in the present data; read the rule text. Treat this note as forward-looking and re-check population status at each checkpoint.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:CoverageRestriction a owl:Class ;
    rdfs:subClassOf gem:CoverageQualifier ;
    gem:prefLabel "Coverage Restriction" ;
    gem:description "A 'Coverage Restriction' is a concrete subclass of gem:CoverageQualifier that narrows the scope of an otherwise-positive coverage outcome along some dimension -- the use case, the count, the duration, the frequency, etc. The dimension along which the restriction narrows is tagged via gem:restrictionType (range gem:RestrictionType), a controlled-vocabulary property. Distinct from gem:CoverageExclusion: restrictions narrow what IS covered (e.g., NCD 240.2 Group I sleep bullet's 'coverage is provided only for use of oxygen during sleep'); exclusions carve out a sub-case that is NOT covered. Attached to a gem:CoverageOutcome via gem:hasCoverageRestriction (a sub-property of gem:hasCoverageQualifier). The clinical concept the restriction applies to is named via gem:restrictionConcept (optional); the human-readable description via gem:restrictionDescription. A typed numeric value for count/duration/frequency restrictions (gem:restrictionValue in the original guide draft) is deferred at S69 Phase 3a pending claim-data substrate understanding; the value lives within gem:restrictionDescription in the interim. Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72; see gem_structured_rule_guide.md §Schema Model." ;
    gem:llmDetailedDefinition """Concrete qualifier that narrows what IS covered along a dimension tagged by gem:restrictionType (useCase / count / duration / frequency). Contrast gem:CoverageExclusion (names something NOT covered). The concept restricted to is optional via gem:restrictionConcept; the text via gem:restrictionDescription. A typed numeric value (restrictionValue) is deferred, so counts/durations currently live inside the description string.""" ;
    gem:llmScopingNote """This element belongs to the deferred structured coverage-outcome layer (Phase 2/3 of work item #72). In the current instance data it carries NO instances/edges: the coverage narrowing it is meant to structure currently lives verbatim in gem:ruleDescription on the associated gem:PolicyRule (frequently a gem:ruleType_nonCoverage or gem:ruleType_coverageScope rule). Do not rely on this element at retrieval time in the present data; read the rule text. Treat this note as forward-looking and re-check population status at each checkpoint.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:CoverageOutcome a owl:Class ;
    gem:prefLabel "Coverage Outcome" ;
    gem:description "A 'Coverage Outcome' is the THEN-clause of a structured Policy Rule -- the coverage decision (covered, not covered, MAC discretion) and any qualifiers (restrictions and exclusions) that apply when the rule's qualifying conditions are met. Outcomes are first-class individuals so that one outcome may be referenced by multiple gem:PolicyRule instances when source prose names that single outcome for multiple qualifying scenarios (e.g., NCD 240.2 Section B's 'In either of these cases, coverage is provided only for use of oxygen during sleep...' framing -- one outcome shared by the two qualifying scenarios that precede it). When source prose presents semantically similar outcomes via distinct source acts, distinct outcome individuals are minted; downstream SME review may later assert owl:sameAs equivalence (the project-wide 'catalog phrasings; don't consolidate' posture). Codified header-only at S69 Phase 3a: the substantive properties (gem:decision and the gem:CoverageDecision controlled vocabulary; structured-decomposition entry points via gem:ruleOutcome) remain pending claim-data substrate understanding per the Deferment Posture in gem_structured_rule_guide.md. Domain of gem:hasCoverageQualifier and its sub-properties. Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72; see gem_structured_rule_guide.md §Schema Model." ;
    gem:llmDetailedDefinition """The THEN-clause of a structured rule: the coverage decision (covered / not covered / MAC-discretion) plus any qualifiers. Designed so one outcome may be shared by multiple gem:PolicyRule scenarios. The decision vocabulary (gem:decision / gem:CoverageDecision) and the rule->outcome link (gem:ruleOutcome) are deferred and not yet in the schema.""" ;
    gem:llmScopingNote """Header-only, deferred layer: ZERO instances in the current data, and not yet wired to gem:PolicyRule. Do not attempt to reach a coverage decision through gem:CoverageOutcome; the decision is currently readable only from the verbatim gem:ruleDescription text and its gem:ruleType tags. Forward-looking; re-check at each checkpoint.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:LCDpolicy a owl:Class ;
    rdfs:subClassOf gem:CMSpolicy ;
    gem:prefLabel "LCD Policy" ;
    gem:description "An 'LCD Policy' is a class of CMS Policy that is a Local Coverage Determination -- a coverage determination issued by a Medicare Administrative Contractor that states what is reasonable and necessary, and therefore covered, within that contractor's jurisdiction." ;
    gem:llmDetailedDefinition """Local Coverage Determination: issued by a single MAC, effective only within that contractor's jurisdiction. Pairs with a Billing and Coding gem:ArticlePolicy that carries its code tables. Narrower authority than gem:NCDpolicy.""" ;
    gem:llmScopingNote """An LCD's coverage statements are jurisdiction-scoped; a claim is governed by the LCD of its processing contractor. LCDs carry no statutory benefit category (that is an NCD/statute-level concept), so do not expect gem:refersToBenefitCategory on an LCD.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:NCDpolicy a owl:Class ;
    rdfs:subClassOf gem:CMSpolicy ;
    gem:prefLabel "NCD Policy" ;
    gem:description "A 'NCD Policy' is a class of CMS Policy that is a National Coverage Determination -- a national-scope coverage determination issued by the Centers for Medicare & Medicaid Services that grants, limits, or excludes Medicare coverage for a specific item or service, and is binding on all Medicare Administrative Contractors." ;
    gem:llmDetailedDefinition """National Coverage Determination: national-scope, binding on all Medicare Administrative Contractors. Contrast gem:LCDpolicy (single-MAC jurisdiction) and gem:ArticlePolicy (the billing/coding companion to an LCD where the actual ICD-10 and HCPCS code tables usually live). An NCD states the coverage determination but frequently does NOT itself enumerate the codes; codes attach to whichever document physically contains them.""" ;
    gem:llmScopingNote """NCD coverage applies nationwide; never treat it as jurisdiction-limited. Where an NCD and an LCD both bear on a service, the NCD is binding and an LCD may only add detail within it (an LCD cannot contradict an NCD).""" ;
    gem:memberOfOntology gem:gemOntology .

gem:AnchoredCodingScope a owl:Class ;
    gem:prefLabel "Anchored Coding Scope" ;
    gem:description "An 'Anchored Coding Scope' is an abstract class representing a structural anchor-scope unit within a CMS Policy. Instances are not asserted directly against this class; they are typed as members of one of its concrete subclasses -- gem:PolicyGroup (for documented Coding-Information-section groups) or gem:PolicyCodingRule (for prose-derived coding-correctness rules). The class serves as the common parent for the anchor-scope pattern: a claim-line code anchor (from the gem:appliesWhenCode predicate family, with sub-properties gem:appliesWhenProcedure, gem:appliesWhenModifier, and gem:appliesWhenCondition) that scopes a set of medical-necessity, coverage, or coding-correctness assertions to claims carrying the anchor's code. The abstract framing supports cross-cutting queries via gem:hasAnchoredCodingScope and gem:appliesWhenCode that transparently include both subclass kinds of scope instance and all anchor code kinds. Introduced 2026-06-15 (Session 60) at A52519's first use of an anchor-scope pattern derived from policy prose rather than from a CMS Article's Coding Information section." ;
    gem:llmDetailedDefinition """Abstract umbrella for the two anchor-scope structural units of a policy: gem:PolicyGroup (documented Group tables) and gem:PolicyCodingRule (prose-derived). Never instantiated directly; every instance is typed as one of the subclasses.""" ;
    gem:llmScopingNote """Zero direct instances by design (abstract). Do not query for `a gem:AnchoredCodingScope`; query the concrete subclasses or the umbrella property.""" ;
    gem:llmTraversalHint """To enumerate every anchor-scope of a policy regardless of kind, query gem:hasAnchoredCodingScope (RDFS-inferred from the sub-properties gem:hasPolicyGroup and gem:hasPolicyCodingRule). The shared anchor is the gem:appliesWhenCode family (gem:appliesWhenProcedure / gem:appliesWhenModifier / gem:appliesWhenCondition).""" ;
    gem:memberOfOntology gem:gemOntology .

gem:PolicyCodingRule a owl:Class ;
    rdfs:subClassOf gem:AnchoredCodingScope ;
    gem:prefLabel "Policy Coding Rule" ;
    gem:description "A 'Policy Coding Rule' is a class of policy-scoped rule that establishes coding-correctness boundaries between HCPCS codes within a CMS policy. A Policy Coding Rule is anchored via the gem:appliesWhenCode predicate family -- typically gem:appliesWhenProcedure for a HCPCS procedure or item code, with gem:appliesWhenModifier and gem:appliesWhenCondition also available -- and specifies other HCPCS codes that must not be used for items in scope of the anchor -- typically via gem:excludesProcedure. The class is the prose-derived counterpart to gem:PolicyGroup: it captures the anchor-scope structural pattern that appears in CMS policy text (typically in Coding Guidelines sections) but is not formally documented as a Group in the Coding Information / ICD-10 tables. Like gem:PolicyGroup, gem:PolicyCodingRule is a subclass of gem:AnchoredCodingScope, the abstract parent for all anchor-scope structural units within a CMS Policy. Linked from a CMS Policy via gem:hasPolicyCodingRule, which is a sub-property of gem:hasAnchoredCodingScope. Introduced 2026-06-15 (Session 60); first instance: gemi:a52519_a7047CodingRule." ;
    gem:llmDetailedDefinition """Prose-derived sibling of gem:PolicyGroup under gem:AnchoredCodingScope. Captures a coding-correctness boundary stated in policy prose (typically Coding Guidelines) rather than a documented Group-N table: an anchor code via the gem:appliesWhenCode family plus codes that must not be used with it, typically via gem:excludesProcedure.""" ;
    gem:llmScopingNote """Very sparse in current data (about one instance). Reached via gem:hasPolicyCodingRule, a sub-property of gem:hasAnchoredCodingScope.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:PolicyGroup a owl:Class ;
    rdfs:subClassOf gem:AnchoredCodingScope ;
    gem:prefLabel "Policy Group" ;
    gem:description "A 'Policy Group' is a class of documented anchor-scope structural unit within a CMS Policy, drawn from the policy's Coding Information section (the structured Group-N tables that pair an HCPCS anchor with an ICD-10 list). A Policy Group bundles together a closed list of ICD-10 diagnosis codes (the conditions for which the policy's medical-necessity rules apply within the Group's scope) anchored to a list of prerequisite codes from the gem:appliesWhenCode anchor family -- typically HCPCS procedure codes (gem:appliesWhenProcedure), sometimes HCPCS modifiers (gem:appliesWhenModifier; first observed at A52514's Group 1, anchored on N3) or ICD-10 diagnoses (gem:appliesWhenCondition; first corpus instance pending). A Policy Group is minted when EITHER the policy lists one or more prerequisite HCPCS procedures that constrain the application of its medical-necessity rules in a Coding Information Group, OR the policy contains more than one parallel rule-set within its Coding Information section. A policy that has neither prerequisite HCPCS in a documented Group nor multiple parallel rule-sets does not require Policy Groups; its rules are asserted directly at policy level. Policy Groups are policy-specific instances (not shared across policies). They carry the closed-list semantic by which any ICD-10 code outside a Group's gem:exclusivelyCoversCondition assertions, when paired in a Medicare claim with one of the Group's prerequisite HCPCS, is implicitly excluded from that Group's coverage scope. This class is the structural realization of the per-anchor scoping pattern observed in multi-Group CMS Articles (e.g., A52466 with 16 anchored Groups within its 'ICD-10-CM Codes that Support Medical Necessity' section). Subclass of gem:AnchoredCodingScope, which is the abstract parent shared with gem:PolicyCodingRule (the prose-derived sibling)." ;
    gem:llmDetailedDefinition """A policy-specific anchor-scope unit drawn from a Coding-Information Group-N table: a closed ICD-10 list anchored to prerequisite code(s), usually an HCPCS procedure via gem:appliesWhenProcedure (sometimes a modifier via gem:appliesWhenModifier). Closed-list semantics: an ICD-10 code outside the Group's gem:exclusivelyCoversCondition set, when paired with the Group's anchor on a claim, is implicitly excluded from that Group's coverage scope. Subclass of gem:AnchoredCodingScope; sibling of gem:PolicyCodingRule.""" ;
    gem:llmScopingNote """Policy Groups are policy-specific (never shared across policies) and minted only when the policy has prerequisite HCPCS anchors OR multiple parallel rule-sets. A policy with neither asserts its rules directly at policy level and has no Groups.""" ;
    gem:llmTraversalHint """CRITICAL for code-level coverage: ICD-10 codes inside a Group are materialized ONLY at the Group level, not at policy level (source-fidelity). To answer 'does policy X cover ICD Y', traverse gem:hasPolicyGroup -> gem:PolicyGroup -> gem:exclusivelyCoversCondition and read the anchor via the gem:appliesWhenCode family; a policy-level gem:coversCondition query alone will MISS Group-nested codes.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:PolicyRule a owl:Class ;
    gem:prefLabel "Policy Rule" ;
    gem:description "A 'Policy Rule' is a first-class rule entity that holds a single rule extracted from a CMS coverage policy -- one self-contained criterion, requirement, or constraint stated in the policy's wording. The class promotes today's gem:ruleDescription string from a datatype-property value on a gem:CMSpolicy or gem:AnchoredCodingScope subject to a first-class entity with its own URI; the rule's verbatim text is carried on the Policy Rule instance via gem:ruleDescription, whose domain was extended at S67 to include gem:PolicyRule. Linked from a CMS Policy via gem:hasPolicyRule. Despite the name proximity, gem:PolicyRule and gem:PolicyCodingRule are orthogonal: a PolicyCodingRule is a structural anchor-scope subclass (under gem:AnchoredCodingScope) for code-to-code coding-correctness constraints, while a PolicyRule is a content unit that holds a rule's verbatim text. The two may co-occur within a policy without subclass relation; a future schema cycle may introduce a relationship between them. The S67 introduction attached PolicyRules from gem:CMSpolicy subjects only; Phase 4 (completed S86, 2026-06-24) extended attachment to gem:AnchoredCodingScope subjects and narrowed gem:ruleDescription's domain to gem:PolicyRule exclusively. Introduced 2026-06-18 (Session 67) as Phase 1 of the multi-phase migration tracked in deferred_proposals[72]; Phase 1 codifies the class and attach-predicate only -- the structured-decomposition schema (gem:LogicalExpression family, gem:NumericPredicate, gem:CoverageOutcome, and supporting controlled vocabularies) remains pending Phase 2 design refinement. See gem_reference.md §2l for the multi-phase rollout context." ;
    gem:llmDetailedDefinition """The first-class carrier of one extracted rule's VERBATIM text (held on gem:ruleDescription). This is the load-bearing, densely-populated coverage-content unit in the graph (~1000+ instances). Attached from a gem:CMSpolicy OR a gem:AnchoredCodingScope (gem:PolicyGroup / gem:PolicyCodingRule) via gem:hasPolicyRule. Orthogonal to gem:PolicyCodingRule despite the similar name: that is a code-scope anchor under gem:AnchoredCodingScope, whereas a PolicyRule is a content unit.""" ;
    gem:llmScopingNote """gem:PolicyRule holds NON-atomic verbatim text. Its structured THEN-clause decomposition (gem:CoverageOutcome + qualifiers, atomic predicates) is defined in the schema but, in the current instance data, unpopulated. Answer coverage questions from the gem:ruleDescription string plus gem:ruleType tags, not from an expected structured outcome graph.""" ;
    gem:llmTraversalHint """To read a policy's coverage rules: gem:hasPolicyRule -> gem:PolicyRule, then gem:ruleDescription for the verbatim criterion and gem:ruleType (1..n) to filter by kind (e.g. gem:ruleType_nonCoverage for exclusions, gem:ruleType_coverageScope for what is covered). gem:ruleDomain narrows by clinical activity but is present only on multi-activity policies. Remember rules also hang off the policy's gem:hasAnchoredCodingScope targets, so gather rules from both the policy and its Groups.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:ProviderCredential a owl:Class ;
    gem:prefLabel "Provider Credential" ;
    gem:description "A 'Provider Credential' is a class of qualification, role, or certification status that a provider, supplier, or facility must hold for a service or test to be acceptable under a CMS Policy. Members of this class are a controlled vocabulary of credential individuals, grown as policies introduce new credential concepts." ;
    gem:llmDetailedDefinition """A required qualification, role, or certification a provider/supplier/facility must hold for a service to be acceptable under a policy. A controlled vocabulary of credential individuals. A credential's own definition lives on the individual's gem:description; policies invoke it via gem:requiresProviderCredential and rules execute by matching the claim's provider, not by re-reading the definition (the former 'credential-definition' rule-type was retired for this reason).""" ;
    gem:llmInverseNote """gem:requiresProviderCredential has no materialized inverse; to find which policies require a given credential, query the credential individual in the object position.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:QualificationGroup a owl:Class ;
    gem:prefLabel "Qualification Group" ;
    gem:description "A 'Qualification Group' is a named patient-qualification tier defined by a CMS Policy -- for example the 'Group I' and 'Group II' tiers of the home-oxygen coverage policies. Members are a flat controlled vocabulary of group individuals discovered in policy text, identified by the group name the policy uses. A Qualification Group records only that a policy names the tier; the clinical criteria that define the tier are captured independently as gem:ClinicalConcept individuals and are NOT bundled onto the group. Different policy types (NCD, LCD, Article) may each refer to a group of the same name while defining or clarifying it differently; the ontology does not reconcile those differences -- a reviewer consults each referring policy. Concept-to-group and group-to-group relationships are deliberately deferred to a later human-reviewed pass." ;
    gem:llmDetailedDefinition """A named patient-qualification TIER a policy defines (e.g. the 'Group I' / 'Group II' tiers of the home-oxygen policies). Records only that a policy names the tier; the clinical criteria defining it are captured separately as gem:ClinicalConcept individuals and are NOT bundled onto the group. Reached via gem:refersToQualificationGroup.""" ;
    gem:llmScopingNote """Same-named groups across different policies are NOT reconciled: 'Group I' in one policy need not mean the same thing as 'Group I' in another, and the ontology asserts no definitional identity. To learn a tier's criteria, consult each referring policy's own rules.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:RestrictionType a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    gem:prefLabel "Restriction Type" ;
    gem:description "A 'Restriction Type' is one of the named values that a gem:CoverageRestriction may carry on its gem:restrictionType predicate, tagging the dimension along which the restriction narrows coverage. Vocabulary is controlled but evolves over time; current values are gem:restrictionType_useCase (narrows the clinical context or use case -- e.g., NCD 240.2's 'oxygen during sleep only'), gem:restrictionType_count (narrows the cardinality -- e.g., NCD 240.2's 'only one type of unit will be covered'), gem:restrictionType_duration (narrows the time span -- e.g., NCD 240.2's '90 days' initial-coverage limit), and gem:restrictionType_frequency (narrows how often the covered item may be claimed). Extended with new values as new policies surface additional restriction shapes. Parallels gem:RuleType (the rule-categorization controlled vocab, codified at sub-cycle (b) of work item #72) and gem:NextPlannedStep (S45) -- same controlled-vocab pattern, distinct domain. Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72." ;
    gem:llmScopingNote """Controlled vocabulary tagging the dimension a gem:CoverageRestriction narrows, applied via gem:restrictionType. Sits in the deferred coverage-qualifier layer (no instances in current data). Per-value definitions on gem:restrictionType. Distinct from gem:RuleType despite the shared 'frequency' member.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:RuleDomain a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    gem:prefLabel "Rule Domain" ;
    gem:description "A 'Rule Domain' is one of the named values that a gem:PolicyRule may carry on its gem:ruleDomain predicate, tagging the clinical activity within a policy that the rule applies to. Vocabulary is controlled but evolves over time; current values are gem:ruleDomain_screening (rule applies to laboratory screening services only -- e.g., NCD 210.10's STI laboratory screening leg), gem:ruleDomain_hibc (rule applies to High Intensity Behavioral Counseling services only -- e.g., NCD 210.10's HIBC leg), and gem:ruleDomain_crossCutting (rule applies to both/either service within a multi-domain policy). Extended with new domain values as new multi-activity policies arrive. Peer class of gem:RuleType (no abstract gem:RuleCategory umbrella -- domain and rule-type are independent classifications, not two flavors of a common concept; consumers query per-axis, not polymorphically). Resolved in S68 (Decision 6); codified 2026-06-18 (Session 69) as Phase 3 sub-cycle (b+c) of work item #72." ;
    gem:llmScopingNote """Controlled vocabulary tagging a rule's clinical activity, applied via gem:ruleDomain. SPARSE by design: present mainly on multi-activity policies (e.g. NCD 210.10, screening + HIBC); a single-activity policy often carries no domain tag, and ABSENCE does not mean the rule is domain-less. Per-value definitions on gem:ruleDomain.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:RuleType a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    gem:prefLabel "Rule Type" ;
    gem:description "A 'Rule Type' is one of the named values that a gem:PolicyRule may carry on its gem:ruleType predicate, tagging the kind of evaluator criterion the rule expresses. Vocabulary is controlled but evolves over time; current values are gem:ruleType_coverageScope (what is covered, at what level), gem:ruleType_eligibility (who/when is eligible), gem:ruleType_frequency (how often / repeat-screening intervals), gem:ruleType_settingDefinition (what setting is required -- positive definition + exclusions), gem:ruleType_credentialedActor (who can order/perform/provide), gem:ruleType_serviceDefinition (defines a service itself), gem:ruleType_serviceStandard (technical standards -- FDA, CLIA, etc.), gem:ruleType_riskFactor (enumerates risk factors), gem:ruleType_riskDetermination (who/how determines risk), gem:ruleType_documentation (documentation requirements), gem:ruleType_nonCoverage (what is NOT covered), gem:ruleType_costSharing (patient cost obligations), gem:ruleType_concurrentServices (what services can be billed on the same date / together), gem:ruleType_statutoryFraming (scope-defining reference to statute), gem:ruleType_studyDesign (content, structure, or analytical plan a study must follow), gem:ruleType_studyQuality (methodological-integrity standards a study must meet), gem:ruleType_outcomeMeasure (how a study measures or characterizes an outcome), gem:ruleType_procedural (program-administrative process distinct from claim-eligibility rules), and gem:ruleType_definition (generic catch-all for definitional rules not covered by the other type categories). Extended with new rule-type values as new policies surface them; retired values are documented in gem_rule_categories.md §Retired rule-type values. Peer class of gem:RuleDomain (no abstract umbrella -- the two classifications are independent). Disambiguation: gem:ruleType_frequency names a kind of rule (whose subject matter is frequency criteria); gem:restrictionType_frequency names a kind of restriction (which narrows frequency) -- see gem_reference.md §2n. Resolved in S68 (Decision 6); codified 2026-06-18 (Session 69) as Phase 3 sub-cycle (b+c) of work item #72." ;
    gem:llmScopingNote """Controlled vocabulary tagging a gem:PolicyRule's criterion kind, applied via the gem:ruleType property (multi-valued, densely populated). Per-value definitions live on gem:ruleType. Independent of gem:RuleDomain and gem:RestrictionType -- three separate classification axes with no shared umbrella; query per-axis. Disambiguate gem:ruleType_frequency (the rule is ABOUT frequency criteria) from gem:restrictionType_frequency (a restriction that NARROWS claim frequency).""" ;
    gem:memberOfOntology gem:gemOntology .

gem:TransmittalPolicy a owl:Class ;
    rdfs:subClassOf gem:CMSpolicy ;
    gem:prefLabel "Transmittal Policy" ;
    gem:description "A 'Transmittal Policy' is a class of CMS Policy representing a CMS Manual transmittal that revises one or more coverage policies (NCDs, LCDs, or MCD Articles). A coverage-manual transmittal is treated as a first-class policy document by default and is extracted through the normal two-turn workflow from its full PDF, rather than recorded only as a reference pointer. The rationale: codes and clinical concepts are linked to the document that actually contains the guidance, so a downstream claim evaluator can read the operative coverage instruction even when that instruction currently lives only in a transmittal and has not yet been folded into the manual section it revises. Whether a transmittal's change has already landed in its affected policy is a finding worth recording but does NOT gate its typing or extraction -- observation is the project's response, not escalation. Claims-processing transmittals (Pub. 100-04) are minted as 'Transmittal Policy' stubs at first citation, exactly like coverage-manual transmittals, with the next planned step set to 'promote' pending a future decision to fully extract. Program Memoranda -- the pre-MAC predecessor of transmittals -- are minted as 'gem:ProgramMemorandumPolicy' stubs, a sibling class." ;
    gem:llmDetailedDefinition """A CMS Manual transmittal: the delivery vehicle that revises one or more coverage documents and carries a Change Request. Extracted as a first-class policy document because its operative instruction may live only in the transmittal, not yet folded into the manual section it revises. Reached from a base policy via gem:revisedByPolicy; reaches its Change Request via gem:transmitsChangeRequest.""" ;
    gem:llmScopingNote """A transmittal may be in effect for one policy it revises and superseded for another, yet it carries a single gem:isInEffect that cannot capture both (a known modeling tension flagged for multi-version work). Also: the same transmittal NUMBER can exist as distinct manual renditions (NCD / Claims-Processing / Benefit-Policy); the graph disambiguates with a manual suffix on the URI (e.g. gemi:tn11263NCD). Verify the manual before assuming two tn<number> references denote the same node.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:NCAdocument a owl:Class ;
    rdfs:subClassOf gem:CMSpolicy ;
    gem:prefLabel "NCA Document" ;
    gem:description "An 'NCA Document' is a class of CMS document that records a National Coverage Analysis -- the deliberative process by which CMS evaluates evidence and arrives at a national coverage decision. An NCA typically precedes the issuance or revision of an NCD; its analytic conclusions are folded into the resulting NCD, so the NCA itself contains no operative coverage rules a claim resolves against. Modeled as a subclass of gem:CMSpolicy for graph-modeling convenience -- so existing referencesPolicy edges from NCDs/LCDs/Articles operate uniformly -- but the naming preserves the semantic distinction: an NCA is a deliberative record, not a coverage rule. NCA stubs in the graph are annotation-only and carry no extracted coverage content." ;
    gem:llmDetailedDefinition """A National Coverage Analysis: the deliberative evidence-review record that precedes an NCD. Subclassed under gem:CMSpolicy only so gem:referencesPolicy edges operate uniformly; semantically it is a deliberative record, not a coverage rule.""" ;
    gem:llmScopingNote """CRITICAL for answering: NCA nodes are annotation-only stubs and carry NO operative coverage rules or code links. Never answer a coverage question ('is X covered?') from an NCAdocument. Its analytic conclusions are folded into the resulting NCD; route the question to that NCD instead.""" ;
    gem:memberOfOntology gem:gemOntology .

# -----------------------------------------------------------------------------
#    Relationship Definitions
# -----------------------------------------------------------------------------
gem:appliesWhenCode a owl:ObjectProperty ;
    gem:prefLabel "Applies When Code" ;
    gem:description "An 'Applies When Code' is the umbrella predicate for the family of anchor-applicability relationships that link an Anchored Coding Scope (a gem:PolicyGroup or a gem:PolicyCodingRule) to a claim-line code whose presence on a Medicare claim triggers the scope's medical-necessity, coverage, or coding-correctness rules. Three sub-properties partition the family by code kind: gem:appliesWhenProcedure (range gem:HCPCSprocedure), gem:appliesWhenModifier (range gem:HCPCSmodifier), and gem:appliesWhenCondition (range gem:ICDdiagnosis). Within a scope, multiple anchor assertions of the same code kind are interpreted disjunctively (a claim need only carry ONE of the listed codes of that kind to match); anchor assertions of different code kinds are interpreted conjunctively (the claim must satisfy at least one assertion in EACH anchor kind present on the scope). The umbrella predicate is available for cross-cutting queries via RDFS inference -- a query against gem:appliesWhenCode transparently returns matches across all three anchor kinds without UNIONing the sub-properties. Range is omitted on the umbrella because the three sub-properties carry kind-specific ranges; the umbrella functions as the sub-property hierarchy parent and as a query-time abstraction. Introduced 2026-06-19 (Session 70) at A52514's first use of a modifier-anchored Coding Information Group." ;
    gem:llmDetailedDefinition """Umbrella for the anchor-applicability family on a gem:AnchoredCodingScope: the claim-line code(s) whose presence TRIGGERS the scope's medical-necessity / coverage / coding-correctness rules. Three kind-partitioned sub-properties: gem:appliesWhenProcedure (range gem:HCPCSprocedure), gem:appliesWhenModifier (range gem:HCPCSmodifier), gem:appliesWhenCondition (range gem:ICDdiagnosis). The umbrella has no range and serves as the query-time abstraction (RDFS inference makes it return matches across all three kinds).""" ;
    gem:llmScopingNote """Never asserted directly -- every anchor triple in the data uses one of the three kind-partitioned sub-properties, so a census of direct assertions on this predicate reads zero by design. Its value is query-time generalization across anchor kinds rather than per-triple assertion, and generalization produces no triples of its own. Zero direct use is the expected state for an umbrella parent, not a retirement signal.""" ;
    gem:llmTraversalHint """Anchor matching logic: WITHIN a single anchor kind, multiple codes are DISJUNCTIVE (the claim need carry only ONE of them); ACROSS the kinds present on the scope, they are CONJUNCTIVE (the claim must satisfy at least one assertion in EACH anchor kind present). To decide whether a scope applies to a claim, check each present anchor kind.""" ;
    rdfs:domain gem:AnchoredCodingScope ;
    gem:memberOfOntology gem:gemOntology .

gem:appliesWhenCondition a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:appliesWhenCode ;
    gem:prefLabel "Applies When Condition" ;
    gem:description "An 'Applies When Condition' is the diagnosis-kind sub-property of the gem:appliesWhenCode anchor family. It links an Anchored Coding Scope to an ICD-10-CM diagnosis code whose presence on a Medicare claim triggers the scope's rules. The expected source pattern is the 'mutually exclusive conditions' language CMS uses to express that one diagnosis on a claim triggers a constraint on which other diagnoses may also appear -- a per-anchor scoping pattern analogous to the procedure-anchor pattern observed in CMS Article Coding Information Group Paragraphs, but with an ICD-10 diagnosis carrying the anchor role. SME knowledge confirms this pattern exists in the corpus; first corpus instance pending. See gem:appliesWhenCode for the family-level semantic. Introduced 2026-06-19 (Session 70) in anticipation of the mutually-exclusive-conditions pattern." ;
    gem:llmScopingNote """The diagnosis-kind anchor (range gem:ICDdiagnosis) for the 'mutually exclusive conditions' pattern. DEFINED but with no corpus instances yet (zero triples in current data); forward-looking.""" ;
    rdfs:domain gem:AnchoredCodingScope ;
    rdfs:range gem:ICDdiagnosis ;
    gem:memberOfOntology gem:gemOntology .

gem:appliesWhenModifier a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:appliesWhenCode ;
    gem:prefLabel "Applies When Modifier" ;
    gem:description "An 'Applies When Modifier' is the modifier-kind sub-property of the gem:appliesWhenCode anchor family. It links an Anchored Coding Scope to a HCPCS Level II modifier whose presence on a Medicare claim line triggers the scope's rules. Mirrors the per-modifier paragraph language found in CMS Article Coding Information Group Paragraphs -- e.g., A52514's 'For all claims submitted with the N3 modifier' Group 1 Paragraph that anchors its ICD exclusion list. Unlike the procedure anchor (gem:appliesWhenProcedure), the modifier anchor does not have an analogous policy-level materialization rule: modifiers are billing instructions on claim lines, not separately covered or excluded items, and a policy's references to modifiers are captured at policy level via the polarity-neutral gem:refersToHCPCSmodifier rather than via covers/excludes-style polarity predicates. See gem:appliesWhenCode for the family-level semantic. Introduced 2026-06-19 (Session 70) at A52514's first modifier-anchored Coding Information Group (Group 1, anchored on N3)." ;
    gem:llmScopingNote """The modifier-kind anchor (range gem:HCPCSmodifier); rare in current data. Unlike gem:appliesWhenProcedure it has NO policy-level covers-materialization -- modifiers are captured at policy level only via the polarity-neutral gem:refersToHCPCSmodifier.""" ;
    rdfs:domain gem:AnchoredCodingScope ;
    rdfs:range gem:HCPCSmodifier ;
    gem:memberOfOntology gem:gemOntology .

gem:appliesWhenProcedure a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:appliesWhenCode ;
    gem:prefLabel "Applies When Procedure" ;
    gem:description "An 'Applies When Procedure' is the procedure-kind sub-property of the gem:appliesWhenCode anchor family. It links an Anchored Coding Scope (a gem:PolicyGroup or a gem:PolicyCodingRule) to a HCPCS procedure or item code whose presence on a Medicare claim triggers the scope's medical-necessity, coverage, or coding-correctness rules. Mirrors the 'For HCPCS codes X, Y, Z:' anchor language found in CMS Article Coding Information Group Paragraphs (for gem:PolicyGroup) or the prose-derived anchor identification (for gem:PolicyCodingRule). The semantic is conditional-applicability, not coverage polarity: a HCPCS procedure linked via gem:appliesWhenProcedure to a scope is also separately asserted at policy level via gem:coversProcedure on the enclosing CMS Policy where appropriate (the inferential rule that prerequisite procedures of a documented Group are themselves within the policy's coverage scope, materialized at extraction time as explicit policy-level triples). This policy-level materialization rule is procedure-anchor-specific; the sibling sub-properties gem:appliesWhenModifier and gem:appliesWhenCondition do not have analogous materialization (modifiers and diagnosis-anchors are captured via different policy-level predicates -- gem:refersToHCPCSmodifier and gem:coversCondition/gem:excludesCondition, respectively). See gem:appliesWhenCode for the family-level semantic. Domain generalized from gem:PolicyGroup to gem:AnchoredCodingScope at S60 (2026-06-15) to admit the new sibling class gem:PolicyCodingRule; declared sub-property of gem:appliesWhenCode at S70 (2026-06-19) on introduction of the anchor predicate family." ;
    gem:llmDetailedDefinition """The procedure-kind anchor (range gem:HCPCSprocedure) and the populated anchor form. Sub-property of gem:appliesWhenCode. SPECIAL rule: a documented Group's prerequisite procedure is ALSO materialized at policy level via gem:coversProcedure (prerequisite procedures of a Group are within the policy's coverage scope). This policy-level covers-materialization is procedure-anchor-specific.""" ;
    gem:llmScopingNote """Semantic is conditional-applicability, NOT coverage polarity; but note the covers-materialization above, so an anchored procedure typically also appears as a covered procedure.""" ;
    rdfs:domain gem:AnchoredCodingScope ;
    rdfs:range gem:HCPCSprocedure ;
    gem:memberOfOntology gem:gemOntology .

gem:coversCondition a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:refersToICDdiagnosis ;
    gem:prefLabel "Covers Condition" ;
    gem:description "A 'Covers Condition' is a relationship that links a CMS Policy to an ICD-10-CM diagnosis code that the policy references as supporting coverage or medical necessity. It is a sub-property of gem:refersToICDdiagnosis, so a query on the polarity-neutral property still returns these covered references.    When claims are matched to policies, any claim that has an ICD-10 diagnosis that is covered by a policy, that policy supports approval of that claim unless other conditions exclude the claim. The sub-property gem:exclusivelyCoversCondition further restricts these references with a closed-list semantic: the union of its objects for a given subject is the complete coverage scope." ;
    gem:llmDetailedDefinition """Policy -> ICD-10 diagnosis that the policy references as SUPPORTING coverage or medical necessity. Sub-property of gem:refersToICDdiagnosis; its own sub-property gem:exclusivelyCoversCondition adds closed-list (complete-scope) semantics.""" ;
    gem:llmScopingNote """CRITICAL query note: covered conditions are, in current data, expressed almost entirely via the closed-list sub-property gem:exclusivelyCoversCondition; bare gem:coversCondition carries essentially no DIRECT triples. Query gem:exclusivelyCoversCondition (or gem:coversCondition WITH subproperty inference) -- a bare direct gem:coversCondition query returns little or nothing.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:ICDdiagnosis ;
    gem:memberOfOntology gem:gemOntology .

gem:coversInHealthcareSetting a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:refersToHealthcareSetting ;
    gem:prefLabel "Covers In Healthcare Setting" ;
    gem:description "A 'Covers In Healthcare Setting' is a relationship that links a gem:PolicyRule -- or, where the statement is not rule-scoped, a CMS Policy or an Anchored Coding Scope within one -- to a gem:HealthcareSetting in which the policy's item or service is covered -- or in which the policy names the setting without denying coverage there. It is the Tier-2 (covered-or-silent) member of the setting-polarity family and a sub-property of gem:refersToHealthcareSetting, so a query on the polarity-neutral parent still returns these references. Introduced 2026-07-24 (Session 197) to give settings the covered / non-covered distinction that ICD-10 and HCPCS references have carried since Session 19; before it, a setting's exclusion polarity existed only inside the referencing rule's verbatim text and could not be queried." ;
    gem:llmDetailedDefinition """gem:PolicyRule (or a policy / gem:AnchoredCodingScope) -> gem:HealthcareSetting in which the service IS covered, or in which the setting is named with no denial. Sub-property of gem:refersToHealthcareSetting. Polarity assignment follows the same binary rule as codes: anything that is not a stated denial for that setting lands here. Contrast gem:excludesHealthcareSetting (denial stated) and the closed-list gem:exclusivelyCoversInHealthcareSetting.""" ;
    gem:llmScopingNote """Setting polarity answers where the item or service may be furnished, not where the beneficiary is. A negative sentence that merely mentions a setting does not make it an excluded setting: NCD 280.8 denies home use of the air-fluidized bed under a list of circumstances, yet the home is the covered locus there and the exclusion is conditional, so the home stays on this predicate.""" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( gem:CMSpolicy gem:AnchoredCodingScope gem:PolicyRule ) ] ;
    rdfs:range gem:HealthcareSetting ;
    gem:memberOfOntology gem:gemOntology .

gem:coversProcedure a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:refersToHCPCSprocedure ;
    gem:prefLabel "Covers Procedure" ;
    gem:description "A 'Covers Procedure' is a relationship that links a CMS Policy to a HCPCS procedure or item code the policy references as supporting coverage or medical necessity. It is a sub-property of gem:refersToHCPCSprocedure, so a query on the polarity-neutral property still returns these covered references. The sub-property gem:exclusivelyCoversProcedure further restricts these references with a closed-list semantic: the union of its objects for a given subject is the complete coverage scope." ;
    gem:llmDetailedDefinition """Policy -> HCPCS procedure/item that SUPPORTS coverage or medical necessity. This is the primary, directly-populated procedure-coverage predicate (contrast the condition side, which is closed-list). Sub-property of gem:refersToHCPCSprocedure; the closed-list variant gem:exclusivelyCoversProcedure exists but is unused in current data. Ranges over CPT too (gem:CPTprocedure is a subclass of gem:HCPCSprocedure).""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:HCPCSprocedure ;
    gem:memberOfOntology gem:gemOntology .

gem:excludedConcept a owl:ObjectProperty ;
    gem:prefLabel "Excluded Concept" ;
    gem:description "An 'Excluded Concept' is a relationship that links a gem:CoverageExclusion to the gem:ClinicalConcept that is being explicitly excluded from coverage within an otherwise-positive coverage outcome. The link names the clinical, physiological, diagnostic, or therapeutic concept that the source policy carves out as not covered when the rule's qualifying conditions are met -- e.g., NCD 240.2 Group I sleep bullet's 'Portable oxygen, therefore, would not be covered in this situation' would link the shared sleep outcome's gem:CoverageExclusion to gemi:conceptPortableOxygen. Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72." ;
    gem:llmScopingNote """Links a gem:CoverageExclusion to the gem:ClinicalConcept carved out of an otherwise-positive outcome. Part of the deferred coverage-qualifier layer -- zero uses in current data; the exclusion is presently carried in the verbatim gem:ruleDescription. Distinct from gem:excludesCondition, which excludes a coded ICD-10 diagnosis at policy/scope level and IS populated.""" ;
    rdfs:domain gem:CoverageExclusion ;
    rdfs:range gem:ClinicalConcept ;
    gem:memberOfOntology gem:gemOntology .

gem:excludedHealthcareSetting a owl:ObjectProperty ;
    gem:prefLabel "Excluded Healthcare Setting" ;
    gem:description "An 'Excluded Healthcare Setting' is a relationship that links a gem:CoverageExclusion to a gem:HealthcareSetting (a place of care) that is explicitly excluded from coverage within an otherwise-positive coverage outcome -- e.g., NCD 160.7.1's carve-out excluding electrical nerve stimulation furnished in a physician's office or outpatient clinic under Section 1862(a)(1). It is the setting-scoped parallel of gem:excludedConcept. Defined 2026-07-04 (Session 117) as work item [70]; instantiation awaits gem:CoverageExclusion decomposition of the affected rules, so the property ships defined with zero uses (mirroring gem:excludedConcept's current state)." ;
    gem:llmScopingNote """The setting-scoped parallel of gem:excludedConcept (gem:CoverageExclusion -> gem:HealthcareSetting). Part of the deferred coverage-qualifier layer -- zero uses in current data (awaits gem:CoverageExclusion decomposition of the affected rules). NOT the live predicate for an excluded setting: since Session 197 a policy or anchor-scope states one with gem:excludesHealthcareSetting. This one stays reserved to the deferred layer; do not confuse the two.""" ;
    rdfs:domain gem:CoverageExclusion ;
    rdfs:range gem:HealthcareSetting ;
    gem:memberOfOntology gem:gemOntology .

gem:excludesCondition a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:refersToICDdiagnosis ;
    gem:prefLabel "Excludes Condition" ;
    gem:description "An 'Excludes Condition' is a relationship that links a CMS Policy or an Anchored Coding Scope (gem:PolicyGroup or gem:PolicyCodingRule) to an ICD-10-CM diagnosis code that the policy or scope references as not supporting medical necessity -- denied or excluded. It is a sub-property of gem:refersToICDdiagnosis, so a query on the polarity-neutral property still returns these non-covered references. When claims are matched to policies, any claim that has an ICD-10 diagnosis that is excluded by a policy supports denial of that claim. When the subject is an Anchored Coding Scope, the exclusion is scoped to claims that satisfy the scope's prerequisite anchor conditions (from the gem:appliesWhenCode family -- gem:appliesWhenProcedure, gem:appliesWhenModifier, gem:appliesWhenCondition); a Medicare claim that satisfies the scope's anchor conditions and also carries the excluded ICD constitutes a reason for denial within the scope. Domain extended from gem:CMSpolicy to union(CMSpolicy, AnchoredCodingScope) at S60 (2026-06-15) to enable the per-anchor exclusion pattern observed at A52519's Group 1A ('For A7002, A7047 and E0600 - G47.33' in the ICD-10 'DO NOT Support Medical Necessity' section)." ;
    gem:llmDetailedDefinition """Policy OR gem:AnchoredCodingScope -> ICD-10 diagnosis referenced as NOT supporting medical necessity (denied/excluded). Sub-property of gem:refersToICDdiagnosis. When the subject is an anchor-scope, the exclusion is scoped to claims that satisfy the scope's gem:appliesWhen* anchor.""" ;
    gem:llmScopingNote """This is the EXPLICIT do-not-support-necessity list only. It is distinct from the IMPLICIT exclusion of gem:exclusivelyCoversCondition (anything outside the closed list), which is NOT materialized as gem:excludesCondition triples -- recover that via SPARQL FILTER NOT EXISTS over the closed list.""" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( gem:CMSpolicy gem:AnchoredCodingScope ) ] ;
    rdfs:range gem:ICDdiagnosis ;
    gem:memberOfOntology gem:gemOntology .

gem:excludesHealthcareSetting a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:refersToHealthcareSetting ;
    gem:prefLabel "Excludes Healthcare Setting" ;
    gem:description "An 'Excludes Healthcare Setting' is a relationship that links a gem:PolicyRule -- or, where the statement is not rule-scoped, a CMS Policy or an Anchored Coding Scope within one -- to a gem:HealthcareSetting in which the policy's item or service is stated to be non-covered, denied, or excluded -- for example NCD 160.7.1's carve-out excluding electrical nerve stimulation furnished by a physician in the office, by a physical therapist, or by an outpatient clinic under Section 1862(a)(1) of the Act. It is the Tier-1 (denial stated) member of the setting-polarity family and a sub-property of gem:refersToHealthcareSetting, so a query on the polarity-neutral parent still returns these references. Distinct from gem:excludedHealthcareSetting, which expresses the same idea inside the deferred structured coverage-outcome layer and has domain gem:CoverageExclusion. Introduced 2026-07-24 (Session 197)." ;
    gem:llmDetailedDefinition """gem:PolicyRule (or a policy / gem:AnchoredCodingScope) -> gem:HealthcareSetting in which the item or service is denied or excluded. Sub-property of gem:refersToHealthcareSetting; Tier-1 polarity, assigned only where the source states a denial for that setting. NOT the same predicate as gem:excludedHealthcareSetting (domain gem:CoverageExclusion, deferred layer, zero uses).""" ;
    gem:llmScopingNote """Two predicates in this ontology name an excluded setting and only this one is live. gem:excludedHealthcareSetting hangs off gem:CoverageExclusion in the deferred structured coverage-outcome layer of deferred_proposals[72], whose attachment predicates have domain gem:CoverageOutcome and zero individuals, so nothing can reach a policy through it today. Assert a policy-level or scope-level setting exclusion here.""" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( gem:CMSpolicy gem:AnchoredCodingScope gem:PolicyRule ) ] ;
    rdfs:range gem:HealthcareSetting ;
    gem:memberOfOntology gem:gemOntology .

gem:excludesProcedure a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:refersToHCPCSprocedure ;
    gem:prefLabel "Excludes Procedure" ;
    gem:description "An 'Excludes Procedure' is a relationship that links a CMS Policy to a HCPCS procedure or item code the policy references as not supporting coverage or medical necessity. It is a sub-property of gem:refersToHCPCSprocedure, so a query on the polarity-neutral property still returns these covered references.  When claims are matched to policies, any claim that has a HCPCS procedure that is excluded by a policy, that policy supports denial of that claim. Domain extended from gem:CMSpolicy to union(CMSpolicy, AnchoredCodingScope) at S60 (2026-06-15) to enable per-anchor HCPCS exclusion patterns -- e.g., A52519's gem:PolicyCodingRule for A7047 (excluding alternative coding pathways E0485 and E0486 for the A7047 oral interface)." ;
    gem:llmDetailedDefinition """Policy OR gem:AnchoredCodingScope -> HCPCS procedure referenced as NOT supporting coverage (denied). Sub-property of gem:refersToHCPCSprocedure. When the subject is an anchor-scope (e.g. a gem:PolicyCodingRule), the exclusion is scoped to the scope's anchor -- typically naming alternative coding pathways that must not be used for the anchored item.""" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( gem:CMSpolicy gem:AnchoredCodingScope ) ] ;
    rdfs:range gem:HCPCSprocedure ;
    gem:memberOfOntology gem:gemOntology .

gem:exclusivelyCoversCondition a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:coversCondition ;
    gem:prefLabel "Exclusively Covers Condition" ;
    gem:description "An 'Exclusively Covers Condition' is a relationship that links a CMS Policy or an Anchored Coding Scope (gem:PolicyGroup or gem:PolicyCodingRule) to an ICD-10-CM diagnosis code, with the additional semantic that the union of objects of this property for a given subject (a policy, or a scope) constitutes the COMPLETE set of conditions covered by that subject; any ICD-10 code not in the union is implicitly excluded from coverage by the subject. The property is a sub-property of gem:coversCondition, so a query on the parent property still returns these closed-list references. When the subject is a CMS Policy with no Anchored Coding Scopes, the closed list operates policy-wide. When the subject is an Anchored Coding Scope, the closed list operates within the scope's anchor: a Medicare claim that carries one of the scope's prerequisite HCPCS codes is evaluated against this scope's exclusivelyCoversCondition list, and any ICD-10 code in the claim that is not in the list constitutes a reason for denial within that scope. The implicit-exclusion semantic is not materialized as gem:excludesCondition triples; it is recoverable at query time via SPARQL FILTER NOT EXISTS over the closed list. This property was introduced to encode the closed-list scope pattern made explicit in the 'ICD-10-CM Codes that DO NOT Support Medical Necessity / All ICD-10 codes that are not specified in the previous section' language found in some CMS Articles. Domain union generalized from PolicyGroup to AnchoredCodingScope at S60 (2026-06-15) alongside the new gem:PolicyCodingRule sibling class." ;
    gem:llmCardinalityNote """Many objects per subject (the closed list). Position-specific refinements exist via the sub-properties gem:exclusivelyCoversPrimaryCondition and gem:exclusivelyCoversSecondaryCondition.""" ;
    gem:llmDetailedDefinition """THE dominant covered-ICD predicate in the graph. Closed-list semantic: for a given subject (a policy, or an anchor-scope), the union of its objects is the COMPLETE set of covered conditions; any ICD-10 code not in that union is IMPLICITLY excluded (this implicit exclusion is NOT materialized as triples). Sub-property of gem:coversCondition. Subject-scope form: within a gem:AnchoredCodingScope, the closed list operates inside the scope's gem:appliesWhen* anchor.""" ;
    gem:llmTraversalHint """To answer 'does policy/scope X cover ICD Y': Y is covered iff Y is in the subject's exclusivelyCoversCondition union. If X has anchor-scopes (gem:hasAnchoredCodingScope), evaluate within the scope whose gem:appliesWhen* anchor the claim satisfies. To list implicitly-excluded codes, use FILTER NOT EXISTS against the closed list -- they are not stored.""" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( gem:CMSpolicy gem:AnchoredCodingScope ) ] ;
    rdfs:range gem:ICDdiagnosis ;
    gem:memberOfOntology gem:gemOntology .

gem:exclusivelyCoversPrimaryCondition a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:exclusivelyCoversCondition ;
    gem:prefLabel "Exclusively Covers Primary Condition" ;
    gem:description "An 'Exclusively Covers Primary Condition' is a position-specific specialization of gem:exclusivelyCoversCondition that constrains the closed-list semantic to the primary diagnosis position on a Medicare claim (the principal-diagnosis slot on institutional claims, and the first diagnosis pointer for a line item on professional CMS-1500 claims). The union of objects of this property for a given subject constitutes the COMPLETE set of ICD-10 codes that satisfy the primary-position requirement; any other ICD-10 code in that position constitutes a reason for denial within the subject's scope. Because the property is a sub-property of gem:exclusivelyCoversCondition, queries against the parent predicate transparently include these primary-position triples. The cardinality of acceptable primary diagnoses is determined by the count of triples: a single triple enforces a sole acceptable code; multiple triples enforce a pick-one-from-list semantic. When the subject is an Anchored Coding Scope (gem:PolicyGroup or gem:PolicyCodingRule), the primary-position requirement is scoped to the scope's prerequisite anchor conditions (from the gem:appliesWhenCode family -- gem:appliesWhenProcedure, gem:appliesWhenModifier, gem:appliesWhenCondition). Introduced when a Medicare policy first explicitly imposed a primary-diagnosis-position requirement on a procedure-conditional scope (A58075: HNS for OSA, requiring primary G47.33 for new-implantation codes). Domain union generalized from PolicyGroup to AnchoredCodingScope at S60 (2026-06-15)." ;
    gem:llmDetailedDefinition """Position-specific specialization of gem:exclusivelyCoversCondition constraining the closed list to the PRIMARY diagnosis position (principal-diagnosis slot on institutional claims; first diagnosis pointer on professional CMS-1500). Sub-property of gem:exclusivelyCoversCondition, so parent queries include it. Triple count encodes cardinality: one triple = sole acceptable primary code; several = pick-one-from-list.""" ;
    gem:llmScopingNote """Rare in current data. When the subject is an anchor-scope, the primary-position requirement is scoped to the scope's gem:appliesWhen* anchor.""" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gem:CMSpolicy gem:AnchoredCodingScope ) ] ;
    rdfs:range gem:ICDdiagnosis ;
    gem:memberOfOntology gem:gemOntology .

gem:exclusivelyCoversSecondaryCondition a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:exclusivelyCoversCondition ;
    gem:prefLabel "Exclusively Covers Secondary Condition" ;
    gem:description "An 'Exclusively Covers Secondary Condition' is a position-specific specialization of gem:exclusivelyCoversCondition that constrains the closed-list semantic to a secondary diagnosis position on a Medicare claim (any non-principal diagnosis slot on institutional claims; any non-first diagnosis pointer for a line item on professional CMS-1500 claims). The union of objects of this property for a given subject constitutes the COMPLETE set of ICD-10 codes that satisfy the secondary-position requirement; a claim that fails to carry at least one of these codes in some secondary position constitutes a reason for denial within the subject's scope. Because the property is a sub-property of gem:exclusivelyCoversCondition, queries against the parent predicate transparently include these secondary-position triples. The cardinality of acceptable secondary diagnoses is determined by the count of triples (single value or pick-one-from-list). When the subject is an Anchored Coding Scope (gem:PolicyGroup or gem:PolicyCodingRule), the secondary-position requirement is scoped to the scope's prerequisite HCPCS. Introduced alongside gem:exclusivelyCoversPrimaryCondition when a Medicare policy first explicitly imposed a dual-position diagnosis requirement (A58075: HNS for OSA, requiring secondary diagnosis from Z68.1 / Z68.20-Z68.34 for new-implantation codes). Domain union generalized from PolicyGroup to AnchoredCodingScope at S60 (2026-06-15)." ;
    gem:llmDetailedDefinition """Position-specific specialization of gem:exclusivelyCoversCondition for a SECONDARY (non-principal) diagnosis position: the claim must carry at least one listed code in some secondary position. Sub-property of gem:exclusivelyCoversCondition (parent queries include it); triple count encodes cardinality.""" ;
    gem:llmScopingNote """Rare in current data. Scoped to the anchor when the subject is an anchor-scope.""" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gem:CMSpolicy gem:AnchoredCodingScope ) ] ;
    rdfs:range gem:ICDdiagnosis ;
    gem:memberOfOntology gem:gemOntology .

gem:exclusivelyCoversInHealthcareSetting a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:coversInHealthcareSetting ;
    gem:prefLabel "Exclusively Covers In Healthcare Setting" ;
    gem:description "An 'Exclusively Covers In Healthcare Setting' is a relationship that links a gem:PolicyRule -- or, where the statement is not rule-scoped, a CMS Policy or an Anchored Coding Scope within one -- to a gem:HealthcareSetting belonging to a closed list of settings in which the item or service may be furnished: the source declares, or its structure implies, that the listed settings are the entire permitted set and that any other setting is excluded. It is the setting-side counterpart of gem:exclusivelyCoversCondition and gem:exclusivelyCoversProcedure, and a sub-property of gem:coversInHealthcareSetting, so it carries Tier-2 polarity. Introduced 2026-07-24 (Session 197)." ;
    gem:llmDetailedDefinition """Closed-list form of gem:coversInHealthcareSetting: the listed settings are the ONLY permitted ones and the complement is excluded. The complement is NOT materialized as gem:excludesHealthcareSetting triples -- recover it with SPARQL FILTER NOT EXISTS over the closed list, exactly as with gem:exclusivelyCoversCondition.""" ;
    gem:llmScopingNote """Use only where the source closes the set. The canonical shape is a place-of-service enumeration governed by only when: TN 2476 instructs that contractors shall pay HCPCS G0445 only when the place of service is Physician Office, Outpatient Hospital, Independent Clinic, or State or local public health clinic. A policy that names settings without closing the set takes plain gem:coversInHealthcareSetting.""" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( gem:CMSpolicy gem:AnchoredCodingScope gem:PolicyRule ) ] ;
    rdfs:range gem:HealthcareSetting ;
    gem:memberOfOntology gem:gemOntology .

gem:exclusivelyCoversProcedure a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:coversProcedure ;
    gem:prefLabel "Exclusively Covers Procedure" ;
    gem:description "An 'Exclusively Covers Procedure' is a relationship that links a CMS Policy or an Anchored Coding Scope (gem:PolicyGroup or gem:PolicyCodingRule) to a HCPCS procedure or item code, with the additional semantic that the union of objects of this property for a given subject constitutes the COMPLETE set of procedures covered by that subject; any HCPCS code not in the union is implicitly excluded from coverage by the subject. The property is a sub-property of gem:coversProcedure, so a query on the parent property still returns these closed-list references. It is the HCPCS-side counterpart to gem:exclusivelyCoversCondition. The property is declared with Anchored Coding Scope as a permissible domain (alongside CMS Policy) to leave room for a future pattern in which a scope's anchor is an ICD-10 list and its closed-list scope is over HCPCS codes -- the inverse of the present CMS Article pattern. No current instances of the inverted pattern are extracted; the dual-domain declaration is a forward-compatible design choice. The most common usage is policy-level (a CMS Policy that lists a closed set of covered HCPCS). Domain union generalized from PolicyGroup to AnchoredCodingScope at S60 (2026-06-15)." ;
    gem:llmScopingNote """The HCPCS closed-list counterpart of gem:exclusivelyCoversCondition. Declared with the dual policy/anchor-scope domain for forward-compatibility, but UNUSED in current data (covered procedures are asserted directly via gem:coversProcedure). Do not expect closed-list procedure semantics in the present data.""" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( gem:CMSpolicy gem:AnchoredCodingScope ) ] ;
    rdfs:range gem:HCPCSprocedure ;
    gem:memberOfOntology gem:gemOntology .

gem:hasAnchoredCodingScope a owl:ObjectProperty ;
    gem:prefLabel "Has Anchored Coding Scope" ;
    gem:description "A 'Has Anchored Coding Scope' is a relationship that links a CMS Policy to any anchor-scope structural unit within the policy -- either a documented gem:PolicyGroup or a prose-derived gem:PolicyCodingRule. The property is the umbrella for both forms of scope attachment; the specific sub-properties gem:hasPolicyGroup and gem:hasPolicyCodingRule are used at assertion time, with the parent predicate available for cross-cutting queries via RDFS inference (every sub-property assertion is inferentially a parent-property assertion too). A policy that wishes to enumerate all of its anchored coding scopes regardless of origin can query this predicate without UNIONing over both sub-properties. Introduced 2026-06-15 (Session 60)." ;
    gem:llmInverseNote """No materialized inverse.""" ;
    gem:llmScopingNote """Never asserted directly -- policies attach a scope through gem:hasPolicyGroup or gem:hasPolicyCodingRule, so a census of direct assertions on this predicate reads zero by design while the sub-properties carry the load. Zero direct use is the expected state for an umbrella parent, not a retirement signal; its value is query-time generalization, which produces no triples of its own.""" ;
    gem:llmTraversalHint """Umbrella parent of gem:hasPolicyGroup and gem:hasPolicyCodingRule; query it to enumerate all anchor-scopes of a policy via RDFS inference (each sub-property assertion entails it), without UNIONing the two sub-properties.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:AnchoredCodingScope ;
    gem:memberOfOntology gem:gemOntology .

gem:hasCoverageQualifier a owl:ObjectProperty ;
    gem:prefLabel "Has Coverage Qualifier" ;
    gem:description "A 'Has Coverage Qualifier' is a relationship that links a gem:CoverageOutcome to any qualifier within the outcome -- either a gem:CoverageRestriction (which narrows what is covered) or a gem:CoverageExclusion (which carves out a sub-case that is not covered). The property is the umbrella for both forms of qualifier attachment; the specific sub-properties gem:hasCoverageRestriction and gem:hasCoverageExclusion are used at assertion time, with the parent predicate available for cross-cutting queries via RDFS inference (every sub-property assertion is inferentially a parent-property assertion too). A coverage outcome that wishes to enumerate all of its qualifiers regardless of kind can query this predicate without UNIONing over both sub-properties. Follows the S60 umbrella-predicate pattern established for gem:hasAnchoredCodingScope over gem:hasPolicyGroup + gem:hasPolicyCodingRule. Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72." ;
    gem:llmScopingNote """This element belongs to the deferred structured coverage-outcome layer (Phase 2/3 of work item #72). In the current instance data it carries NO instances/edges: the coverage narrowing it is meant to structure currently lives verbatim in gem:ruleDescription on the associated gem:PolicyRule (frequently a gem:ruleType_nonCoverage or gem:ruleType_coverageScope rule). Do not rely on this element at retrieval time in the present data; read the rule text. Treat this note as forward-looking and re-check population status at each checkpoint.""" ;
    gem:llmTraversalHint """Umbrella parent of gem:hasCoverageRestriction and gem:hasCoverageExclusion; when populated, query it to enumerate all qualifiers of a gem:CoverageOutcome via RDFS inference.""" ;
    rdfs:domain gem:CoverageOutcome ;
    rdfs:range gem:CoverageQualifier ;
    gem:memberOfOntology gem:gemOntology .

gem:hasCoverageExclusion a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:hasCoverageQualifier ;
    gem:prefLabel "Has Coverage Exclusion" ;
    gem:description "A 'Has Coverage Exclusion' is a relationship that links a gem:CoverageOutcome to a gem:CoverageExclusion that explicitly carves out a sub-case from the otherwise-positive outcome. Sub-property of gem:hasCoverageQualifier; queries against the parent predicate transparently include these triples via RDFS inference. A coverage outcome may have zero or more coverage exclusions; cardinality is open. Naming follows the S60 has* convention for umbrella-pattern sub-properties (gem:hasPolicyGroup, gem:hasPolicyCodingRule). Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72." ;
    gem:llmScopingNote """This element belongs to the deferred structured coverage-outcome layer (Phase 2/3 of work item #72). In the current instance data it carries NO instances/edges: the coverage narrowing it is meant to structure currently lives verbatim in gem:ruleDescription on the associated gem:PolicyRule (frequently a gem:ruleType_nonCoverage or gem:ruleType_coverageScope rule). Do not rely on this element at retrieval time in the present data; read the rule text. Treat this note as forward-looking and re-check population status at each checkpoint.""" ;
    rdfs:domain gem:CoverageOutcome ;
    rdfs:range gem:CoverageExclusion ;
    gem:memberOfOntology gem:gemOntology .

gem:hasCoverageRestriction a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:hasCoverageQualifier ;
    gem:prefLabel "Has Coverage Restriction" ;
    gem:description "A 'Has Coverage Restriction' is a relationship that links a gem:CoverageOutcome to a gem:CoverageRestriction that narrows the scope of the otherwise-positive outcome along some dimension -- the use case, the count, the duration, the frequency, etc. (e.g., NCD 240.2's 'coverage is provided only for use of oxygen during sleep' yields a use-case restriction). Sub-property of gem:hasCoverageQualifier; queries against the parent predicate transparently include these triples via RDFS inference. A coverage outcome may have zero or more coverage restrictions; cardinality is open. Naming follows the S60 has* convention for umbrella-pattern sub-properties (gem:hasPolicyGroup, gem:hasPolicyCodingRule). Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72." ;
    gem:llmScopingNote """This element belongs to the deferred structured coverage-outcome layer (Phase 2/3 of work item #72). In the current instance data it carries NO instances/edges: the coverage narrowing it is meant to structure currently lives verbatim in gem:ruleDescription on the associated gem:PolicyRule (frequently a gem:ruleType_nonCoverage or gem:ruleType_coverageScope rule). Do not rely on this element at retrieval time in the present data; read the rule text. Treat this note as forward-looking and re-check population status at each checkpoint.""" ;
    rdfs:domain gem:CoverageOutcome ;
    rdfs:range gem:CoverageRestriction ;
    gem:memberOfOntology gem:gemOntology .

gem:hasPolicyCodingRule a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:hasAnchoredCodingScope ;
    gem:prefLabel "Has Policy Coding Rule" ;
    gem:description "A 'Has Policy Coding Rule' is a relationship that links a CMS Policy to a gem:PolicyCodingRule instance within the policy -- an anchor-scope coding-correctness rule derived from the policy's prose (typically Coding Guidelines section rather than the Coding Information section's structured Group-N tables). Sub-property of gem:hasAnchoredCodingScope; queries against the parent predicate transparently include these triples. A policy may have zero or more Policy Coding Rules; cardinality is open. Introduced 2026-06-15 (Session 60); first instance: gemi:a52519_a7047CodingRule." ;
    gem:llmScopingNote """Sub-property of gem:hasAnchoredCodingScope reaching prose-derived coding-correctness rules; very sparse in current data.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:PolicyCodingRule ;
    gem:memberOfOntology gem:gemOntology .

gem:hasPolicyGroup a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:hasAnchoredCodingScope ;
    gem:prefLabel "Has Policy Group" ;
    gem:description "A 'Has Policy Group' is a relationship that links a CMS Policy to a Policy Group instance organized within that policy's text. The property is asserted only when the policy's structure warrants Policy Groups under the minting rule (prerequisite HCPCS exist, or multiple parallel rule-sets are present). A policy may have zero or more Policy Groups; cardinality is open. Queries that need to aggregate a Group-structured policy's rule content -- for example, 'does this policy reference a given ICD-10 code anywhere?' -- must traverse this property to gather the per-Group assertions, because ICD-10 codes nested inside Policy Groups are not separately materialized as policy-level claims (the source-fidelity principle: the graph asserts ICD references only where the source asserts them, and within Group-structured policies the source asserts ICDs only at the Group level). Sub-property of gem:hasAnchoredCodingScope (S60 2026-06-15); RDFS inference adds the parent triple, so cross-cutting queries over hasAnchoredCodingScope transparently include all hasPolicyGroup assertions." ;
    gem:llmCardinalityNote """0..n (open).""" ;
    gem:llmTraversalHint """Reaches the documented Group-N structured code tables. Group-nested ICD-10 codes are materialized ONLY here, not at policy level, so any ICD-coverage question about a Group-structured policy must traverse this property. Sub-property of gem:hasAnchoredCodingScope (entails the parent).""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:PolicyGroup ;
    gem:memberOfOntology gem:gemOntology .

gem:hasPolicyRule a owl:ObjectProperty ;
    gem:prefLabel "Has Policy Rule" ;
    gem:description "A 'Has Policy Rule' is a relationship that links a CMS Policy or an Anchored Coding Scope (gem:PolicyGroup or gem:PolicyCodingRule) to a gem:PolicyRule instance -- a first-class rule entity that holds the verbatim text of one rule from the subject. A subject may have zero or more Policy Rules; cardinality is open. Not a sub-property of gem:hasAnchoredCodingScope: gem:PolicyRule is a content unit, not a structural anchor-scope, so the umbrella-predicate inheritance pattern that gem:hasPolicyGroup and gem:hasPolicyCodingRule share does not apply here. Introduced 2026-06-18 (Session 67) as Phase 1 of the multi-phase migration tracked in deferred_proposals[72]; see gem:PolicyRule for the rollout context. Domain extended from gem:CMSpolicy to union(gem:CMSpolicy, gem:AnchoredCodingScope) at S83 (2026-06-22) as the Phase 4 launch enabling the same first-class PolicyRule pattern on anchor-scope subjects (gem:PolicyGroup and gem:PolicyCodingRule); SHACL validation enforced per-class via gem:CMSpolicyShape and gem:AnchoredCodingScopeShape. The union-domain form was selected over an umbrella-property treatment (rdfs:domain owl:Thing) because the predicate's targets are a known small union of classes rather than arbitrary classes -- see gem:identifier for the contrasting umbrella case." ;
    gem:llmCardinalityNote """0..n (open). Not a sub-property of gem:hasAnchoredCodingScope (a rule is a content unit, not a structural anchor-scope).""" ;
    gem:llmInverseNote """No materialized inverse; to find a rule's owner, query the gem:PolicyRule in the object position.""" ;
    gem:llmTraversalHint """Primary entry to a policy's coverage rules. Its domain is union(gem:CMSpolicy, gem:AnchoredCodingScope): rules hang off BOTH the policy and its Groups/coding-rules. To gather ALL of a policy's rules, collect gem:hasPolicyRule from the policy AND from each of its gem:hasAnchoredCodingScope targets.""" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( gem:CMSpolicy gem:AnchoredCodingScope ) ] ;
    rdfs:range gem:PolicyRule ;
    gem:memberOfOntology gem:gemOntology .

gem:referencesPolicy a owl:ObjectProperty ;
    gem:prefLabel "References Policy" ;
    gem:description "A 'References Policy' is a relationship that links a CMS Policy, or an Anchored Coding Scope within one, to another CMS Policy that it cites. The link is created when the citation is discovered, even if the cited policy has not yet been processed; the cited policy instance is populated later when its own extraction pass is performed. Domain extended from gem:CMSpolicy to union(CMSpolicy, AnchoredCodingScope) at Session 197 (2026-07-24), matching the Session 60 extension of gem:excludesCondition and gem:excludesProcedure: A54969's chemodenervation gem:PolicyGroup delegates medical necessity to LCDs L35170 and L35172 and carries the citing links itself, which under the bare gem:CMSpolicy domain made RDFS inference type that code group as a policy." ;
    gem:llmDetailedDefinition """The agnostic super-property for every policy-to-policy citation. Its sub-properties gem:revisesPolicy, gem:transmitsChangeRequest, and gem:referencesChangeRequest each entail it, so a generic 'everything policy X points at' query on gem:referencesPolicy also returns revised targets and transmitted/cited CRs, not only bare citations. Use a specific sub-property when the citation semantics matter; use gem:referencesPolicy when they do not.""" ;
    gem:llmInverseNote """No inverse is materialized on gem:referencesPolicy itself. To find 'which policies reference X', query with X in the OBJECT position (?p gem:referencesPolicy X); do not expect an inverse edge to follow. Two of its sub-properties (gem:revisesPolicy, gem:transmitsChangeRequest) DO have materialized inverses.""" ;
    gem:llmTraversalHint """To enumerate ALL outbound references of a policy, query gem:referencesPolicy (it subsumes the specific kinds). For only revisions use gem:revisesPolicy; for only delivered CRs use gem:transmitsChangeRequest; for only cited-but-not-delivered CRs use gem:referencesChangeRequest.""" ;
    rdfs:domain [ a owl:Class ;
        owl:unionOf ( gem:CMSpolicy gem:AnchoredCodingScope ) ] ;
    rdfs:range gem:CMSpolicy ;
    gem:memberOfOntology gem:gemOntology .

gem:revisesPolicy a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:referencesPolicy ;
    owl:inverseOf gem:revisedByPolicy ;
    gem:prefLabel "Revises Policy" ;
    gem:description "A 'Revises Policy' is a relationship that links a CMS Policy to another CMS Policy that it revises. It is a sub-property of gem:referencesPolicy, so every revisesPolicy assertion entails the more agnostic referencesPolicy, allowing generic 'what policies does X reference' queries to continue returning revised targets while making the more specific revision semantic explicitly available. Inverse: gem:revisedByPolicy. In current CMS practice the revising agent is typically a transmittal acting on an NCD, LCD, or Article (e.g., R, N, or D entries in a transmittal's change-list table all give rise to revisesPolicy triples from the transmittal to the target manual section)." ;
    gem:llmInverseNote """Declared owl:inverseOf gem:revisedByPolicy, but only this direction is ASSERTED: gem:revisedByPolicy carries zero triples in the canonical .ttl files. In a triplestore with OWL inferencing the inverse edge is entailed and traversable; parsing the files alone it is not. To answer which transmittals revised a policy without depending on a reasoner, query this predicate with the policy in the OBJECT position. (Corrected at Session 197; the prior wording claimed both directions were asserted.)""" ;
    gem:llmScopingNote """In current CMS practice the revising SUBJECT is almost always a transmittal (R/N/D change-list entries all yield gem:revisesPolicy triples to the target section); a coverage document is rarely the subject of gem:revisesPolicy.""" ;
    gem:llmTraversalHint """Revision lineage: from a base coverage document follow gem:revisedByPolicy to reach the transmittals that revised it (current and historical). From a transmittal follow gem:revisesPolicy to the manual section/policy it acts on. Chains occur via rescind-and-replace (a transmittal revising an earlier transmittal). As a sub-property of gem:referencesPolicy, revised targets also surface under a plain gem:referencesPolicy query.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:CMSpolicy ;
    gem:memberOfOntology gem:gemOntology .

gem:revisedByPolicy a owl:ObjectProperty ;
    owl:inverseOf gem:revisesPolicy ;
    gem:prefLabel "Revised By Policy" ;
    gem:description "A 'Revised By Policy' is a relationship that links a CMS Policy to another CMS Policy that has revised it (typically a transmittal). Inverse of gem:revisesPolicy. Allows queries like 'which transmittals have modified this NCD?' to be answered directly without inverse traversal." ;
    gem:llmCardinalityNote """One policy may be revised by many transmittals over its life; expect multiple gem:revisedByPolicy values on a long-lived document.""" ;
    gem:llmInverseNote """Declared owl:inverseOf gem:revisesPolicy and ENTAILED, not asserted: this predicate carries zero triples in the canonical .ttl files. It resolves in a triplestore with OWL inferencing and returns nothing when the files are parsed on their own. Without a reasoner, answer which transmittals modified an NCD/LCD/Article by querying gem:revisesPolicy with the policy in the OBJECT position. (Corrected at Session 197; the prior wording claimed both directions were present in the data.)""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:CMSpolicy ;
    gem:memberOfOntology gem:gemOntology .

gem:transmitsChangeRequest a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:referencesPolicy ;
    owl:inverseOf gem:changeRequestTransmittedBy ;
    gem:prefLabel "Transmits Change Request" ;
    gem:description "A 'Transmits Change Request' is a relationship that links a CMS Manual transmittal (or Program Memorandum) to the Change Request (CR) it delivers and carries to contractors. The transmittal is the delivery vehicle; the CR is the numbered instruction work-item stating the operational, coverage, or system change. Sub-property of gem:referencesPolicy, so every transmitsChangeRequest assertion entails the agnostic referencesPolicy. A single CR may be transmitted by more than one transmittal across a rescind-and-replace chain (e.g., CR 8169 is transmitted by both TN 2663 and its replacement TN 2677). Inverse: gem:changeRequestTransmittedBy. By convention a transmitted CR's dc:source is the delivering transmittal's IRI." ;
    gem:llmCardinalityNote """Many-to-many in practice: a transmittal may transmit multiple CRs, and a CR may be transmitted by multiple transmittals across a rescind-replace chain (e.g. CR 8169 by both TN 2663 and TN 2677).""" ;
    gem:llmDetailedDefinition """Links a transmittal (or Program Memorandum) to the Change Request it DELIVERS. Reserved for the delivery relationship; contrast gem:referencesChangeRequest (a policy merely citing a CR). Sub-property of gem:referencesPolicy.""" ;
    gem:llmInverseNote """Declared owl:inverseOf gem:changeRequestTransmittedBy, but only this direction is ASSERTED: the inverse carries zero triples in the canonical .ttl files. It is entailed and traversable in a triplestore with OWL inferencing, and absent when the files are parsed on their own. Without a reasoner, query this predicate with the Change Request in the OBJECT position. (Corrected at Session 197.)""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:ChangeRequest ;
    gem:memberOfOntology gem:gemOntology .

gem:changeRequestTransmittedBy a owl:ObjectProperty ;
    owl:inverseOf gem:transmitsChangeRequest ;
    gem:prefLabel "Change Request Transmitted By" ;
    gem:description "A 'Change Request Transmitted By' is a relationship that links a Change Request to the CMS Manual transmittal (or Program Memorandum) that delivers it to contractors. Inverse of gem:transmitsChangeRequest. Answers 'which transmittal(s) carried this CR?' directly; returns every transmittal in a rescind-and-replace chain that delivered the same CR." ;
    gem:llmInverseNote """Declared owl:inverseOf gem:transmitsChangeRequest and ENTAILED, not asserted: this predicate carries zero triples in the canonical .ttl files. It resolves in a triplestore with OWL inferencing and returns nothing when the files are parsed on their own. Without a reasoner, answer which transmittals carried a CR by querying gem:transmitsChangeRequest with the CR in the OBJECT position; that returns every transmittal in a rescind-replace chain that delivered the same CR. (Corrected at Session 197; the prior wording claimed both directions were present in the data.)""" ;
    rdfs:domain gem:ChangeRequest ;
    rdfs:range gem:CMSpolicy ;
    gem:memberOfOntology gem:gemOntology .

gem:referencesChangeRequest a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:referencesPolicy ;
    gem:prefLabel "References Change Request" ;
    gem:description "A 'References Change Request' is a relationship that links a CMS Policy to a Change Request it merely cites for cross-reference (e.g., 'Further information can be found in CR nnnn') rather than delivers. Distinguished from gem:transmitsChangeRequest, which is reserved for the transmittal that actually carries the CR. Sub-property of gem:referencesPolicy. Example: TN 2677 references CR 8206 (MPPR for Selected Therapy Services), which is itself transmitted by TN 1194." ;
    gem:llmDetailedDefinition """A policy CITES a CR for cross-reference without delivering it (e.g. 'further information can be found in CR nnnn'). Distinct from gem:transmitsChangeRequest, the relationship of the transmittal that actually carries the CR. Sub-property of gem:referencesPolicy.""" ;
    gem:llmInverseNote """No materialized inverse. To find policies that cite a given CR, query the CR in the object position.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:ChangeRequest ;
    gem:memberOfOntology gem:gemOntology .

gem:requiresProviderCredential a owl:ObjectProperty ;
    gem:prefLabel "Requires Provider Credential" ;
    gem:description "A 'Requires Provider Credential' is a relationship that links a CMS Policy to a Provider Credential concept that the policy invokes as a condition on who may furnish, order, or evaluate a service or test." ;
    gem:llmInverseNote """No materialized inverse; find policies requiring a given credential by querying the credential in the object position.""" ;
    gem:llmScopingNote """Asserts a WHO-may-furnish/order/evaluate condition. The credential's definition lives on the gem:ProviderCredential individual, not on the rule; matching is by the claim's provider.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:ProviderCredential ;
    gem:memberOfOntology gem:gemOntology .

gem:delegatesCoverageTo a owl:ObjectProperty ;
    gem:prefLabel "Delegates Coverage To" ;
    gem:description "A 'Delegates Coverage To' is a relationship that links a gem:PolicyRule to the Medicare contractor authority to which the rule delegates the coverage determination -- i.e. contractor (MAC) discretion: the coverage decision is neither a national 'covered' nor a national 'non-covered' disposition but is handed to the named authority to decide. Presence of this predicate on a rule is itself the contractor-discretion marker; the object records the delegatee, reusing existing gem:ProviderCredential individuals -- gemi:credentialMedicareAdministrativeContractor for delegation to the MAC as a whole, gemi:credentialMedicalStaff for delegation to the MAC medical staff specifically. Two source shapes both use this predicate: (A) a whole-policy no-national-determination delegation, where CMS declines or removes an NCD and states that coverage determinations are made by the MACs under Sec. 1862(a)(1)(A) through the LCD process or case-by-case adjudication (NCD 200.2, NCD 180.2, NCD 240.2.2); and (B) a bounded delegation inside an otherwise nationally-covered frame, where a specific sub-decision is handed to the MAC or its medical staff (NCD 260.1 adult-liver-transplant malignancies; NCD 280.7 variable-height and electric bed features; NCD 280.14 other-uses infusion-pump determinations). This is a live, rule-level facet recording TO WHOM the determination is delegated; it is deliberately orthogonal to, and complementary with, the deferred gem:CoverageDecision disposition vocabulary (gem:covered / gem:notCovered / gem:mac_discretion) on gem:CoverageOutcome (deferred_proposals[72] Phase 2), which records WHAT the disposition is. The two are not duplicative -- when the deferred decision axis is built a rule may carry gem:mac_discretion as its outcome disposition and gem:delegatesCoverageTo for the delegatee, each answering a different question. Introduced 2026-07-18 (Session 167) as the implementation of deferred_proposals[90]." ;
    gem:llmScopingNote """Presence marks that the rule's coverage determination is delegated to a Medicare contractor authority (contractor/MAC discretion); the object is that authority, reusing gem:ProviderCredential individuals (the MAC, or the MAC medical staff). It does NOT assert that the delegatee furnishes the service -- it names who decides coverage, not who provides it. Orthogonal to the deferred gem:CoverageDecision disposition value gem:mac_discretion (deferred_proposals[72]): this facet is 'to whom', that value is 'what'. Find contractor-discretion rules by querying the presence of this predicate.""" ;
    rdfs:domain gem:PolicyRule ;
    rdfs:range gem:ProviderCredential ;
    gem:memberOfOntology gem:gemOntology .

gem:refersToBenefitCategory a owl:ObjectProperty ;
    gem:prefLabel "Refers to Benefit Category" ;
    gem:description "A 'Refers to Benefit Category' is a relationship that links a CMS Policy to a Benefit Category that the policy names. The link records the presence of the category in the policy's scope; it does not assert coverage polarity for items in the category." ;
    gem:llmInverseNote """No materialized inverse.""" ;
    gem:llmScopingNote """Presence-only: records that a policy names a benefit category; asserts no coverage polarity for items in it. Statute/NCD-level -- absent on LCDs.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:BenefitCategory ;
    gem:memberOfOntology gem:gemOntology .

gem:codeGroupOwner a owl:AnnotationProperty ;
    rdfs:subPropertyOf dcterms:rightsHolder ;
    gem:prefLabel "Code Group Owner" ;
    gem:description "A 'Code Group Owner' names the party responsible for a gem:CodeGroup -- the authority that defines and maintains the group's membership. Code groups derived from CMS coverage policy carry \"CMS\"; other owners may emerge as analysts define their own groups (for example an ad-hoc analysis set owned by a named team or individual). Declared as a sub-property of dcterms:rightsHolder so a consumer can query the standard Dublin Core rights-holder predicate and transparently receive the owner via rdfs:subPropertyOf entailment. The value is recorded as a string literal in the project's catalog-now / consolidate-later posture; a future cycle may migrate owners to first-class Agent resources if disambiguation becomes necessary. Introduced 2026-06-30 (Session 103)." ;
    rdfs:domain gem:CodeGroup ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:identifiesClinicalConcept a owl:ObjectProperty ;
    gem:prefLabel "Identifies Clinical Concept" ;
    gem:description "An 'Identifies Clinical Concept' is a relationship that links a gem:CodeGroup to a gem:ClinicalConcept that the group represents or is identified by. A group may identify zero, one, or many clinical concepts (for example the Respiratory Assist Devices code group identifies the 'respiratory assist device' concept), or none at all (an arbitrary analysis set need not correspond to any clinical concept). Semantically this is the same relation as gem:refersToClinicalConcept (it records concept presence, asserts no coverage polarity, and does not evaluate how the concept is mentioned); it is held as a distinct predicate solely to physically separate code-group-to-concept links from policy-to-concept links in the graph, so the two link populations can be queried independently. The motivating query -- 'which policies refer to clinical concepts identified in this code group?' -- joins this predicate (group-to-concept) with gem:refersToClinicalConcept (policy-to-concept) on the shared concept. Introduced 2026-06-30 (Session 103)." ;
    gem:llmDetailedDefinition """The CODE-GROUP-to-concept analogue of gem:refersToClinicalConcept (same presence-only, polarity-neutral semantics). Held as a DISTINCT predicate only to keep group->concept links physically separate from policy->concept links so the two populations query independently. Domain gem:CodeGroup; a group may identify zero, one, or many concepts.""" ;
    gem:llmTraversalHint """The motivating join: 'which policies refer to concepts identified by this code group?' = gem:identifiesClinicalConcept (group->concept) joined with gem:refersToClinicalConcept (policy->concept) on the shared concept.""" ;
    rdfs:domain gem:CodeGroup ;
    rdfs:range gem:ClinicalConcept ;
    gem:memberOfOntology gem:gemOntology .

gem:memberCodePattern a owl:DatatypeProperty ;
    gem:prefLabel "Member Code Pattern" ;
    gem:description "A 'Member Code Pattern' is a regular-expression string that defines membership of a gem:CodeGroup by matching against the full IRI string of candidate code individuals, used for prefix-defined structural groups (notably the HCPCS Level II letter categories) so the group node remains a few triples instead of enumerating thousands of member codes. The expression is matched (REGEX) against STR(?code) for individuals typed gem:HCPCSprocedure, gem:CPTprocedure, or gem:ICDdiagnosis; the gem_reference.md section 2o member-resolution and CONSTRUCT queries use it to resolve or materialize membership. A group may carry zero or more patterns (a group spanning several prefixes carries several) and may combine a pattern with an enumerated skos:narrower curated core. Stored in anchored full-IRI form -- for HCPCS Level II category E, the IRI prefix .../ontology/HCPCS/E followed by four digits, end-anchored. Introduced 2026-06-30 (Session 104) when the HCPCS Level II letter categories were minted." ;
    gem:llmDetailedDefinition """A regular-expression string (matched against the full code IRI) defining gem:CodeGroup membership for prefix-defined structural groups (notably the HCPCS Level II letter categories), so the group node stays a few triples instead of enumerating thousands of members. A group may carry several patterns and/or combine a pattern with an enumerated skos:narrower core.""" ;
    gem:llmScopingNote """To resolve members, REGEX STR(?code) over individuals typed gem:HCPCSprocedure / gem:CPTprocedure / gem:ICDdiagnosis. Stored end-anchored in full-IRI form.""" ;
    rdfs:domain gem:CodeGroup ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:refersToClinicalConcept a owl:ObjectProperty ;
    gem:prefLabel "Refers to Clinical Concept" ;
    gem:description "A 'Refers to Clinical Concept' is a relationship that links a CMS Policy to a Clinical Concept that appears in the policy's text. The link records the presence of the concept in the policy; it does not assert coverage polarity and does not evaluate how the concept is mentioned." ;
    gem:llmInverseNote """No materialized inverse; find policies mentioning a concept by querying the concept in the object position.""" ;
    gem:llmScopingNote """The densest link in the graph. PRESENCE-ONLY: it records that a concept appears in a policy and asserts NO coverage polarity and does not evaluate how the concept is mentioned. For polarity use the covers*/excludes* code links or read the rule text.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:ClinicalConcept ;
    gem:memberOfOntology gem:gemOntology .

gem:refersToHealthcareSetting a owl:ObjectProperty ;
    gem:prefLabel "Refers to Healthcare Setting" ;
    gem:description "A 'Refers to Healthcare Setting' is a relationship that links a CMS Policy to a gem:HealthcareSetting (a place of care) that appears in the policy's text. The link records the presence of the setting in the policy; it does not assert coverage polarity and does not evaluate how the setting is mentioned, mirroring gem:refersToClinicalConcept. A policy carries a separate triple to every distinct setting it names. Introduced 2026-07-04 (Session 117) as work item [70]. Polarity sub-properties were added at Session 197 (2026-07-24) -- see gem:coversInHealthcareSetting -- and are normally asserted on gem:PolicyRule subjects; this presence link on the policy is unaffected by them and continues to be asserted directly." ;
    gem:llmScopingNote """Presence-only and polarity-neutral: this records that the setting APPEARS in the policy's text. Asserted directly on the policy, one triple per distinct setting it names. It is the polarity-neutral parent of gem:coversInHealthcareSetting, gem:exclusivelyCoversInHealthcareSetting and gem:excludesHealthcareSetting, but unlike gem:refersToICDdiagnosis and gem:refersToHCPCSprocedure it is NOT generally reached by entailment from them: setting polarity is usually asserted on a gem:PolicyRule, and a rule's statements are CONTAINED in its policy rather than propagating to the policy as its own assertions. (Where a polarity link does carry a policy subject, entailment supplies this parent as normal.) The two answer different questions -- this one whether the policy names the setting, the polarity family what a given rule says about it -- and both are observed directly at extraction; neither is derived from the other.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:HealthcareSetting ;
    gem:memberOfOntology gem:gemOntology .

gem:hasMeasurementContext a owl:ObjectProperty ;
    gem:prefLabel "Has Measurement Context" ;
    gem:description "A 'Has Measurement Context' is a relationship that links a gem:ClinicalConcept (typically a composite finding/test/therapy concept whose name fuses a measurement with the condition under which it was taken) to the gem:MeasurementContext (at rest, during exercise, during sleep, during the day) that qualifies it. Additive and non-destructive: the composite concept is preserved verbatim (the catalog-phrasings posture) and the context is exposed as a queryable, normalized tag rather than by splitting the concept URI or relinking policy references. Introduced 2026-07-05 (Session 118) as work item [1]." ;
    gem:llmScopingNote """Attaches a normalized gem:MeasurementContext to a gem:ClinicalConcept (not to a policy). Additive/non-destructive: the composite concept is preserved verbatim and the context is exposed as a queryable tag. Sparse in current data.""" ;
    rdfs:domain gem:ClinicalConcept ;
    rdfs:range gem:MeasurementContext ;
    gem:memberOfOntology gem:gemOntology .

gem:refersToCodeGroup a owl:ObjectProperty ;
    gem:prefLabel "Refers to Code Group" ;
    gem:description "A 'Refers to Code Group' is a relationship that links a CMS Policy to a gem:CodeGroup at least one of whose member codes the policy references. The link records that the policy uses a code belonging to the group; it asserts no coverage polarity (a code reached by gem:coversProcedure and one reached by gem:excludesProcedure both establish the link) and does not evaluate how the code is mentioned, mirroring gem:refersToClinicalConcept. A policy carries a separate gem:refersToCodeGroup triple to every group it touches; because code groups may overlap (a curated group is a subset of its enclosing HCPCS letter category), one referenced code can establish links to several groups. These links are a derived, materialized fact: they are recomputed from current policy code references intersected with current group membership (enumerated skos:narrower core and/or gem:memberCodePattern regex) by an idempotent linking pass, re-run at session close whenever a policy's codes or a group's membership change, and guarded by the gem_audit.py codegroup_link_drift check. Introduced 2026-06-30 (Session 104)." ;
    gem:llmDetailedDefinition """Policy -> gem:CodeGroup at least one of whose member codes the policy references; POLARITY-NEUTRAL (a code reached by gem:coversProcedure and one reached by gem:excludesProcedure both establish the link). One triple per group touched; because groups may overlap, one referenced code can link several groups.""" ;
    gem:llmScopingNote """These links are DERIVED/materialized -- recomputed from current policy code references intersected with current group membership by an idempotent pass and guarded by the gem_audit.py codegroup_link_drift check. Treat them as a computed convenience index, not as source assertions.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:CodeGroup ;
    gem:memberOfOntology gem:gemOntology .

gem:refersToHCPCSprocedure a owl:ObjectProperty ;
    gem:prefLabel "Refers to HCPCS Procedure" ;
    gem:description "A 'Refers to HCPCS Procedure' is a relationship that links a CMS Policy to a HCPCS procedure or item code that the policy references, without asserting coverage polarity. It is the polarity-neutral parent of gem:coversProcedure, gem:excludesProcedure, and gem:requiresProcedure; a query on this property returns procedure references of either polarity as well as references a policy makes with no polarity stated." ;
    gem:llmDetailedDefinition """The POLARITY-NEUTRAL parent of the procedure family: gem:coversProcedure, gem:excludesProcedure, gem:requiresProcedure, and the closed-list gem:exclusivelyCoversProcedure.""" ;
    gem:llmInverseNote """No materialized inverse.""" ;
    gem:llmScopingNote """Unlike the condition side, covered procedures ARE asserted DIRECTLY via gem:coversProcedure (not via a closed-list form); gem:refersToHCPCSprocedure and gem:exclusivelyCoversProcedure carry essentially no direct triples in current data. Query gem:coversProcedure for covered procedures (or this parent with inference).""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:HCPCSprocedure ;
    gem:memberOfOntology gem:gemOntology .

gem:refersToHCPCSmodifier a owl:ObjectProperty ;
    gem:prefLabel "Refers to HCPCS Modifier" ;
    gem:description "A 'Refers to HCPCS Modifier' is a relationship that links a CMS Policy to a HCPCS modifier that the policy references. Modifiers are billing instructions rather than covered or non-covered items, so a single polarity-neutral predicate is used; there is no covered/non-covered pair for modifiers." ;
    gem:llmInverseNote """No materialized inverse.""" ;
    gem:llmScopingNote """The SOLE policy-level modifier predicate, and polarity-neutral -- modifiers are billing instructions with no covered/non-covered pair. It records that a policy references a modifier; policy-specific modifier-usage rules (selective applicability, required-with-code combinations) remain in the policy's rule text.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:HCPCSmodifier ;
    gem:memberOfOntology gem:gemOntology .

gem:refersToICDdiagnosis a owl:ObjectProperty ;
    gem:prefLabel "Refers to ICD Diagnosis" ;
    gem:description "A 'Refers to ICD Diagnosis' is a relationship that links a CMS Policy to an ICD-10-CM Diagnosis code.  The range value is an instance of ICD Diagnosis." ;
    gem:llmDetailedDefinition """The POLARITY-NEUTRAL parent of the ICD-condition family: gem:coversCondition (supports coverage), gem:excludesCondition (supports denial), and the closed-list gem:exclusivelyCovers*Condition specializations. A query here returns condition references of any polarity.""" ;
    gem:llmInverseNote """No materialized inverse; find policies referencing a diagnosis by querying the code in the object position (across the sub-properties).""" ;
    gem:llmScopingNote """In current data, condition references are asserted almost entirely through the polarity SUB-properties -- overwhelmingly the closed-list gem:exclusivelyCoversCondition -- with very few triples asserted directly on gem:refersToICDdiagnosis or bare gem:coversCondition. To retrieve covered conditions you must query gem:exclusivelyCoversCondition directly, OR run the parent query WITH RDFS subproperty inference; a bare non-inferential query on this parent or on gem:coversCondition will miss the bulk of the data.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:ICDdiagnosis ;
    gem:memberOfOntology gem:gemOntology .

gem:refersToQualificationGroup a owl:ObjectProperty ;
    gem:prefLabel "Refers to Qualification Group" ;
    gem:description "A 'Refers to Qualification Group' is a relationship that links a CMS Policy to a Qualification Group that the policy names. The link records the presence of the named tier in the policy's text; it does not assert that policies sharing a group name define the tier identically, and it does not evaluate the group's criteria." ;
    gem:llmScopingNote """Records that a policy names a qualification tier; does NOT assert that policies sharing a group name define the tier identically, and does not evaluate the group's criteria.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:QualificationGroup ;
    gem:memberOfOntology gem:gemOntology .

gem:requiresProcedure a owl:ObjectProperty ;
    rdfs:subPropertyOf gem:refersToHCPCSprocedure ;
    gem:prefLabel "Requires Procedure" ;
    gem:description "A 'Requires Procedure' is a relationship that links a CMS Policy to a HCPCS procedure or item code the policy references as required in order to support coverage or medical necessity. It is a sub-property of gem:refersToHCPCSprocedure, so a query on the polarity-neutral property still returns these covered references." ;
    gem:llmDetailedDefinition """Policy -> HCPCS procedure REQUIRED to support coverage (a prerequisite), distinct from merely covered. Sub-property of gem:refersToHCPCSprocedure.""" ;
    gem:llmScopingNote """Unused in current data; reserved for prerequisite-procedure requirements.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:HCPCSprocedure ;
    gem:memberOfOntology gem:gemOntology .

gem:restrictionConcept a owl:ObjectProperty ;
    gem:prefLabel "Restriction Concept" ;
    gem:description "A 'Restriction Concept' is a relationship that links a gem:CoverageRestriction to the gem:ClinicalConcept that the restriction applies to. Optional: not every restriction names a concept (a count restriction such as NCD 240.2's 'only one type of unit will be covered' may carry no concept, with the narrowing fully expressed via gem:restrictionType + gem:restrictionDescription). Used most naturally on use-case restrictions, where the concept is the use-case being restricted to (e.g., gemi:contextDuringSleep for NCD 240.2's 'oxygen during sleep only' restriction). Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72." ;
    gem:llmScopingNote """Optional link from a gem:CoverageRestriction to the gem:ClinicalConcept it restricts to (used mainly on use-case restrictions; count/duration restrictions may carry none). Part of the deferred, currently-unpopulated coverage-qualifier layer.""" ;
    rdfs:domain gem:CoverageRestriction ;
    rdfs:range gem:ClinicalConcept ;
    gem:memberOfOntology gem:gemOntology .

gem:restrictionType a owl:ObjectProperty ;
    gem:prefLabel "Restriction Type" ;
    gem:description "A 'Restriction Type' is a relationship that links a gem:CoverageRestriction to a named value of gem:RestrictionType, tagging the dimension along which the restriction narrows coverage. Current values are gem:restrictionType_useCase (narrows the clinical context or use case), gem:restrictionType_count (narrows the cardinality), gem:restrictionType_duration (narrows the time span), and gem:restrictionType_frequency (narrows how often the covered item may be claimed). The vocabulary is extended as new policies surface additional restriction shapes. Parallels gem:ruleType (codified at sub-cycle (b) of work item #72) and gem:nextPlannedStep (S45) -- same controlled-vocab pattern, distinct domain. Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72." ;
    gem:llmEnumeratedValues """Per-value definitions (range gem:RestrictionType). gem:restrictionType_useCase = narrows the clinical context or use case (e.g. NCD 240.2 'oxygen during sleep only'). gem:restrictionType_count = narrows the cardinality (e.g. 'only one type of unit will be covered'). gem:restrictionType_duration = narrows the time span (e.g. a '90 days' initial-coverage limit). gem:restrictionType_frequency = narrows how often the covered item may be claimed. Open vocabulary. NOTE the shared 'frequency' member is distinct from gem:ruleType_frequency: restrictionType_frequency narrows a covered item's claim frequency, while ruleType_frequency classifies a whole rule as being about frequency criteria.""" ;
    gem:llmScopingNote """Applies to gem:CoverageRestriction, part of the deferred coverage-qualifier layer -- no instances in the current data.""" ;
    rdfs:domain gem:CoverageRestriction ;
    rdfs:range gem:RestrictionType ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleDomain a owl:ObjectProperty ;
    gem:prefLabel "Rule Domain" ;
    gem:description "A 'Rule Domain' is a relationship that links a gem:PolicyRule to a named value of gem:RuleDomain, tagging the clinical activity within a policy that the rule applies to. A rule may carry multiple gem:ruleDomain values when the source's framing applies to multiple activities (cardinality 0..n). Absence of a gem:ruleDomain triple is acceptable: single-domain policies don't always need an explicit domain tag (the policy itself names the domain), so domain tagging is most useful when one policy spans multiple activities (e.g., NCD 210.10 covering both STI laboratory screening and HIBC). Introduced 2026-06-18 (Session 69) as Phase 3 sub-cycle (b+c) of work item #72; see gem_structured_rule_guide.md §`gem:RuleDomain` for the design rationale." ;
    gem:llmEnumeratedValues """Per-value definitions (range gem:RuleDomain), from gem_rule_categories.md Axis 1. gem:ruleDomain_screening = rule applies to laboratory screening only (e.g. NCD 210.10 STI screening leg). gem:ruleDomain_hibc = rule applies to High Intensity Behavioral Counseling only (e.g. NCD 210.10 HIBC leg). gem:ruleDomain_crossCutting = rule applies to both/either service within a multi-domain policy. Open vocabulary, extended as new multi-activity policies arrive.""" ;
    gem:llmScopingNote """0..n and SPARSE: usually asserted only on multi-activity policies. Absence of a gem:ruleDomain triple is normal and does NOT mean the rule has no domain -- for a single-activity policy the policy itself names the domain.""" ;
    rdfs:domain gem:PolicyRule ;
    rdfs:range gem:RuleDomain ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType a owl:ObjectProperty ;
    gem:prefLabel "Rule Type" ;
    gem:description "A 'Rule Type' is a relationship that links a gem:PolicyRule to a named value of gem:RuleType, tagging the kind of evaluator criterion the rule expresses. A rule may carry multiple gem:ruleType values when its content spans multiple criterion categories (cardinality 0..n) -- e.g., a rule defining both who may perform a service and what setting is required carries both gem:ruleType_credentialedActor and gem:ruleType_settingDefinition. Introduced 2026-06-18 (Session 69) as Phase 3 sub-cycle (b+c) of work item #72; see gem_structured_rule_guide.md §`gem:RuleType` for the design rationale." ;
    gem:llmCardinalityNote """0..n; a rule commonly carries one or two type tags (densely populated overall). Multiple values mean the rule's content spans multiple criterion categories.""" ;
    gem:llmEnumeratedValues """Per-value definitions (range gem:RuleType), from gem_rule_categories.md Axis 2. gem:ruleType_coverageScope = what is covered, at what level. gem:ruleType_eligibility = who/when is eligible. gem:ruleType_frequency = how often / repeat-screening intervals. gem:ruleType_settingDefinition = what setting is required (positive definition + exclusions). gem:ruleType_credentialedActor = who can order/perform/provide. gem:ruleType_serviceDefinition = defines a service itself. gem:ruleType_serviceStandard = technical standards (FDA, CLIA, etc.). gem:ruleType_riskFactor = enumerates risk factors. gem:ruleType_riskDetermination = who/how determines risk. gem:ruleType_documentation = documentation requirements. gem:ruleType_nonCoverage = what is NOT covered. gem:ruleType_costSharing = patient cost obligations. gem:ruleType_concurrentServices = what services can be billed on the same date / together. gem:ruleType_statutoryFraming = scope-defining reference to statute. gem:ruleType_studyDesign = content, structure, or analytical plan a study must follow. gem:ruleType_studyQuality = methodological integrity of a study (e.g. CMS Coverage with Evidence Development). gem:ruleType_outcomeMeasure = how a study measures or characterizes an outcome. gem:ruleType_procedural = program-administrative process distinct from substantive claim-eligibility rules. gem:ruleType_definition = generic catch-all for definitional rules not covered above. gem:ruleType_paymentRule = whether/how much/how often Medicare pays for a covered item. gem:ruleType_codingCorrectness = how a claim must be coded (required/prohibited codes and modifiers, code-selection and units rules, incorrect-coding denials). Vocabulary is open (extended as new policies surface types); retired values are in gem_rule_categories.md.""" ;
    rdfs:domain gem:PolicyRule ;
    rdfs:range gem:RuleType ;
    gem:memberOfOntology gem:gemOntology .

# -----------------------------------------------------------------------------
#    Property Definitions
# -----------------------------------------------------------------------------
gem:publicationNumber a owl:DatatypeProperty ;
    gem:prefLabel "Publication Number" ;
    gem:description "A 'Publication Number' is a datatype property that contains the CMS Manual publication number under which a CMS Policy is published, for example '100-3' for the National Coverage Determinations Manual." ;
    gem:llmScopingNote """CMS Manual publication number the policy is published under (e.g. '100-3' for the NCD Manual, '100-04' for the Claims Processing Manual). Identifies the manual, not the section; pair with gem:manualSectionNumber for full manual coordinates.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:manualSectionNumber a owl:DatatypeProperty ;
    gem:prefLabel "Manual Section Number" ;
    gem:description "A 'Manual Section Number' is a datatype property that contains the CMS Manual section number identifying a CMS Policy within its publication, for example '240.2'." ;
    gem:llmScopingNote """Section number locating the policy within its publication (e.g. '240.2'). Combine with gem:publicationNumber (publication + section = manual coordinate). For an NCD this typically mirrors the NCD's own section identifier.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:priorManualSectionNumber a owl:DatatypeProperty ;
    gem:prefLabel "Prior Manual Section Number" ;
    gem:description "A 'Prior Manual Section Number' is a datatype property that records a manual coordinate -- publication plus section -- under which a CMS Policy was published in an earlier version, and under which it no longer appears. It exists because CMS renumbers: the Coverage Issues Manual (Pub. 6) was converted into the National Coverage Determinations Manual (Pub. 100-03), and sections were renumbered within a publication as well, so a single policy document (one NCDId) can carry several manual coordinates over its life. A citation written against an old coordinate must still resolve to the policy that holds the content today; this property is that lookup. The value is the full coordinate as the superseded version's own rendition prints it, publication first: 'Pub. 6 §35-98'. Repeatable -- one triple per superseded coordinate, in no significant order. It does NOT date the coordinate and does not say which version carried it: gem:publicationNumber and gem:manualSectionNumber remain the single-valued current-version facts, and version-scoped modeling is the larger open question logged as policy_worklist.json deferred_proposals[98]. A policy whose coordinate never changed carries no triple of this property. Introduced 2026-07-16 (Session 152) at NCD 270.1, whose three versions ran 'Pub. 6 §35-98' -> 'Pub. 6 §35-102' -> 'Pub. 100-3 §270.1'." ;
    gem:llmCardinalityNote """0..N. Absent on most policies -- absence means no renumbering is recorded, NOT that none occurred (the history is only visible when every version rendition was supplied at extraction).""" ;
    gem:llmDetailedDefinition """A manual coordinate (publication + section) a policy was published under in an earlier version and no longer appears under -- e.g. 'Pub. 6 §35-98' on gemi:ncd270.1, which is published today at Pub. 100-3 §270.1. Use it to resolve a citation written against a superseded coordinate to the policy holding that content now. Repeatable. Carries no date and no version linkage; gem:publicationNumber / gem:manualSectionNumber remain the current-version facts.""" ;
    gem:llmScopingNote """Superseded coordinates only -- never the current one, which lives on gem:publicationNumber + gem:manualSectionNumber. A partial answer to multi-version management by design: it makes old-coordinate lookup work without modeling versions as first-class individuals (deferred_proposals[98]).""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:policyVersion a owl:DatatypeProperty ;
    gem:prefLabel "Policy Version" ;
    gem:description "A 'Policy Version' is a datatype property that contains the version or revision label of the current iteration of a CMS Policy, recorded verbatim as the document states it. Version schemes differ by document type -- for example an NCD version number, an LCD revision label, or an MCD Article revision label -- so the value is stored as a string and its scheme is not validated." ;
    gem:llmScopingNote """Free-text version label recorded verbatim; the scheme varies by document type (NCD version number vs LCD/Article revision label) and is not validated. Do not parse or compare it across document types as if it were numeric.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:policyEffectiveDate a owl:DatatypeProperty ;
    gem:prefLabel "Policy Effective Date" ;
    gem:description "A 'Policy Effective Date' is a datatype property that contains the date on which the current version of a CMS Policy took legal effect as a coverage determination. It is a property of the policy's legal lifecycle and is distinct from any claim-side or service-line date." ;
    gem:llmCardinalityNote """One per policy version.""" ;
    gem:llmDetailedDefinition """The date the current version took LEGAL effect as a coverage determination, a property of the policy's legal lifecycle. Distinct from gem:policyImplementationDate (when contractors were directed to have claims systems reflect it) and from all claim-side/service-line dates. When reasoning about which policy version governs a given date of service, effective date is the relevant boundary.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range xsd:date ;
    gem:memberOfOntology gem:gemOntology .

gem:policyImplementationDate a owl:DatatypeProperty ;
    gem:prefLabel "Policy Implementation Date" ;
    gem:description "A 'Policy Implementation Date' is a datatype property that contains the date on which Medicare contractors were directed to have their claims-processing systems reflect a CMS Policy. It is distinct from the policy's effective date, which marks when the policy took legal effect." ;
    gem:llmCardinalityNote """One per policy version; may be absent for older policies whose documents state no implementation date.""" ;
    gem:llmDetailedDefinition """The date Medicare contractors were directed to have their claims-processing systems reflect the policy: operational, not legal. Distinct from gem:policyEffectiveDate (legal effect), which is the boundary for coverage-governance reasoning. Implementation date is usually equal to or later than the effective date.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range xsd:date ;
    gem:memberOfOntology gem:gemOntology .

gem:policyPageCount a owl:DatatypeProperty ;
    gem:prefLabel "Policy Page Count" ;
    gem:description "A 'Policy Page Count' is a datatype property that contains the number of pages in the source document at the time of extraction, taken from the PDF rendering (file produced or downloaded) that served as the authoritative source for the extraction pass. Operationally useful for triage (small vs. large policy) and capacity planning; not semantically tied to coverage decisions." ;
    gem:llmScopingNote """Extraction/triage metadata (page count of the source PDF at extraction time). Not tied to coverage semantics; ignore it when answering coverage questions.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range xsd:integer ;
    gem:memberOfOntology gem:gemOntology .

gem:coverageMechanismNote a owl:DatatypeProperty ;
    gem:prefLabel "Coverage Mechanism Note" ;
    gem:description "A 'Coverage Mechanism Note' is a datatype property that holds a free-text annotation of any Medicare coverage mechanism (e.g., Coverage with Evidence Development, Clinical Trials Approval) that a policy invokes or depends on. The text captures the substantive content of the mechanism's role in the policy in a form suitable for subject-matter-expert review, without committing to a first-class CoverageMechanism class. Used when a policy refers a coverage decision to a Medicare-administered program whose operative details (study approval, patient eligibility, claim-borne modifiers) live outside the policy text and may need separate modeling later." ;
    gem:llmScopingNote """Free-text note on a Medicare coverage mechanism a policy invokes (e.g. Coverage with Evidence Development, Clinical Trials approval). The mechanism's operative details live outside the policy text; treat this as SME-review narrative, not a structured link.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:modifierSemantics a owl:DatatypeProperty ;
    gem:prefLabel "Modifier Semantics" ;
    gem:description "A 'Modifier Semantics' is a datatype property that holds a free-text annotation of the standard Medicare meaning of a HCPCS modifier code, applied as a local annotation on the modifier IRI itself. Used for modifiers whose semantics are stable and domain-wide across Medicare (notably the KX/GA/GZ coverage-criteria-met/ABN-status triad). Vocabulary-level annotation, not policy-specific; policy-specific modifier-usage rules (selective applicability, exclusions, required-with-code combinations) remain captured in policy gem:description text and are a candidate for separate gem:modifierRule promotion in a future reprocessing pass." ;
    gem:llmScopingNote """Free-text standard Medicare meaning of a HCPCS modifier, annotated on the modifier IRI itself (vocabulary-level, not policy-specific -- notably the KX/GA/GZ coverage-criteria/ABN-status triad). Policy-specific modifier-usage rules remain in the policy's rule text, not here.""" ;
    rdfs:domain gem:HCPCSmodifier ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:exclusionDescription a owl:DatatypeProperty ;
    gem:prefLabel "Exclusion Description" ;
    gem:description "An 'Exclusion Description' is a datatype property that holds a human-readable description of what is being excluded from coverage within a gem:CoverageExclusion. The text is typically a close paraphrase or verbatim quote of the source policy language naming the exclusion -- e.g., for NCD 240.2 Group I sleep bullet's portable-oxygen carve-out, the description would read 'Portable oxygen would not be covered in this situation.' Provides the verbatim-friendly fallback for downstream consumers that do not yet operate over the structured form. Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72." ;
    gem:llmScopingNote """Human-readable text of a gem:CoverageExclusion. Part of the deferred coverage-qualifier layer -- unpopulated in current data; the exclusion content is presently carried in the verbatim gem:ruleDescription instead.""" ;
    rdfs:domain gem:CoverageExclusion ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:restrictionDescription a owl:DatatypeProperty ;
    gem:prefLabel "Restriction Description" ;
    gem:description "A 'Restriction Description' is a datatype property that holds a human-readable description of what is being restricted within a gem:CoverageRestriction. The text is typically a close paraphrase or verbatim quote of the source policy language naming the restriction -- e.g., for NCD 240.2 Group I sleep bullet's two restrictions, the descriptions would read 'Coverage is provided only for use of oxygen during sleep.' and 'Only one type of unit will be covered.' Provides the verbatim-friendly fallback for downstream consumers that do not yet operate over the structured form. Until the gem:restrictionValue property is codified (deferred at S69 Phase 3a pending claim-data substrate understanding), any numeric value naming a count/duration/frequency restriction lives inside this description string. Introduced 2026-06-18 (Session 69) as Phase 3a of work item #72." ;
    gem:llmScopingNote """Human-readable text of a gem:CoverageRestriction. Part of the deferred coverage-qualifier layer -- unpopulated in current data; the restriction content is presently carried in gem:ruleDescription. When this layer is populated, any numeric count/duration/frequency value lives inside this string until gem:restrictionValue is codified.""" ;
    rdfs:domain gem:CoverageRestriction ;
    rdfs:range xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:ProgramMemorandumPolicy a owl:Class ;
    rdfs:subClassOf gem:CMSpolicy ;
    gem:prefLabel "Program Memorandum Policy" ;
    gem:description "A 'Program Memorandum Policy' is a class of CMS Policy representing a pre-MAC-era Program Memorandum (PM) issued by CMS (and predecessor HCFA) to its Carriers, Intermediaries, and Fiscal Intermediaries. Program Memoranda were the predecessor publication category for what are now organized as Pub. 100-04 (Claims Processing Manual) transmittals. A Program Memorandum that establishes or modifies a coverage-relevant rule (credentialing, supervision-level taxonomy, code-of-record convention, etc.) is treated as a first-class policy document at the stub layer and may be advanced to full extraction. Sibling class of gem:TransmittalPolicy under gem:CMSpolicy; the two classes differ in document type (PM vs. transmittal) but share the same role-shape (versioned change-instructions from CMS to its administrators). Introduced 2026-06-08 (Session 45) to give PM B-01-28 a typed graph stub when L36524 cites it." ;
    gem:llmDetailedDefinition """A pre-MAC-era Program Memorandum, the predecessor of the Pub.100-04 transmittal. Sibling of gem:TransmittalPolicy under gem:CMSpolicy: same change-instruction role-shape, different document era and type. Like a transmittal it may carry a Change Request via gem:transmitsChangeRequest and revise policies via gem:revisesPolicy.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:CMSmanualChapter a owl:Class ;
    rdfs:subClassOf gem:CMSpolicy ;
    gem:prefLabel "CMS Manual Chapter" ;
    gem:description "A 'CMS Manual Chapter' is a chapter of a CMS program manual (e.g. the Medicare Benefit Policy Manual, Pub. 100-02, or the Medicare Claims Processing Manual, Pub. 100-04) cited as a cross-reference by a coverage policy. Subclass of gem:CMSpolicy so that discoverer policies may link to it via gem:referencesPolicy (whose range is gem:CMSpolicy) and so it participates in the standard stub/extraction workflow (gem:nextPlannedStep). NOTE: this class intentionally does NOT use the '...Policy' suffix of its sibling coverage-document classes (gem:NCDpolicy, gem:LCDpolicy, gem:ArticlePolicy, gem:TransmittalPolicy, gem:ProgramMemorandumPolicy) -- the naming exception signals that a manual chapter is a governing reference document rather than a coverage-determination document. Introduced 2026-07-05 (Session 118) as work item [69], reversing the prior convention under which Manual chapters were worklist-only identifiers with no graph stub; manual chapters are now mintable and extractable. URI convention gemi:pub<pub#>_ch<chapter#>." ;
    gem:llmDetailedDefinition """A chapter of a CMS program manual (e.g. Pub.100-02 Medicare Benefit Policy Manual, Pub.100-04 Medicare Claims Processing Manual) cited as a governing cross-reference. Note the deliberate naming exception: unlike its sibling document classes it does NOT take a '...Policy' suffix, signalling that it is a governing reference document rather than a coverage-determination document. URI pattern gemi:pub<pub#>_ch<chapter#>.""" ;
    gem:llmScopingNote """A manual-chapter node participates in gem:referencesPolicy linking and the stub/extraction workflow but is not itself a coverage-determination document; treat it as a reference target, not a source of covers/excludes rules unless it has been extracted.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:ChangeRequest a owl:Class ;
    rdfs:subClassOf gem:CMSpolicy ;
    gem:prefLabel "Change Request" ;
    gem:description "A 'Change Request' (CR) is a class of CMS Policy representing a numbered CMS Change Request -- the instruction work-item that mandates a coverage, operational, or system update and states the 'what' and 'why' that Medicare Administrative Contractors must execute. A CR is paired with a Transmittal, which is its delivery vehicle: each CR is assigned a Transmittal number on issuance, and the transmittal serves as the formal cover notice summarizing the manual updates and implementation dates. The CR detail may be carried within the transmittal itself or in a separate referenced file. Modeled as a gem:CMSpolicy subclass so the workflow-state machinery and policy-linking properties apply; a CR is minted as a stub at first citation by an extracted transmittal (via gem:transmitsChangeRequest or gem:referencesChangeRequest) with gem:nextPlannedStep gem:planPromote pending its own extraction. A transmitted CR's dc:source is the delivering transmittal's IRI. Sibling of gem:TransmittalPolicy and gem:ProgramMemorandumPolicy under gem:CMSpolicy. Introduced 2026-06-26 (Session 95)." ;
    gem:llmCardinalityNote """A single CR may be transmitted by more than one transmittal across a rescind-and-replace chain, so gem:changeRequestTransmittedBy on a CR can return multiple transmittals. Do not assume a one-to-one CR<->transmittal mapping.""" ;
    gem:llmDetailedDefinition """A numbered CMS Change Request (CR): the instruction work-item stating the 'what' and 'why' of a change that MACs must execute. Paired with a transmittal, its delivery vehicle. Distinguish the two link kinds: a transmittal TRANSMITS a CR (gem:transmitsChangeRequest, inverse gem:changeRequestTransmittedBy) when it delivers it; a policy merely REFERENCES a CR (gem:referencesChangeRequest) when it only cites it.""" ;
    gem:llmScopingNote """CR nodes are stubs (gem:planPromote) with no extracted rule content of their own; the operative coverage text lives on the delivering transmittal or the affected policy, not on the CR.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:NextPlannedStep a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    gem:prefLabel "Next Planned Step" ;
    gem:description "A 'Next Planned Step' is one of the named workflow states a CMS policy document may carry on its gem:nextPlannedStep predicate, indicating what kind of work is planned next for that document. Vocabulary is controlled but evolves over time; current values are gem:planPromote (default for newly-minted stubs awaiting full extraction), gem:planNone (no further work intended; user-requested only), gem:planDone (fully extracted, no further work expected), and gem:planRevisit (re-examine and verify existing facts). Orthogonal to gem:isInEffect (which records whether the document is still carried by its publisher). Introduced 2026-06-08 (Session 45)." ;
    gem:llmEnumeratedValues """Controlled vocabulary of workflow-state individuals carried on gem:nextPlannedStep. gem:planPromote = a stub awaiting full extraction (default for newly-minted stubs; its coverage content is NOT yet in the graph). gem:planDone = fully extracted, no further work expected. gem:planNone = no further work is intended on this document; the value states intent only, and no other meaning may be inferred from it. gem:planRevisit = flagged by user request for re-examination/verification regardless of past completeness.""" ;
    gem:llmScopingNote """Workflow bookkeeping, orthogonal to gem:isInEffect (publication status). Its main value to a reader is calibration: a node at gem:planPromote is a placeholder, so treat missing rules/codes under it as 'not yet extracted', never as 'none exist'.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:nextPlannedStep a owl:ObjectProperty ;
    gem:prefLabel "Next Planned Step" ;
    gem:description "A 'Next Planned Step' is an object property that links a CMS policy to a named value of gem:NextPlannedStep, indicating what kind of work is planned next for the policy. Default for newly-minted stubs is gem:planPromote; default for a document deleted from its manual (URI suffix _DELETED) is gem:planNone; default for fully-extracted policies is gem:planDone. Every other use of gem:planNone is set by user request, not by a default rule. The value gem:planRevisit is set by user request when an existing policy is queued for re-examination regardless of past completeness. Introduced 2026-06-08 (Session 45)." ;
    gem:llmCardinalityNote """Exactly one value per policy document (functional in practice).""" ;
    gem:llmEnumeratedValues """Range is gem:NextPlannedStep, a controlled vocabulary: gem:planPromote (stub awaiting full extraction; coverage content not yet in graph), gem:planDone (fully extracted), gem:planNone (no further work intended; states intent only, nothing else may be inferred), gem:planRevisit (user-flagged for re-examination). Per-value definitions also live on gem:NextPlannedStep.""" ;
    gem:llmScopingNote """Workflow state, orthogonal to gem:isInEffect (publication status). Key reading calibration: gem:planPromote means the document is a stub whose coverage content is not yet extracted, so do not infer coverage from the absence of rules under it.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:NextPlannedStep ;
    gem:memberOfOntology gem:gemOntology .

gem:isInEffect a owl:DatatypeProperty ;
    gem:prefLabel "Is In Effect" ;
    gem:description "An 'Is In Effect' flag is a boolean datatype property recording whether a CMS policy document is still carried by its publisher as an operative document. It is true while the publisher carries it, and false only where GEM has knowledge that the publisher has removed it -- a manual section deleted from the manual it was published in, or a published document withdrawn. Three things it does not record. (1) Retirement in place: a section that survives its own coverage determination -- retitled RETIRED and left in the manual, its live text stating that no national coverage determination is appropriate and that the Medicare Administrative Contractors decide -- is still in the manual and is therefore true. (2) Rescission or supersession: a rescinded transmittal, a superseded delivery and a superseded National Coverage Analysis all remain published, and each still governs or explains claims dated before the change, so each is true. (3) Version currentness: whether an individual describes the version presently in force is a separate question on a separate subject, and is not asked here. Absence of knowledge is not removal -- a document GEM has not yet read is true by default. Introduced 2026-06-08 (Session 45) as a rename of the worklist's is_current field, which is where two questions were merged into one predicate; redefined 2026-07-17 (Session 159) to the publication-status question alone." ;
    gem:llmCardinalityNote """One boolean per policy document, asserted on every gem:CMSpolicy. It is a fact about the document itself and never about a document it revises or delivers: a transmittal that revises twenty policies carries one value, and that value is the transmittal's own publication status, not any target's.""" ;
    gem:llmDetailedDefinition """Boolean publication-status flag: true = the document is still carried by its publisher; false = GEM knows the publisher has removed it (a manual section deleted, a document withdrawn). Retirement in place, rescission and supersession do not make it false. It does not record version currentness, and it does not answer whether a policy governs a given claim.""" ;
    gem:llmScopingNote """Records publication status only. It says nothing about whether extraction work remains (gem:nextPlannedStep), whether the source rendition is obtainable (gem:sourceAvailability), or which version is current. Critically it does not answer whether a policy applies to a claim: applicability is a relation between a policy version and a date of service, and this property carries neither -- an isInEffect=false document may still govern claims dated before its removal, and an isInEffect=true document's live text may be the wrong text for a claim dated before its current version took effect.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range xsd:boolean ;
    gem:memberOfOntology gem:gemOntology .
# -----------------------------------------------------------------------------
#    Next-Planned-Step Vocabulary (Named Individuals)
# -----------------------------------------------------------------------------

gem:planPromote a gem:NextPlannedStep ;
    gem:prefLabel "Promote" ;
    gem:description "The 'Promote' next-planned-step value means the policy stub is queued for advancement to full extraction. Default value for any newly-minted stub of a coverage-document type (NCD, LCD, Article, Transmittal, Program Memorandum, or NCA) until the extraction process is complete." ;
    gem:llmDetailedDefinition "a stub awaiting full extraction (default for newly-minted stubs; its coverage content is NOT yet in the graph)." ;
    gem:memberOfOntology gem:gemOntology .

gem:planNone a gem:NextPlannedStep ;
    gem:prefLabel "None" ;
    gem:description "The 'None' next-planned-step value means no further work is intended on the policy document. It states intent and nothing else: no other meaning may be inferred from it. In particular it does not say that the document has been deleted, that it is out of effect (gem:isInEffect), that its content has been superseded, or that its source is unobtainable (gem:sourceAvailability) -- those are separate facts on separate predicates, and any of them may hold or not hold alongside this value. Many different roads reach it: a document deleted from its manual, a document whose whole contribution is already in the graph via the policies that cite it, a document of which no rendition exists. The value records none of them; where the reason matters it lives in the document's gem:description. Set explicitly by user request. Distinct from gem:planDone, which marks a normal completion. Narrowed 2026-07-17 (Session 159): the prior wording enumerated 'retiree-class stubs: _DELETED URIs, historical/superseded versions, retired-incorporated policies' as though those categories were part of its meaning, which invited the inference this definition now forbids." ;
    gem:llmDetailedDefinition "no further work is intended on this document; the value states intent only, and no other meaning may be inferred from it." ;
    gem:memberOfOntology gem:gemOntology .
gem:planDone a gem:NextPlannedStep ;
    gem:prefLabel "Done" ;
    gem:description "The 'Done' next-planned-step value means the policy has been fully extracted and no further work is expected. Default value for any policy whose extraction has completed via the normal two-turn workflow. A planDone policy can be transitioned to gem:planRevisit by user request when re-examination is desired." ;
    gem:llmDetailedDefinition "fully extracted, no further work expected." ;
    gem:memberOfOntology gem:gemOntology .

gem:planRevisit a gem:NextPlannedStep ;
    gem:prefLabel "Revisit" ;
    gem:description "The 'Revisit' next-planned-step value means the policy is queued for re-examination and verification of existing facts, regardless of past completeness state. Similar in workflow intent to gem:planPromote but distinct in semantics: planPromote extracts from a stub; planRevisit re-verifies an existing extraction. Set by user request; returns to gem:planDone (or gem:planNone) when re-examination completes." ;
    gem:llmDetailedDefinition "flagged by user request for re-examination/verification regardless of past completeness." ;
    gem:memberOfOntology gem:gemOntology .

gem:SourceAvailability a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    gem:prefLabel "Source Availability" ;
    gem:description "A 'Source Availability' is one of the named values a CMS policy document may carry on its gem:sourceAvailability predicate, recording the obtainability of the document's own source rendition -- a fact about GEM's access to the artifact, not about the document's coverage disposition. Introduced 2026-07-17 (Session 156) for the pre-2000 Coverage Issues Manual transmittals, which CMS never published electronically: CMS's public transmittal archive begins at 2000, so no rendition exists to fetch. Vocabulary is controlled but evolves over time; the current value is gem:sourceUnobtainable. Deliberately narrow: the property asserts unobtainability only, and the absence of a gem:sourceAvailability triple asserts nothing -- a document with no dc:source and no gem:sourceAvailability has not been checked, which is what makes the unverified set derivable from the graph rather than a maintained roster. Orthogonal to gem:nextPlannedStep (what work is planned next) and to gem:isInEffect (whether the policy is in effect): gemi:tn78CIM is in effect, has no further work planned, and is unobtainable, and the three facts are independent of one another." ;
    gem:llmEnumeratedValues """Controlled vocabulary of source-obtainability individuals carried on gem:sourceAvailability. gem:sourceUnobtainable = the document's source rendition does not exist in any fetchable form and none is expected (paper-only CMS documents predating CMS's electronic transmittal archive).""" ;
    gem:llmScopingNote """Access bookkeeping, orthogonal to gem:isInEffect (coverage currentness) and gem:nextPlannedStep (work state). Its value to a reader is calibration: a node at gem:sourceUnobtainable already carries everything GEM will ever hold about that document, so treat missing rules under it as 'none obtainable', never as 'not yet extracted' -- the inverse of the gem:planPromote reading. Absence of the property is not a claim of availability; it means unchecked.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:sourceAvailability a owl:ObjectProperty ;
    gem:prefLabel "Source Availability" ;
    gem:description "A 'Source Availability' is an object property that links a CMS policy to a named value of gem:SourceAvailability, recording the obtainability of the document's own source rendition. Asserted only where obtainability has been determined; absent by default, and its absence is not a claim either way. Distinct from dc:source, which carries the rendition's location when one exists -- the two are complementary: a document may carry dc:source (a rendition exists and is recorded), or gem:sourceUnobtainable and no dc:source (checked; no rendition exists), or neither (not yet checked). Introduced 2026-07-17 (Session 156)." ;
    gem:llmCardinalityNote """At most one value per policy document, and absent on most documents, which asserts nothing about them.""" ;
    gem:llmEnumeratedValues """Range is gem:SourceAvailability, a controlled vocabulary whose current single value is gem:sourceUnobtainable (the document's source rendition does not exist in any fetchable form and none is expected (paper-only CMS documents predating CMS's electronic transmittal archive)). Per-value definitions also live on gem:SourceAvailability.""" ;
    gem:llmScopingNote """Records access to the source artifact only; it says nothing about coverage currentness (gem:isInEffect) or work state (gem:nextPlannedStep). Absence means unchecked, not available.""" ;
    rdfs:domain gem:CMSpolicy ;
    rdfs:range gem:SourceAvailability ;
    gem:memberOfOntology gem:gemOntology .

# -----------------------------------------------------------------------------
#    Source-Availability Vocabulary (Named Individuals)
# -----------------------------------------------------------------------------

gem:sourceUnobtainable a gem:SourceAvailability ;
    gem:prefLabel "Unobtainable" ;
    gem:description "The 'Unobtainable' source-availability value means the document's source rendition does not exist in any fetchable form and none is expected. Set explicitly by user request. The established case is the pre-2000 Coverage Issues Manual transmittals: CMS's public transmittal archive begins at 2000, so a CIM transmittal issued before then was paper-only and was never digitized (Tom, S148 / S149 / S156). An unobtainable document is not thereby retired, superseded or out of effect -- gemi:tn78CIM established the current text of NCD 160.7 and carries gem:isInEffect true. It pairs with gem:planNone, and the pairing is the point of the split between them: gem:planNone says only that no further work is intended, and gem:sourceUnobtainable says why -- no further work is possible, and everything the document can contribute to the graph is already there, contributed by the policies that cite it." ;
    gem:llmDetailedDefinition "the document's source rendition does not exist in any fetchable form and none is expected (paper-only CMS documents predating CMS's electronic transmittal archive)." ;
    gem:memberOfOntology gem:gemOntology .
# -----------------------------------------------------------------------------
#    Coverage Qualifier Vocabulary (Named Individuals)
# -----------------------------------------------------------------------------

gem:restrictionType_useCase a gem:RestrictionType ;
    gem:prefLabel "Use Case" ;
    gem:description "The 'Use Case' restriction-type value tags a gem:CoverageRestriction that narrows the clinical context or use case for which coverage applies -- e.g., NCD 240.2's 'coverage is provided only for use of oxygen during sleep'. The restricted use case is typically named via gem:restrictionConcept (a gem:ClinicalConcept individual representing the context, such as gemi:contextDuringSleep)." ;
    gem:llmDetailedDefinition "narrows the clinical context or use case (e.g. NCD 240.2 'oxygen during sleep only')." ;
    gem:memberOfOntology gem:gemOntology .

gem:restrictionType_count a gem:RestrictionType ;
    gem:prefLabel "Count" ;
    gem:description "The 'Count' restriction-type value tags a gem:CoverageRestriction that narrows the cardinality of what is covered -- e.g., NCD 240.2's 'only one type of unit will be covered'. The numeric count lives inside gem:restrictionDescription until the gem:restrictionValue property is codified (deferred at S69 Phase 3a)." ;
    gem:llmDetailedDefinition "narrows the cardinality (e.g. 'only one type of unit will be covered')." ;
    gem:memberOfOntology gem:gemOntology .

gem:restrictionType_duration a gem:RestrictionType ;
    gem:prefLabel "Duration" ;
    gem:description "The 'Duration' restriction-type value tags a gem:CoverageRestriction that narrows the time span over which coverage applies -- e.g., NCD 240.2's 'Initial coverage for patients with other conditions may be limited to the shorter of 90 days or the number of days included in the practitioner prescription'. The duration value lives inside gem:restrictionDescription until the gem:restrictionValue property is codified (deferred at S69 Phase 3a)." ;
    gem:llmDetailedDefinition "narrows the time span (e.g. a '90 days' initial-coverage limit)." ;
    gem:memberOfOntology gem:gemOntology .

gem:restrictionType_frequency a gem:RestrictionType ;
    gem:prefLabel "Frequency" ;
    gem:description "The 'Frequency' restriction-type value tags a gem:CoverageRestriction that narrows how often the covered item may be claimed (e.g., 'covered no more than once per twelve months'). The frequency value lives inside gem:restrictionDescription until the gem:restrictionValue property is codified (deferred at S69 Phase 3a). Distinct from gem:ruleType_frequency (codified at sub-cycle (b) of work item #72) -- that names a kind of rule (a rule whose subject matter is frequency criteria); this names a kind of restriction (a restriction that narrows frequency)." ;
    gem:llmDetailedDefinition "narrows how often the covered item may be claimed." ;
    gem:memberOfOntology gem:gemOntology .

# -----------------------------------------------------------------------------
#    Rule Categorization Vocabulary (Named Individuals)
# -----------------------------------------------------------------------------

gem:ruleDomain_screening a gem:RuleDomain ;
    gem:prefLabel "Screening" ;
    gem:description "The 'Screening' rule-domain value tags a gem:PolicyRule that applies to laboratory screening services only -- for example, in NCD 210.10 (which covers both STI laboratory screening and High Intensity Behavioral Counseling), rules that govern only the laboratory-screening leg carry this domain tag." ;
    gem:llmDetailedDefinition "rule applies to laboratory screening only (e.g. NCD 210.10 STI screening leg)." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleDomain_hibc a gem:RuleDomain ;
    gem:prefLabel "HIBC" ;
    gem:description "The 'HIBC' rule-domain value tags a gem:PolicyRule that applies to High Intensity Behavioral Counseling services only -- for example, in NCD 210.10, rules that govern only the HIBC leg carry this domain tag. The acronym is preserved as the URI local-name suffix for fidelity to the source-policy terminology." ;
    gem:llmDetailedDefinition "rule applies to High Intensity Behavioral Counseling only (e.g. NCD 210.10 HIBC leg)." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleDomain_crossCutting a gem:RuleDomain ;
    gem:prefLabel "Cross-Cutting" ;
    gem:description "The 'Cross-Cutting' rule-domain value tags a gem:PolicyRule that applies to both or either of the services within a multi-domain policy. Used when the source's framing is activity-agnostic (e.g., an eligibility rule in NCD 210.10 that applies to anyone qualifying for either screening or HIBC)." ;
    gem:llmDetailedDefinition "rule applies to both/either service within a multi-domain policy." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_coverageScope a gem:RuleType ;
    gem:prefLabel "Coverage Scope" ;
    gem:description "The 'Coverage Scope' rule-type value tags a gem:PolicyRule that specifies what is covered, at what level. The most common rule type for the THEN-clause of a positive-coverage rule." ;
    gem:llmDetailedDefinition "what is covered, at what level." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_eligibility a gem:RuleType ;
    gem:prefLabel "Eligibility" ;
    gem:description "The 'Eligibility' rule-type value tags a gem:PolicyRule that specifies who is eligible for coverage or when eligibility applies (e.g., age, sex/gender, beneficiary status, diagnosis-based eligibility, calendar windows)." ;
    gem:llmDetailedDefinition "who/when is eligible." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_frequency a gem:RuleType ;
    gem:prefLabel "Frequency" ;
    gem:description "The 'Frequency' rule-type value tags a gem:PolicyRule that specifies how often a covered service may be claimed -- repeat-screening intervals, lifetime limits, per-year counts. Distinct from gem:restrictionType_frequency: this names a kind of rule (whose subject matter is frequency criteria); the restriction-type counterpart names a kind of restriction (which narrows frequency)." ;
    gem:llmDetailedDefinition "how often / repeat-screening intervals." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_settingDefinition a gem:RuleType ;
    gem:prefLabel "Setting Definition" ;
    gem:description "The 'Setting Definition' rule-type value tags a gem:PolicyRule that specifies what setting is required for coverage. Covers both positive definitions (e.g., 'primary care setting') and exclusions (e.g., 'not inpatient setting')." ;
    gem:llmDetailedDefinition "what setting is required (positive definition + exclusions)." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_credentialedActor a gem:RuleType ;
    gem:prefLabel "Credentialed Actor" ;
    gem:description "The 'Credentialed Actor' rule-type value tags a gem:PolicyRule that specifies who can order, perform, or provide a covered service. Distinct from gem:ruleType_settingDefinition (which specifies where the service occurs)." ;
    gem:llmDetailedDefinition "who can order/perform/provide." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_serviceDefinition a gem:RuleType ;
    gem:prefLabel "Service Definition" ;
    gem:description "The 'Service Definition' rule-type value tags a gem:PolicyRule that defines a service itself -- what the service is, what activities it comprises, what outcomes it produces. Distinct from gem:ruleType_serviceStandard (which constrains how the service must be performed)." ;
    gem:llmDetailedDefinition "defines a service itself." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_serviceStandard a gem:RuleType ;
    gem:prefLabel "Service Standard" ;
    gem:description "The 'Service Standard' rule-type value tags a gem:PolicyRule that specifies technical standards a service must meet -- regulatory approvals (FDA), laboratory certifications (CLIA), accreditation requirements (e.g., ACR for imaging). Distinct from gem:ruleType_serviceDefinition (which defines what the service is)." ;
    gem:llmDetailedDefinition "technical standards (FDA, CLIA, etc.)." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_riskFactor a gem:RuleType ;
    gem:prefLabel "Risk Factor" ;
    gem:description "The 'Risk Factor' rule-type value tags a gem:PolicyRule that enumerates risk factors relevant to coverage (e.g., the list of behavioral risk factors that qualify a beneficiary for STI laboratory screening under NCD 210.10). Distinct from gem:ruleType_riskDetermination (which specifies how risk is assessed)." ;
    gem:llmDetailedDefinition "enumerates risk factors." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_riskDetermination a gem:RuleType ;
    gem:prefLabel "Risk Determination" ;
    gem:description "The 'Risk Determination' rule-type value tags a gem:PolicyRule that specifies who determines a beneficiary's risk status and how that determination is made (e.g., 'a primary care physician evaluates patient risk based on history and behavioral risk factors'). Distinct from gem:ruleType_riskFactor (which enumerates the risk factors themselves)." ;
    gem:llmDetailedDefinition "who/how determines risk." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_documentation a gem:RuleType ;
    gem:prefLabel "Documentation" ;
    gem:description "The 'Documentation' rule-type value tags a gem:PolicyRule that specifies what documentation is required for a covered service -- chart-note requirements, prescription/order requirements, signature requirements, time-recording rules." ;
    gem:llmDetailedDefinition "documentation requirements." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_nonCoverage a gem:RuleType ;
    gem:prefLabel "Non-Coverage" ;
    gem:description "The 'Non-Coverage' rule-type value tags a gem:PolicyRule that specifies what is NOT covered -- explicit exclusions from coverage rather than narrowing of coverage. Distinct from gem:CoverageRestriction (which qualifies an otherwise-positive coverage outcome): this rule-type tags policy-level non-coverage statements that stand on their own as the rule's content, not qualifiers attached to a positive outcome." ;
    gem:llmDetailedDefinition "what is NOT covered." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_costSharing a gem:RuleType ;
    gem:prefLabel "Cost Sharing" ;
    gem:description "The 'Cost Sharing' rule-type value tags a gem:PolicyRule that specifies patient cost obligations -- deductibles, copays, coinsurance waivers (e.g., preventive-service cost-sharing waivers under USPSTF Grade A/B services)." ;
    gem:llmDetailedDefinition "patient cost obligations." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_concurrentServices a gem:RuleType ;
    gem:prefLabel "Concurrent Services" ;
    gem:description "The 'Concurrent Services' rule-type value tags a gem:PolicyRule that specifies which services can be billed on the same date or together as part of a single service event (or, conversely, which combinations are mutually exclusive)." ;
    gem:llmDetailedDefinition "what services can be billed on the same date / together." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_statutoryFraming a gem:RuleType ;
    gem:prefLabel "Statutory Framing" ;
    gem:description "The 'Statutory Framing' rule-type value tags a gem:PolicyRule that grounds coverage in a scope-defining reference to statute (e.g., 'this benefit is authorized under §1861(s)(2)(P) of the Social Security Act'). Provides the legal anchor for the policy's coverage authority." ;
    gem:llmDetailedDefinition "scope-defining reference to statute." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_studyDesign a gem:RuleType ;
    gem:prefLabel "Study Design" ;
    gem:description "The 'Study Design' rule-type value tags a gem:PolicyRule that governs the content, structure, or analytical plan a study must follow -- e.g., a research-question requirement, a trial-design specification (double-blind, randomized, placebo-controlled), a separate-analysis requirement for a beneficiary subpopulation, or a post-trial obligation such as offering active treatment to the placebo arm at trial end. Used in policies that require a Coverage with Evidence Development (CED) study or other prospective trial as a condition of coverage. Distinct from gem:ruleType_studyQuality (which tags methodological-integrity standards rather than design content) and gem:ruleType_outcomeMeasure (which tags the definition of how an outcome is measured)." ;
    gem:llmDetailedDefinition "content, structure, or analytical plan a study must follow." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_studyQuality a gem:RuleType ;
    gem:prefLabel "Study Quality" ;
    gem:description "The 'Study Quality' rule-type value tags a gem:PolicyRule that governs the methodological integrity of a study -- e.g., one of the CMS Coverage with Evidence Development (CED) Standards of Scientific Integrity covering study purpose, evidence support, design appropriateness, sponsor competence, regulatory compliance, written protocol, exclusionary toxicity-test framing, registration, public release, subpopulation discussion, or generalizability discussion. Used when a policy specifies methodological criteria a study must satisfy to be approved for CED coverage. Distinct from gem:ruleType_studyDesign (which tags the substantive content and analytical plan of the study rather than its methodological-integrity standards)." ;
    gem:llmDetailedDefinition "methodological integrity of a study (e.g. CMS Coverage with Evidence Development)." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_outcomeMeasure a gem:RuleType ;
    gem:prefLabel "Outcome Measure" ;
    gem:description "The 'Outcome Measure' rule-type value tags a gem:PolicyRule that defines how a study measures or characterizes an outcome -- e.g., a definition of clinical response in operational terms (a percentage improvement on a named assessment tool), a definition of remission, or a research question framed in measurable terms. Used in CED-bearing policies where outcome definitions are specified as part of the coverage policy itself rather than left to the trial protocol. Frequently co-occurs with gem:ruleType_studyDesign on rules that simultaneously specify what is to be measured and how the trial must analyze it." ;
    gem:llmDetailedDefinition "how a study measures or characterizes an outcome." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_procedural a gem:RuleType ;
    gem:prefLabel "Procedural" ;
    gem:description "The 'Procedural' rule-type value tags a gem:PolicyRule that describes a program-administrative process distinct from the substantive claim-eligibility rules -- e.g., a federal agency's role in supporting CED studies (AHRQ), a principal investigator's protocol-submission process, or the CMS website publication of approved studies. Used for rules that describe how the policy's framework operates rather than what coverage criteria a claim must meet. The substance-versus-process distinction parallels in spirit the gem:ruleType_documentation tag for claim-filing requirements, but covers program-administrative content rather than per-claim documentation obligations." ;
    gem:llmDetailedDefinition "program-administrative process distinct from substantive claim-eligibility rules." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_definition a gem:RuleType ;
    gem:prefLabel "Definition" ;
    gem:description "The 'Definition' rule-type value is the generic catch-all for definitional rules not covered by the more-specific type categories (gem:ruleType_serviceDefinition, gem:ruleType_settingDefinition, gem:ruleType_coverageScope, etc.). Used when a rule defines a term, concept, or boundary that doesn't fit any of the established categories. New specific categories may be promoted from this catch-all when a pattern of related uses emerges." ;
    gem:llmDetailedDefinition "generic catch-all for definitional rules not covered above." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_paymentRule a gem:RuleType ;
    gem:prefLabel "Payment Rule" ;
    gem:description "The 'Payment Rule' rule-type value tags a gem:PolicyRule that governs whether, how much, or how often Medicare pays for a covered item or service -- separate-payment eligibility, payment frequency and timing, and fee structure. Distinct from gem:ruleType_nonCoverage (item not covered at all) and gem:ruleType_concurrentServices (which services may be billed together). Introduced 2026-06-25 (Session 90) at A52466 dispensing-fee rules." ;
    gem:llmDetailedDefinition "whether/how much/how often Medicare pays for a covered item." ;
    gem:memberOfOntology gem:gemOntology .

gem:ruleType_codingCorrectness a gem:RuleType ;
    gem:prefLabel "Coding Correctness" ;
    gem:description "The 'Coding Correctness' rule-type value tags a gem:PolicyRule that directs how a claim must be coded for a covered item or service -- required or prohibited codes and modifiers, code-selection and units-of-service rules, and the incorrect-coding denials they trigger. Distinct from gem:ruleType_nonCoverage (item not covered at all) and gem:ruleType_documentation (records that must be kept). Introduced 2026-06-25 (Session 90) at A52466 modifier and coding-guideline rules." ;
    gem:llmDetailedDefinition "how a claim must be coded (required/prohibited codes and modifiers, code-selection and units rules, incorrect-coding denials)." ;
    gem:memberOfOntology gem:gemOntology .

# ============================================================================
# Integrating the ICD-10-CM hierarchy into the ontology 
# ============================================================================
#
#  ICD-10-CM is the standardized system used to record medical diagnoses on 
#  claims and health records.  Its codes are organized like a family tree, 
#  moving from broad groupings down to highly specific diagnoses.
#
#  At the top are chapters, each covering a broad area of medicine — for 
#  example, diseases of the respiratory system.  Within a chapter are blocks,
#  which gather related conditions into smaller ranges, such as chronic lower
#  respiratory diseases. Inside each block are categories, three-character 
#  codes naming a general condition, such as 'chronic obstructive pulmonary
#  disease.'  Finally, categories branch into specific codes of up to seven
#  characters that capture precise detail — the type of flare-up, whether an
#  infection is present, or how advanced the condition is.
#
#  For example: the chapter for respiratory diseases contains a block for 
#  chronic lower respiratory diseases, which contains the category for COPD,
#  which contains individual codes for COPD with an acute exacerbation versus
#  COPD with a lower respiratory infection.
#
#  This structure matters because home oxygen coverage often depends on the
#  diagnosis.  When evaluating a claim, you may need to consider not just the
#  exact code, but also its parent category, sibling codes for related 
#  respiratory conditions, and more detailed child codes beneath it.
#
# Hierarchy navigation
#
#  SPARQL query fragments (where ?c is the current diagnosis code):
#   direct parent       ?c skos:broader ?parent
#   all ancestors       ?c skos:broaderTransitive ?ancestor
#   direct children     ?child skos:broader ?c
#   all descendants     ?descendant skos:broaderTransitive ?c
#   siblings (all children of my parent except me)
#                       ?c skos:broader ?p .      Find diagnosis parent
#                       ?sib skos:broader ?p .    Find parent's children
#                       FILTER(?sib != ?c)        Filter out current diagnosis
#
#  To query the entire family of diagnosis codes (ancestors, descendants, and 
#  siblings), the following query will return that result, as well as the 
#  relationship that the family member has to the provided diagnosis code:
#
#  
#  PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
#  PREFIX gem:  <http://www.cms.hhs.gov/ontology/2026/08/GEM/>
#  PREFIX icd:  <http://purl.bioontology.org/ontology/ICD10CM/>
#  
#  SELECT DISTINCT ?concept ?relation WHERE {
#      VALUES ?focus { icd:J44.1 }          # <-- parameter: the starting diagnosis code
#  
#      {
#          BIND(?focus AS ?concept)
#          BIND("self" AS ?relation)
#      } UNION {
#          ?focus skos:broaderTransitive ?concept .
#          BIND("ancestor" AS ?relation)
#      } UNION {
#          ?focus skos:narrowerTransitive ?concept .
#          BIND("descendant" AS ?relation)
#      } UNION {
#          ?focus skos:broader ?p .
#          ?concept skos:broader ?p .
#          FILTER(?concept != ?focus)
#          BIND("sibling" AS ?relation)
#      }
#  
#      ?concept a gem:ICDdiagnosis .         # <-- keeps only real codes; drops blocks / chapter-ranges
#  }
#  
#  Drop ?relation and its BIND lines if you want the bare code set only.
#
#

# -----------------------------------------------------------------------------
#    Class Definitions
# -----------------------------------------------------------------------------
gem:ICDconcept a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    gem:prefLabel "ICD-10-CM Concept" ;
    gem:description "An 'ICD-10-CM Concept' is a class referring to any node in the ICD-10-CM hierarchy: a diagnosis code or a code grouping. Common superclass of gem:ICDdiagnosis and gem:ICDgrouping." ;
    gem:llmDetailedDefinition """Common superclass over gem:ICDdiagnosis (actual diagnosis codes) and gem:ICDgrouping (ICD-10 block/chapter ranges). Use the subclass, not this parent, to tell a billable diagnosis from a range.""" ;
    gem:llmScopingNote """Query the specific subclass. Only gem:ICDdiagnosis members are valid diagnosis objects (of gem:hasICDdiagnosis and the condition-polarity predicates); gem:ICDgrouping ranges are for hierarchy/expansion, not direct diagnosis assertions.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:ICDdiagnosis a owl:Class ;
    rdfs:subClassOf gem:ICDconcept ;
    gem:prefLabel "ICD-10-CM Diagnosis Code" ;
    gem:description "An 'ICD-10-CM Diagnosis Code' is a class of ICD-10-CM diagnostic codes: a three-character category or a longer (4 to 7 character) code. IRI local name has the form <letter><digit><alphanumeric>(.<1 to 4 alphanumerics>)?. ONLY members of this class are valid objects of gem:hasICDdiagnosis. Members are queried with '?x a gem:ICDdiagnosis'." ;
    gem:llmDetailedDefinition """An actual ICD-10-CM diagnosis code (a 3-character category or a 4-7 character code; IRI local name of the form <letter><digit><alnum>(.<1-4 alnum>)?). This is the ONLY valid object of gem:hasICDdiagnosis and the range of every condition-polarity predicate (gem:coversCondition / gem:excludesCondition / gem:exclusivelyCovers*Condition).""" ;
    gem:llmScopingNote """Members are typed OUTSIDE the canonical GEM files -- icd10: individuals acquire their rdf:type from the BioPortal ICD-10-CM conversion query -- so parsing the GEM files on their own yields zero individuals of this class while the loaded triplestore is fully populated. The llmTraversalHint below describes that loaded graph, not the .ttl files. Policies reference these codes in object position throughout the instances file either way, so a zero individual count in a file-level census is expected and is not evidence the class is unused.""" ;
    gem:llmTraversalHint """Enumerate all diagnosis codes with `?x a gem:ICDdiagnosis` -- the type is materialized on every code, so no reasoner is needed.""" ;
    gem:isaPrimaryClass true ;
    gem:memberOfOntology gem:gemOntology .

gem:ICDgrouping a owl:Class ;
    rdfs:subClassOf gem:ICDconcept ;
    gem:prefLabel "ICD-10-CM Code Grouping" ;
    gem:description "An 'ICD-10-CM Code Grouping' is a class of ICD-10-CM blocks or chapter-ranges -- a grouping of codes named by a hyphenated code pair, e.g. A00-A09 (block) or A00-B99 (chapter-range). Used for hierarchy navigation and diagnosis expansion. NOT a valid object of gem:hasICDdiagnosis." ;
    gem:llmScopingNote """ICD-10 block/chapter RANGES named by a hyphenated code pair (e.g. A00-A09 block, A00-B99 chapter-range), used for hierarchy navigation and diagnosis expansion. NOT a valid diagnosis object -- it is not accepted by gem:hasICDdiagnosis or the condition-polarity predicates, so never treat a grouping as a coded condition. Distinct from gem:CodeGroup (a curated cross-policy set, not an ICD-native range).""" ;
    gem:memberOfOntology gem:gemOntology .

# -----------------------------------------------------------------------------
#    SHACL Node Shape Definitions
# -----------------------------------------------------------------------------
gem:ICDdiagnosisShape a sh:NodeShape ;
    gem:prefLabel "ICDdiagnosis IRI shape" ;
    gem:description "IRI pattern for diagnosis codes" ;
    sh:targetClass gem:ICDdiagnosis ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?$" ;
    sh:message "An ICDdiagnosis must be an IRI in the ICD10CM namespace with local name <letter><digit><alphanumeric>(.<1 to 4 alphanumerics>)?." ;
    gem:memberOfOntology gem:gemOntology .

gem:ICDgroupingShape a sh:NodeShape ;
    gem:prefLabel "ICDgrouping IRI shape" ;
    gem:description "IRI pattern for blocks / chapter-ranges" ;
    sh:targetClass gem:ICDgrouping ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9]-[A-Za-z][0-9][A-Za-z0-9]$" ;
    sh:message "An ICDgrouping must be an IRI in the ICD10CM namespace with local name <code>-<code> (a hyphenated code pair)." ;
    gem:memberOfOntology gem:gemOntology .

gem:BaseServiceLineShape a sh:NodeShape ;
    gem:prefLabel "Base Service Line shape" ;
    gem:description "BaseServiceLine.hasICDdiagnosis values must be ICDdiagnosis" ;
    sh:targetClass  gem:BaseServiceLine ;
    sh:property [
        sh:path     gem:hasICDdiagnosis ;
        sh:class    gem:ICDdiagnosis ;
        sh:nodeKind sh:IRI ;
        sh:message  "Every hasICDdiagnosis value on a Base Service Line must be a gem:ICDdiagnosis (a real code), not a gem:ICDgrouping." ;
    ] .

gem:PolicyRuleShape a sh:NodeShape ;
    gem:prefLabel "PolicyRule shape" ;
    gem:description "Per-individual structural contract for gem:PolicyRule instances minted under the Phase 3 / Phase 4 instance-promotion plan. Captures the static cardinality and value-class constraints; cross-cutting concerns (gem:ruleDescription domain conformance, bidirectional provenance reciprocity, smart-domain ruleDomain coverage) live in gem_audit.py rather than in this shape." ;
    sh:targetClass gem:PolicyRule ;
    sh:property [
        sh:path gem:ruleDescription ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "A gem:PolicyRule must carry exactly one gem:ruleDescription string literal." ;
    ] ;
    sh:property [
        sh:path dc:source ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class gem:CMSpolicy ;
        sh:nodeKind sh:IRI ;
        sh:message "A gem:PolicyRule must carry exactly one dc:source IRI pointing at a gem:CMSpolicy individual (the parent policy URI per Decision 5; not a URL)." ;
    ] ;
    sh:property [
        sh:path gem:memberOfOntology ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A gem:PolicyRule must carry gem:memberOfOntology." ;
    ] ;
    sh:property [
        sh:path gem:ruleDomain ;
        sh:class gem:RuleDomain ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:ruleDomain value on a gem:PolicyRule must be a gem:RuleDomain individual (e.g., gem:ruleDomain_screening). Cardinality is intentionally unconstrained: single-domain policies legitimately omit this triple per the ontology's documented gem:ruleDomain semantics." ;
    ] ;
    sh:property [
        sh:path gem:ruleType ;
        sh:class gem:RuleType ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:ruleType value on a gem:PolicyRule must be a gem:RuleType individual (e.g., gem:ruleType_eligibility)." ;
    ] ;
    sh:property [
        sh:path gem:delegatesCoverageTo ;
        sh:class gem:ProviderCredential ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:delegatesCoverageTo value on a gem:PolicyRule must be a gem:ProviderCredential individual (the Medicare contractor authority the coverage determination is delegated to; contractor/MAC discretion). Cardinality intentionally unconstrained (0..N)." ;
    ] ;
    gem:memberOfOntology gem:gemOntology .

gem:CMSpolicyShape a sh:NodeShape ;
    gem:prefLabel "CMSpolicy shape" ;
    gem:description "Per-individual structural contract for gem:CMSpolicy instances and their subclasses (gem:NCDpolicy, gem:LCDpolicy, gem:ArticlePolicy, gem:TransmittalPolicy, gem:NCAdocument, gem:ProgramMemorandumPolicy). Enforces value-class constraints on predicates the GEM extraction methodology asserts on policy subjects, following the deferred_proposals[75] pattern (sh:targetClass on the subject-class shape, with sh:property blocks per predicate). Two value-class enforcement strategies are used by predicate-range kind: (1) in-namespace gem: ranges (gem:ProviderCredential, gem:ClinicalConcept, gem:BenefitCategory, gem:CMSpolicy, gem:PolicyRule, gem:PolicyGroup, gem:PolicyCodingRule, gem:AnchoredCodingScope, gem:NextPlannedStep, gem:QualificationGroup) use sh:class because their typing triples live in GEM_ontology.ttl, visible to the merged data+ontology validation graph; (2) externally-populated code-namespace ranges (gem:ICDdiagnosis, gem:HCPCSprocedure, gem:HCPCSmodifier) use sh:nodeKind sh:IRI + sh:pattern matching the namespace URL form, because their typing triples are produced by gem_hcpcs_conversion.rq and equivalent ICD conversion queries against the BioPortal source ontologies and are not loaded into the audit-time validation graph. The IRI-pattern strategy mirrors the existing gem:HCPCSmodifierShape / gem:HCPCSprocedureShape / gem:ICDdiagnosisShape definitions for code-namespace validation. CPT (Level I) procedure codes are handled the same way: they live in the cpt: namespace (sourced from cpt.ttl), are typed gem:CPTprocedure -- a subclass of gem:HCPCSprocedure -- by gem_cpt_conversion.rq, and are likewise not loaded into the audit-time validation graph, so the procedure sh:pattern blocks admit the cpt: IRI form by alternation alongside the HCPCS Level II form (S88). Cardinality bounds are intentionally omitted from per-predicate blocks because the GEM extraction methodology operates at 0..N for nearly every policy predicate (an extracted policy may carry 0, 1, or many of any given relation depending on source-document content). gem:identifier is not represented because it is an umbrella property (rdfs:domain owl:Thing, assignable to any class) potentially serving as a parent for future more-specific identifier sub-properties that would carry their own SHACL constraints scoped to their narrower domains. gem:appliesWhenCode is not represented because it is an umbrella predicate (no declared range; sub-properties carry the substantive constraints). Cross-cutting concerns (worklist<->graph migration state, predicate-order conventions, bidirectional provenance audits) continue to live in gem_audit.py rather than this shape. Invocation requires the data_graph to include both GEM_policy_instances.ttl and GEM_ontology.ttl -- see gem_structured_rule_guide.md Architectural Implications, SHACL invocation pattern subsection." ;
    sh:targetClass gem:CMSpolicy ;
    sh:property [
        sh:path gem:coverageMechanismNote ;
        sh:datatype xsd:string ;
        sh:message "Every gem:coverageMechanismNote value on a gem:CMSpolicy must be a xsd:string literal." ;
    ] ;
    sh:property [
        sh:path gem:coversCondition ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?$" ;
        sh:message "Every gem:coversCondition value on a gem:CMSpolicy must be an IRI in the ICD-10-CM namespace (purl.bioontology.org/ontology/ICD10CM/) with a valid ICD-10 diagnosis code as the local name (three required leading characters in letter-digit-alphanumeric form, optionally followed by a dot and 1-4 additional alphanumeric characters)." ;
    ] ;
    sh:property [
        sh:path gem:coversProcedure ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^(http://purl\\.bioontology\\.org/ontology/HCPCS/[A-Z]\\d{4}|https://www\\.ama-assn\\.org/cpt#(\\d{5}|\\d{4}[FT]))$" ;
        sh:message "Every gem:coversProcedure value on a gem:CMSpolicy must be an IRI naming a procedure code in one of two namespaces: a HCPCS Level II code under the BioPortal HCPCS namespace (purl.bioontology.org/ontology/HCPCS/, local name one uppercase letter followed by four digits), or a CPT (Level I) code under the AMA CPT namespace (www.ama-assn.org/cpt#, local name a 5-digit Category I, 4-digit-plus-F Category II, or 4-digit-plus-T Category III code)." ;
    ] ;
    sh:property [
        sh:path gem:excludesCondition ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?$" ;
        sh:message "Every gem:excludesCondition value on a gem:CMSpolicy must be an IRI in the ICD-10-CM namespace (purl.bioontology.org/ontology/ICD10CM/) with a valid ICD-10 diagnosis code as the local name (three required leading characters in letter-digit-alphanumeric form, optionally followed by a dot and 1-4 additional alphanumeric characters)." ;
    ] ;
    sh:property [
        sh:path gem:excludesProcedure ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^(http://purl\\.bioontology\\.org/ontology/HCPCS/[A-Z]\\d{4}|https://www\\.ama-assn\\.org/cpt#(\\d{5}|\\d{4}[FT]))$" ;
        sh:message "Every gem:excludesProcedure value on a gem:CMSpolicy must be an IRI naming a procedure code in one of two namespaces: a HCPCS Level II code under the BioPortal HCPCS namespace (purl.bioontology.org/ontology/HCPCS/, local name one uppercase letter followed by four digits), or a CPT (Level I) code under the AMA CPT namespace (www.ama-assn.org/cpt#, local name a 5-digit Category I, 4-digit-plus-F Category II, or 4-digit-plus-T Category III code)." ;
    ] ;
    sh:property [
        sh:path gem:exclusivelyCoversCondition ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?$" ;
        sh:message "Every gem:exclusivelyCoversCondition value on a gem:CMSpolicy must be an IRI in the ICD-10-CM namespace (purl.bioontology.org/ontology/ICD10CM/) with a valid ICD-10 diagnosis code as the local name (three required leading characters in letter-digit-alphanumeric form, optionally followed by a dot and 1-4 additional alphanumeric characters)." ;
    ] ;
    sh:property [
        sh:path gem:exclusivelyCoversPrimaryCondition ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?$" ;
        sh:message "Every gem:exclusivelyCoversPrimaryCondition value on a gem:CMSpolicy must be an IRI in the ICD-10-CM namespace (purl.bioontology.org/ontology/ICD10CM/) with a valid ICD-10 diagnosis code as the local name (three required leading characters in letter-digit-alphanumeric form, optionally followed by a dot and 1-4 additional alphanumeric characters)." ;
    ] ;
    sh:property [
        sh:path gem:exclusivelyCoversProcedure ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^(http://purl\\.bioontology\\.org/ontology/HCPCS/[A-Z]\\d{4}|https://www\\.ama-assn\\.org/cpt#(\\d{5}|\\d{4}[FT]))$" ;
        sh:message "Every gem:exclusivelyCoversProcedure value on a gem:CMSpolicy must be an IRI naming a procedure code in one of two namespaces: a HCPCS Level II code under the BioPortal HCPCS namespace (purl.bioontology.org/ontology/HCPCS/, local name one uppercase letter followed by four digits), or a CPT (Level I) code under the AMA CPT namespace (www.ama-assn.org/cpt#, local name a 5-digit Category I, 4-digit-plus-F Category II, or 4-digit-plus-T Category III code)." ;
    ] ;
    sh:property [
        sh:path gem:exclusivelyCoversSecondaryCondition ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?$" ;
        sh:message "Every gem:exclusivelyCoversSecondaryCondition value on a gem:CMSpolicy must be an IRI in the ICD-10-CM namespace (purl.bioontology.org/ontology/ICD10CM/) with a valid ICD-10 diagnosis code as the local name (three required leading characters in letter-digit-alphanumeric form, optionally followed by a dot and 1-4 additional alphanumeric characters)." ;
    ] ;
    sh:property [
        sh:path gem:hasAnchoredCodingScope ;
        sh:class gem:AnchoredCodingScope ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:hasAnchoredCodingScope value on a gem:CMSpolicy must be a gem:AnchoredCodingScope individual." ;
    ] ;
    sh:property [
        sh:path gem:hasPolicyCodingRule ;
        sh:class gem:PolicyCodingRule ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:hasPolicyCodingRule value on a gem:CMSpolicy must be a gem:PolicyCodingRule individual." ;
    ] ;
    sh:property [
        sh:path gem:hasPolicyGroup ;
        sh:class gem:PolicyGroup ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:hasPolicyGroup value on a gem:CMSpolicy must be a gem:PolicyGroup individual." ;
    ] ;
    sh:property [
        sh:path gem:hasPolicyRule ;
        sh:class gem:PolicyRule ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:hasPolicyRule value on a gem:CMSpolicy must be a gem:PolicyRule individual." ;
    ] ;
    sh:property [
        sh:path gem:isInEffect ;
        sh:datatype xsd:boolean ;
        sh:message "Every gem:isInEffect value on a gem:CMSpolicy must be a xsd:boolean literal." ;
    ] ;
    sh:property [
        sh:path gem:manualSectionNumber ;
        sh:datatype xsd:string ;
        sh:message "Every gem:manualSectionNumber value on a gem:CMSpolicy must be a xsd:string literal." ;
    ] ;
    sh:property [
        sh:path gem:nextPlannedStep ;
        sh:class gem:NextPlannedStep ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:nextPlannedStep value on a gem:CMSpolicy must be a gem:NextPlannedStep individual." ;
    ] ;
    sh:property [
        sh:path gem:policyEffectiveDate ;
        sh:datatype xsd:date ;
        sh:message "Every gem:policyEffectiveDate value on a gem:CMSpolicy must be a xsd:date literal." ;
    ] ;
    sh:property [
        sh:path gem:policyImplementationDate ;
        sh:datatype xsd:date ;
        sh:message "Every gem:policyImplementationDate value on a gem:CMSpolicy must be a xsd:date literal." ;
    ] ;
    sh:property [
        sh:path gem:policyPageCount ;
        sh:datatype xsd:integer ;
        sh:message "Every gem:policyPageCount value on a gem:CMSpolicy must be a xsd:integer literal." ;
    ] ;
    sh:property [
        sh:path gem:policyVersion ;
        sh:datatype xsd:string ;
        sh:message "Every gem:policyVersion value on a gem:CMSpolicy must be a xsd:string literal." ;
    ] ;
    sh:property [
        sh:path gem:publicationNumber ;
        sh:datatype xsd:string ;
        sh:message "Every gem:publicationNumber value on a gem:CMSpolicy must be a xsd:string literal." ;
    ] ;
    sh:property [
        sh:path gem:referencesPolicy ;
        sh:class gem:CMSpolicy ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:referencesPolicy value on a gem:CMSpolicy must be a gem:CMSpolicy individual." ;
    ] ;
    sh:property [
        sh:path gem:refersToBenefitCategory ;
        sh:class gem:BenefitCategory ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:refersToBenefitCategory value on a gem:CMSpolicy must be a gem:BenefitCategory individual." ;
    ] ;
    sh:property [
        sh:path gem:refersToClinicalConcept ;
        sh:class gem:ClinicalConcept ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:refersToClinicalConcept value on a gem:CMSpolicy must be a gem:ClinicalConcept individual." ;
    ] ;
    sh:property [
        sh:path gem:refersToCodeGroup ;
        sh:class gem:CodeGroup ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:refersToCodeGroup value on a gem:CMSpolicy must be a gem:CodeGroup individual." ;
    ] ;
    sh:property [
        sh:path gem:refersToHCPCSmodifier ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/HCPCS/[A-Z0-9]{2}$" ;
        sh:message "Every gem:refersToHCPCSmodifier value on a gem:CMSpolicy must be an IRI in the HCPCS namespace (purl.bioontology.org/ontology/HCPCS/) with a two-character modifier code as the local name (uppercase letters and/or digits)." ;
    ] ;
    sh:property [
        sh:path gem:refersToHCPCSprocedure ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^(http://purl\\.bioontology\\.org/ontology/HCPCS/[A-Z]\\d{4}|https://www\\.ama-assn\\.org/cpt#(\\d{5}|\\d{4}[FT]))$" ;
        sh:message "Every gem:refersToHCPCSprocedure value on a gem:CMSpolicy must be an IRI naming a procedure code in one of two namespaces: a HCPCS Level II code under the BioPortal HCPCS namespace (purl.bioontology.org/ontology/HCPCS/, local name one uppercase letter followed by four digits), or a CPT (Level I) code under the AMA CPT namespace (www.ama-assn.org/cpt#, local name a 5-digit Category I, 4-digit-plus-F Category II, or 4-digit-plus-T Category III code)." ;
    ] ;
    sh:property [
        sh:path gem:refersToICDdiagnosis ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?$" ;
        sh:message "Every gem:refersToICDdiagnosis value on a gem:CMSpolicy must be an IRI in the ICD-10-CM namespace (purl.bioontology.org/ontology/ICD10CM/) with a valid ICD-10 diagnosis code as the local name (three required leading characters in letter-digit-alphanumeric form, optionally followed by a dot and 1-4 additional alphanumeric characters)." ;
    ] ;
    sh:property [
        sh:path gem:refersToQualificationGroup ;
        sh:class gem:QualificationGroup ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:refersToQualificationGroup value on a gem:CMSpolicy must be a gem:QualificationGroup individual." ;
    ] ;
    sh:property [
        sh:path gem:requiresProcedure ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^(http://purl\\.bioontology\\.org/ontology/HCPCS/[A-Z]\\d{4}|https://www\\.ama-assn\\.org/cpt#(\\d{5}|\\d{4}[FT]))$" ;
        sh:message "Every gem:requiresProcedure value on a gem:CMSpolicy must be an IRI naming a procedure code in one of two namespaces: a HCPCS Level II code under the BioPortal HCPCS namespace (purl.bioontology.org/ontology/HCPCS/, local name one uppercase letter followed by four digits), or a CPT (Level I) code under the AMA CPT namespace (www.ama-assn.org/cpt#, local name a 5-digit Category I, 4-digit-plus-F Category II, or 4-digit-plus-T Category III code)." ;
    ] ;
    sh:property [
        sh:path gem:requiresProviderCredential ;
        sh:class gem:ProviderCredential ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:requiresProviderCredential value on a gem:CMSpolicy must be a gem:ProviderCredential individual." ;
    ] ;
    sh:property [
        sh:path gem:revisedByPolicy ;
        sh:class gem:CMSpolicy ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:revisedByPolicy value on a gem:CMSpolicy must be a gem:CMSpolicy individual." ;
    ] ;
    sh:property [
        sh:path gem:revisesPolicy ;
        sh:class gem:CMSpolicy ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:revisesPolicy value on a gem:CMSpolicy must be a gem:CMSpolicy individual." ;
    ] ;
    gem:memberOfOntology gem:gemOntology .

gem:AnchoredCodingScopeShape a sh:NodeShape ;
    gem:prefLabel "AnchoredCodingScope shape" ;
    gem:description "Per-individual structural contract for gem:AnchoredCodingScope instances and their subclasses (gem:PolicyGroup, gem:PolicyCodingRule). Enforces value-class constraints on anchor-applicability predicates (the appliesWhen* sub-properties of gem:appliesWhenCode) and the union-domain coverage/exclusion predicates that AnchoredCodingScope shares with gem:CMSpolicy. Per Borderline #2 of the S78 SHACL Plan turn, union-domain predicates are duplicated across CMSpolicyShape and this shape (rather than expressed as top-level sh:PropertyShape with sh:targetSubjectsOf) -- matching the existing PolicyRuleShape per-class style and the deferred_proposals[75] proposal text. Every appliesWhen* and union-domain predicate covered here has a code-namespace range (gem:ICDdiagnosis, gem:HCPCSprocedure, or gem:HCPCSmodifier), and all of them are enforced via sh:nodeKind sh:IRI + sh:pattern rather than sh:class (per Borderline #4): the code-namespace individuals are produced by external BioPortal-conversion queries and are not present as typed individuals in the audit-time validation graph; sh:class would mis-fire against every value. The procedure-predicate sh:pattern blocks here were widened at S88 to admit the cpt: IRI form for CPT (Level I) codes (typed gem:CPTprocedure by gem_cpt_conversion.rq, also outside the validation graph) in addition to the HCPCS Level II form. gem:appliesWhenCode (the umbrella predicate) is intentionally omitted: its rdfs:range is undeclared (the three sub-properties carry the kind-specific ranges), and the umbrella has zero instance-data usage. Phase 4 instance promotion will not affect the targeting of this shape: AnchoredCodingScope individuals remain typed as gem:PolicyGroup or gem:PolicyCodingRule; Phase 4 promotes the rule-description STRINGS off those subjects onto new gem:PolicyRule individuals while the AnchoredCodingScope subjects themselves remain. The sh:property block for gem:hasPolicyRule was added at S83 (2026-06-22) on the Phase 4 launch, parallel to the existing block on gem:CMSpolicyShape: every gem:hasPolicyRule value on a gem:AnchoredCodingScope must be a gem:PolicyRule individual. Invocation requires the data_graph to include both GEM_policy_instances.ttl and GEM_ontology.ttl -- see gem_structured_rule_guide.md Architectural Implications, SHACL invocation pattern subsection." ;
    sh:targetClass gem:AnchoredCodingScope ;
    sh:property [
        sh:path gem:appliesWhenCondition ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?$" ;
        sh:message "Every gem:appliesWhenCondition value on a gem:AnchoredCodingScope must be an IRI in the ICD-10-CM namespace (purl.bioontology.org/ontology/ICD10CM/) with a valid ICD-10 diagnosis code as the local name (three required leading characters in letter-digit-alphanumeric form, optionally followed by a dot and 1-4 additional alphanumeric characters)." ;
    ] ;
    sh:property [
        sh:path gem:appliesWhenModifier ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/HCPCS/[A-Z0-9]{2}$" ;
        sh:message "Every gem:appliesWhenModifier value on a gem:AnchoredCodingScope must be an IRI in the HCPCS namespace (purl.bioontology.org/ontology/HCPCS/) with a two-character modifier code as the local name (uppercase letters and/or digits)." ;
    ] ;
    sh:property [
        sh:path gem:appliesWhenProcedure ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^(http://purl\\.bioontology\\.org/ontology/HCPCS/[A-Z]\\d{4}|https://www\\.ama-assn\\.org/cpt#(\\d{5}|\\d{4}[FT]))$" ;
        sh:message "Every gem:appliesWhenProcedure value on a gem:AnchoredCodingScope must be an IRI naming a procedure code in one of two namespaces: a HCPCS Level II code under the BioPortal HCPCS namespace (purl.bioontology.org/ontology/HCPCS/, local name one uppercase letter followed by four digits), or a CPT (Level I) code under the AMA CPT namespace (www.ama-assn.org/cpt#, local name a 5-digit Category I, 4-digit-plus-F Category II, or 4-digit-plus-T Category III code)." ;
    ] ;
    sh:property [
        sh:path gem:excludesCondition ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?$" ;
        sh:message "Every gem:excludesCondition value on a gem:AnchoredCodingScope must be an IRI in the ICD-10-CM namespace (purl.bioontology.org/ontology/ICD10CM/) with a valid ICD-10 diagnosis code as the local name (three required leading characters in letter-digit-alphanumeric form, optionally followed by a dot and 1-4 additional alphanumeric characters)." ;
    ] ;
    sh:property [
        sh:path gem:excludesProcedure ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^(http://purl\\.bioontology\\.org/ontology/HCPCS/[A-Z]\\d{4}|https://www\\.ama-assn\\.org/cpt#(\\d{5}|\\d{4}[FT]))$" ;
        sh:message "Every gem:excludesProcedure value on a gem:AnchoredCodingScope must be an IRI naming a procedure code in one of two namespaces: a HCPCS Level II code under the BioPortal HCPCS namespace (purl.bioontology.org/ontology/HCPCS/, local name one uppercase letter followed by four digits), or a CPT (Level I) code under the AMA CPT namespace (www.ama-assn.org/cpt#, local name a 5-digit Category I, 4-digit-plus-F Category II, or 4-digit-plus-T Category III code)." ;
    ] ;
    sh:property [
        sh:path gem:exclusivelyCoversCondition ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?$" ;
        sh:message "Every gem:exclusivelyCoversCondition value on a gem:AnchoredCodingScope must be an IRI in the ICD-10-CM namespace (purl.bioontology.org/ontology/ICD10CM/) with a valid ICD-10 diagnosis code as the local name (three required leading characters in letter-digit-alphanumeric form, optionally followed by a dot and 1-4 additional alphanumeric characters)." ;
    ] ;
    sh:property [
        sh:path gem:exclusivelyCoversPrimaryCondition ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?$" ;
        sh:message "Every gem:exclusivelyCoversPrimaryCondition value on a gem:AnchoredCodingScope must be an IRI in the ICD-10-CM namespace (purl.bioontology.org/ontology/ICD10CM/) with a valid ICD-10 diagnosis code as the local name (three required leading characters in letter-digit-alphanumeric form, optionally followed by a dot and 1-4 additional alphanumeric characters)." ;
    ] ;
    sh:property [
        sh:path gem:exclusivelyCoversProcedure ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^(http://purl\\.bioontology\\.org/ontology/HCPCS/[A-Z]\\d{4}|https://www\\.ama-assn\\.org/cpt#(\\d{5}|\\d{4}[FT]))$" ;
        sh:message "Every gem:exclusivelyCoversProcedure value on a gem:AnchoredCodingScope must be an IRI naming a procedure code in one of two namespaces: a HCPCS Level II code under the BioPortal HCPCS namespace (purl.bioontology.org/ontology/HCPCS/, local name one uppercase letter followed by four digits), or a CPT (Level I) code under the AMA CPT namespace (www.ama-assn.org/cpt#, local name a 5-digit Category I, 4-digit-plus-F Category II, or 4-digit-plus-T Category III code)." ;
    ] ;
    sh:property [
        sh:path gem:exclusivelyCoversSecondaryCondition ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?$" ;
        sh:message "Every gem:exclusivelyCoversSecondaryCondition value on a gem:AnchoredCodingScope must be an IRI in the ICD-10-CM namespace (purl.bioontology.org/ontology/ICD10CM/) with a valid ICD-10 diagnosis code as the local name (three required leading characters in letter-digit-alphanumeric form, optionally followed by a dot and 1-4 additional alphanumeric characters)." ;
    ] ;
    sh:property [
        sh:path gem:hasPolicyRule ;
        sh:class gem:PolicyRule ;
        sh:nodeKind sh:IRI ;
        sh:message "Every gem:hasPolicyRule value on a gem:AnchoredCodingScope must be a gem:PolicyRule individual." ;
    ] ;
    gem:memberOfOntology gem:gemOntology .

# ============================================================================
# Integrating the HCPCS code set into the ontology
# ============================================================================
#
#  HCPCS (the Healthcare Common Procedure Coding System) is the standardized
#  code set used to bill Medicare for procedures, supplies, products, and
#  services -- including durable medical equipment such as home oxygen
#  equipment.  Two kinds of HCPCS entry are modeled here:
#
#  Procedure / item codes -- five-character alphanumeric codes such as E1390
#  ("Oxygen concentrator, single delivery port ...") that name a billable
#  procedure, item, or supply.
#
#  Modifiers -- two-character alphanumeric codes such as KX or QF that attach
#  to a procedure/item code on a claim line to convey a billing circumstance
#  (for example, that documented coverage criteria are on file).  Modifiers
#  are billing instructions; they are not themselves billable items.
#
#  Unlike the ICD-10-CM hierarchy, the HCPCS code set is modeled WITHOUT a
#  navigable parent/child hierarchy.  In the BioPortal HCPCS source ontology
#  the only rdfs:subClassOf parents of real codes are administrative
#  "Level 1" through "Level 5" price/category range buckets (e.g.
#  "Level 3: E1352-E1406") and the "MTHU" modifier-grouping nodes.  These
#  buckets are not clinically meaningful the way ICD-10 blocks and chapters
#  are, and home oxygen claim relevance does not depend on navigating them,
#  so the groupings and the rdfs:subClassOf hierarchy are deliberately not
#  carried over.  Only the real codes and modifiers are typed.  If requirements
#  emerge for including administrative parents, they will be added at that
#  time.
#
#  The code and modifier individuals are NOT defined in this file.  They are
#  produced by running gem_hcpcs_conversion.rq against a knowledge graph
#  that has been loaded with both this schema and the BioPortal HCPCS source
#  ontology.  The conversion reads the HCPCS-namespace owl:Class definitions
#  and asserts, on the SAME IRIs, the gem: types defined below -- mirroring
#  the approach already used to integrate ICD-10-CM.
#
#  Querying the code set (where ?focus is a starting code):
#    is it a procedure/item   ?focus a gem:HCPCSprocedure
#    is it a modifier         ?focus a gem:HCPCSmodifier
#    is it any HCPCS code     ?focus a gem:HCPCScode
#    its display label        ?focus skos:prefLabel ?label
#    its short code           ?focus skos:notation  ?code
#

# -----------------------------------------------------------------------------
#    Class Definitions
# -----------------------------------------------------------------------------
gem:HCPCScode a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    gem:prefLabel "HCPCS Code" ;
    gem:description "A 'HCPCS Code' is a class referring to any real Healthcare Common Procedure Coding System entry: a procedure/item code or a modifier. Common superclass of gem:HCPCSprocedure and gem:HCPCSmodifier. The conversion query materializes this type directly on every code, so '?x a gem:HCPCScode' returns the whole code set under plain SPARQL with no reasoner. Administrative range groupings ('Level 1' through 'Level 5' buckets) are not members of this class." ;
    gem:llmDetailedDefinition """Common superclass over gem:HCPCSprocedure (billable procedures/items) and gem:HCPCSmodifier (billing modifiers). `?x a gem:HCPCScode` returns the whole real code set (type materialized on every code). Administrative range buckets ('Level 1' through 'Level 5') are NOT members.""" ;
    gem:llmScopingNote """Use the subclass to separate billable items (gem:HCPCSprocedure) from billing instructions (gem:HCPCSmodifier).""" ;
    gem:memberOfOntology gem:gemOntology .

gem:HCPCSprocedure a owl:Class ;
    rdfs:subClassOf gem:HCPCScode ;
    gem:prefLabel "HCPCS Procedure or Item Code" ;
    gem:description "A 'HCPCS Procedure or Item Code' is a class of HCPCS codes that name a billable procedure, item, supply, product, or service -- for example E1390 (oxygen concentrator). Two kinds of member are distinguished. HCPCS Level II codes (one letter plus four characters, e.g. E1390) carry hcpcs: IRIs under the BioPortal namespace. CPT Level I codes -- five-digit Category I, four-digit-plus-F Category II, or four-digit-plus-T Category III -- carry cpt: IRIs (https://www.ama-assn.org/cpt#) and are members of the subclass gem:CPTprocedure. A query for '?x a gem:HCPCSprocedure' returns both Level I and Level II procedure codes; '?x a gem:CPTprocedure' restricts to Level I." ;
    gem:llmDetailedDefinition """A billable procedure/item/supply/service code. Two member kinds: HCPCS Level II (one letter + four chars, hcpcs: IRIs) and CPT Level I (cpt: IRIs), the latter in the subclass gem:CPTprocedure. `?x a gem:HCPCSprocedure` returns BOTH Level I and II. The entire procedure-polarity axis (gem:coversProcedure / gem:excludesProcedure / gem:exclusivelyCoversProcedure / gem:requiresProcedure, gem:appliesWhenProcedure, gem:refersToHCPCSprocedure) ranges over this class and therefore covers CPT codes with no separate predicate.""" ;
    gem:llmScopingNote """Members are typed OUTSIDE the canonical GEM files: hcpcs: individuals acquire their rdf:type from the BioPortal HCPCS conversion query and cpt: individuals from cpt.ttl. Parsing GEM_ontology.ttl and GEM_policy_instances.ttl on their own therefore yields zero individuals of this class, while the loaded triplestore is fully populated; policies reference these codes in object position throughout the instances file either way. A zero individual count in a file-level census is expected and is not evidence the class is unused.""" ;
    gem:llmTraversalHint """Query all procedures with `?x a gem:HCPCSprocedure`; restrict to CPT (Level I) with `?x a gem:CPTprocedure`.""" ;
    gem:isaPrimaryClass true ;
    gem:memberOfOntology gem:gemOntology .

# CPT Category I/II/III codes are HCPCS Level I (AMA-copyrighted, not present
# in the BioPortal HCPCS Level-II dataset).  They are sourced from cpt.ttl
# (the cpt: namespace, https://www.ama-assn.org/cpt#) and typed
# gem:CPTprocedure by gem_cpt_conversion.rq -- the exact analogue of
# gem_hcpcs_conversion.rq -- run against a graph loaded with this schema and
# cpt.ttl.  As with HCPCS Level II and ICD codes, CPT individuals are NOT
# loaded into the audit-time validation graph, and cpt.ttl never references
# the GEM ontology.  Procedure predicates reach CPT codes through the
# existing gem:HCPCSprocedure range (satisfied by this subclass); SHACL
# validates the cpt: IRI form by sh:pattern, not sh:class, because the codes
# are not present as typed individuals at validation time.
gem:CPTprocedure a owl:Class ;
    rdfs:subClassOf gem:HCPCSprocedure ;
    gem:prefLabel "CPT Procedure Code" ;
    gem:description "A 'CPT Procedure Code' is a class of HCPCS Level I (CPT) procedure codes -- the American Medical Association's Current Procedural Terminology code set -- for example 95860 (needle electromyography). It is a subclass of gem:HCPCSprocedure: every CPT code is a HCPCS procedure for query and reference purposes, so the existing procedure axis (gem:appliesWhenProcedure, gem:coversProcedure, and the rest of the gem:refersToHCPCSprocedure family) references CPT codes with no new predicate. CPT codes are sourced from cpt.ttl in the cpt: namespace (https://www.ama-assn.org/cpt#; IRI local name is the bare code, e.g. cpt:95860) -- a maintained mock-up to be replaced by a CMS-managed CPT file later -- and are typed as members of this class by gem_cpt_conversion.rq, not by triples in cpt.ttl (which never references the GEM ontology) and not by definitions in this file. CPT (Level I) local names are five-digit Category I, four-digit-plus-F Category II, or four-digit-plus-T Category III; HCPCS Level II codes (one letter plus four digits) remain under the BioPortal hcpcs: namespace and are not members of this class. Members are queried with '?x a gem:CPTprocedure'. Introduced 2026-06-24 (Session 88)." ;
    gem:llmDetailedDefinition """The HCPCS Level I (CPT) subclass of gem:HCPCSprocedure: every CPT code IS a HCPCS procedure for query and reference, so no CPT-specific polarity predicate exists. Local name is the bare code (e.g. cpt:95860).""" ;
    gem:llmScopingNote """CPT codes are sourced from cpt.ttl in the cpt: namespace -- a maintained mock-up to be replaced by a CMS-managed CPT file later. cpt.ttl never references the GEM ontology; CPT individuals are typed gem:CPTprocedure by the conversion query, not by triples in cpt.ttl.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:HCPCSmodifier a owl:Class ;
    rdfs:subClassOf gem:HCPCScode ;
    gem:prefLabel "HCPCS Modifier" ;
    gem:description "A 'HCPCS Modifier' is a class of two-character HCPCS Level II National Modifier codes -- for example KX or QF. A modifier attaches to a procedure/item code on a claim line to convey a billing circumstance; it is a billing instruction, not a billable item. IRI local name is a two-character alphanumeric string. In the BioPortal HCPCS source ontology a modifier is a transitive subclass of hcpcs:MTHU000318 ('HCPCS Modifiers'); the conversion query uses that lineage to identify modifiers and re-expresses the distinction as this explicit rdf:type. Members are queried with '?x a gem:HCPCSmodifier'." ;
    gem:llmDetailedDefinition """A two-character HCPCS Level II modifier (e.g. KX, QF) -- a billing instruction attached to a procedure/item line to convey a billing circumstance, NOT a billable item. Standard cross-Medicare meanings may be annotated via gem:modifierSemantics.""" ;
    gem:llmScopingNote """Modifiers have NO covered/non-covered polarity pair: a policy's modifier references are captured only via the polarity-neutral gem:refersToHCPCSmodifier (policy level) or gem:appliesWhenModifier (as a scope anchor). There is no covers/excludesModifier -- do not look for one.""" ;
    gem:memberOfOntology gem:gemOntology .

# -----------------------------------------------------------------------------
#    SHACL Node Shape Definitions
# -----------------------------------------------------------------------------
gem:HCPCSprocedureShape a sh:NodeShape ;
    gem:prefLabel "HCPCSprocedure IRI shape" ;
    gem:description "IRI pattern for HCPCS procedure / item codes" ;
    sh:targetClass gem:HCPCSprocedure ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://purl\\.bioontology\\.org/ontology/HCPCS/(\\d{5}|\\d{4}[FT]|[A-Z]\\d{4})$" ;
    sh:message "A HCPCSprocedure must be an IRI in the HCPCS namespace whose local name is one of: a 5-digit CPT Category I code, a 4-digit-plus-F CPT Category II code, a 4-digit-plus-T CPT Category III code, or a HCPCS Level II code (one uppercase letter followed by four digits)." ;
    gem:memberOfOntology gem:gemOntology .

gem:HCPCSmodifierShape a sh:NodeShape ;
    gem:prefLabel "HCPCSmodifier IRI shape" ;
    gem:description "IRI pattern for HCPCS modifier codes" ;
    sh:targetClass gem:HCPCSmodifier ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://purl\\.bioontology\\.org/ontology/HCPCS/[A-Z0-9]{2}$" ;
    sh:message "A HCPCSmodifier must be an IRI in the HCPCS namespace with a two-character local name composed of uppercase letters and/or digits." ;
    gem:memberOfOntology gem:gemOntology .

gem:HCPCScodeShape a sh:NodeShape ;
    gem:prefLabel "HCPCScode IRI shape" ;
    gem:description "IRI pattern for any HCPCS code -- procedure/item or modifier" ;
    sh:targetClass gem:HCPCScode ;
    sh:nodeKind sh:IRI ;
    sh:pattern "^http://purl\\.bioontology\\.org/ontology/HCPCS/(\\d{5}|\\d{4}[FT]|[A-Z]\\d{4}|[A-Z0-9]{2})$" ;
    sh:message "A HCPCScode must be an IRI in the HCPCS namespace whose local name is either a five-character procedure/item code (see gem:HCPCSprocedureShape: CPT Category I 5-digit, CPT Category II ####F, CPT Category III ####T, or HCPCS Level II letter-plus-4-digit) or a two-character modifier code (see gem:HCPCSmodifierShape)." ;
    gem:memberOfOntology gem:gemOntology .

gem:CodeGroupShape a sh:NodeShape ;
    gem:prefLabel "CodeGroup structural shape" ;
    gem:description "Per-individual structural contract for gem:CodeGroup instances. Three value constraints are enforced, following the value-class strategies documented on gem:CMSpolicyShape. (1) skos:narrower (the enumerated curated-core members) is validated by sh:nodeKind sh:IRI + sh:pattern admitting the three code-namespace forms in scope -- HCPCS Level II procedure/item codes, CPT (Level I) Category I/II codes, and ICD-10-CM diagnosis codes -- because code IRIs are produced by the external BioPortal / CPT conversion queries and are NOT present as typed individuals in the audit-time validation graph, so sh:class would mis-fire against every value; this mirrors gem:HCPCSprocedureShape / gem:ICDdiagnosisShape. HCPCS modifiers and ICD code-pair groupings are intentionally NOT admitted yet (deferred per Tom, S103). (2) gem:identifiesClinicalConcept uses sh:class gem:ClinicalConcept because concept individuals live in GEM_policy_instances.ttl, which is loaded into the validation graph alongside this file. (3) gem:memberCodePattern (the regex-pattern membership form, declared Session 104) is validated by sh:datatype xsd:string + sh:nodeKind sh:Literal; the regex itself is not further constrained. gem:codeGroupOwner (an annotation property) is not constrained here. No cardinality bounds are imposed: a group may carry 0..N skos:narrower (pattern-only and arbitrary empty-core groups are valid), 0..N gem:identifiesClinicalConcept, and 0..N gem:memberCodePattern, matching the project's 0..N posture. Invocation requires the data_graph to include GEM_code_group_instances.ttl, GEM_policy_instances.ttl, and GEM_ontology.ttl. Introduced 2026-06-30 (Session 103); the gem:memberCodePattern constraint (3) was added 2026-06-30 (Session 104)." ;
    sh:targetClass gem:CodeGroup ;
    sh:property [
        sh:path skos:narrower ;
        sh:nodeKind sh:IRI ;
        sh:pattern "^(http://purl\\.bioontology\\.org/ontology/HCPCS/[A-Z]\\d{4}|https://www\\.ama-assn\\.org/cpt#(\\d{5}|\\d{4}[FT])|http://purl\\.bioontology\\.org/ontology/ICD10CM/[A-Za-z][0-9][A-Za-z0-9](\\.[A-Za-z0-9]{1,4})?)$" ;
        sh:message "A gem:CodeGroup skos:narrower member must be an IRI for a HCPCS Level II procedure/item code, a CPT Category I/II code, or an ICD-10-CM diagnosis code." ;
    ] ;
    sh:property [
        sh:path gem:identifiesClinicalConcept ;
        sh:class gem:ClinicalConcept ;
        sh:message "Every gem:identifiesClinicalConcept value on a gem:CodeGroup must be a gem:ClinicalConcept individual." ;
    ] ;
    sh:property [
        sh:path gem:memberCodePattern ;
        sh:datatype xsd:string ;
        sh:nodeKind sh:Literal ;
        sh:message "A gem:CodeGroup gem:memberCodePattern must be a string-literal regular expression." ;
    ] ;
    gem:memberOfOntology gem:gemOntology .

# ============================================================================
# Restructured BETOS Classification System (RBCS) DEFINITIONS
# ============================================================================
# -----------------------------------------------------------------------------
#    Class Definitions
# -----------------------------------------------------------------------------
rbcs:healthcareService a owl:Class ;
    rbcs:prefLabel "Healthcare Service" ;
    rbcs:description "A 'Healthcare Service' is a class that contains Restructured BETOS Classification System healthcare services.  RBCS is a CMS-developed, 6-character taxonomy used to group Medicare Part B HCPCS codes into clinically meaningful categories. It updates the original 1980s Berenson-Eggers Type of Service (BETOS) to include modern services, such as non-physician, laboratory, and imaging services, allowing researchers to track Medicare spending trends." ;
    rbcs:memberOfOntology rbcs:rbcsOntology .


# -----------------------------------------------------------------------------
#    Property Definitions
# -----------------------------------------------------------------------------
rbcs:dataFormat a owl:DatatypeProperty ;
    rbcs:prefLabel "Data Format" ;
    rbcs:description "A 'Data Format' is a datatype property that defines the format of the attribute's data.  For example, dates may appear in MMDDYYYY or YYYYMMDD format. It is intended to be informative but is not a format definition which can be employed to test the quality of the data." ;
    rdfs:domain owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:description a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:description ;
    rbcs:prefLabel "Description" ;
    rbcs:description "A 'Description' is a written account that provides details about an ontological term, aimed at creating a vivid mental image for the reader. It acts as a representation of characteristics, often functioning to explain what something is, its appearance, or its nature." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:identifier a owl:DatatypeProperty ;
    rbcs:prefLabel "Identifier" ;
    rbcs:shortDescription "An 'Identifier' is a datatype property that contains a unique value for the data instance." ;
    rbcs:description "An 'Identifier' is a datatype property that contains a value that is provided by an authority, such as a vendor or public agency, that uniquely identifies an instance of data from other instances of data that are managed by the authority." ;
    rdfs:domain owl:Class ;
    rdfs:range xsd:string ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:llmDetailedDefinition a owl:AnnotationProperty ;
    rbcs:prefLabel "LLM Detailed Definition" ;
    rbcs:description "An extended explanation of an ontological term's meaning, modeling rationale, and disambiguation guidance, written for LLM consumption." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:llmScopingNote a owl:AnnotationProperty ;
    gem:prefLabel "LLM Scoping Note" ;
    gem:description "Boundary conditions, applicability constraints, or contextual limitations on when this schema element applies, written for LLM consumption." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:memberOfOntology a owl:AnnotationProperty ;
    gem:prefLabel "Member Of Ontology" ;
    gem:description "A 'Member Of Ontology' is an annotation that declares an entity's membership in a specific ontology." ;
    rdfs:domain owl:Thing ;
    rdfs:range owl:Ontology ;
    gem:llmScopingNote """Every entity in the ontology carries rbcs:memberOfOntology rbcs:rbcsOntology . This is a housekeeping annotation for ontology management — it does not carry semantic content relevant to answering user questions. You can safely ignore this property when reasoning about the domain.""" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:prefLabel a owl:AnnotationProperty ;
    rdfs:subPropertyOf skos:prefLabel ;
    gem:prefLabel "Preferred Label" ;
    rbcs:description "A 'Preferred Label' is an annotation providing the human-readable display name for any ontological term or individual." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:sampleData a owl:DatatypeProperty ;
    rbcs:prefLabel "Sample Data" ;
    rbcs:description "A 'Sample Data' is a datatype property that contains a example of a data value found in this property. It is intended to be informative but is not a complete, inclusive list of valid values." ;
    rdfs:domain owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:shortDescription a owl:AnnotationProperty ;
    rdfs:subPropertyOf rbcs:description ;
    rbcs:prefLabel "Short Description" ;
    gem:description "A 'Short Description' is a datatype property that provides a brief human-readable description of what a schema element or instance represents. " ;
    rbcs:llmDetailedDefinition "A 'Short Description' is an annotation that provides a brief human-readable description of what a schema element or instance represents. " ;
    rdfs:domain owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:sourceAttribute a owl:DatatypeProperty ;
    rbcs:prefLabel "Source Attribute" ;
    rbcs:description "An 'Source Attribute' is a datatype property that defines the identifier or label for an external data source or resource in a system, such as a column in a database table, a data field in API mapping, or an object GUID in software, allowing systems to locate, classify, or integrate that data. It acts as a reference to where information originates." ;
    rdfs:domain owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

# -----------------------------------------------------------------------------

rbcs:alternativeAssignmentMethod a owl:DatatypeProperty ;
    rbcs:prefLabel "Alternative Assignment Method" ;
    rbcs:description "An 'Alternative Assignment Method' is a datatype property containing a classification indicator used when the standard, data-driven window cannot be applied to assign an RBCS ID to a specific HCPCS/CPT medical service code.  '0': Indicates the code was categorized using the standard timeframe and process.  '1': Indicates the Alternative Assignment Method was utilized for the HCPCS/CPT code." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:dataFormat "N" ;
    rbcs:sampleData "0", "1" ;
    rbcs:sourceAttribute "Alt_Assignment_Method" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:firstRBCSreleaseYear a owl:DatatypeProperty ;
    rbcs:prefLabel "First RBCS Release Year" ;
    rbcs:description "A 'First RBCS Release Year' is a datatype property containing the first release year that the RBCS ID was assigned to a HCPCS/CPT code. This variable is essentially an RBCS Release Year 'version' number for the classification assigned to a code, indicating when that specific classification, in its current structure, was first introduced." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:dataFormat "YYYY" ;
    rbcs:sampleData "2020", "2023", "2025" ;
    rbcs:sourceAttribute "First_RBCS_Release_Year" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:hcpcsCode a owl:DatatypeProperty ;
    rdfs:subPropertyOf rbcs:identifier ;
    rbcs:prefLabel "HCPCS Code" ;
    rbcs:description "A 'HCPCS Code' is a datatype property containing an identifier for procedures, supplies, products, and services which may be provided to Medicare beneficiaries and to individuals enrolled in private health insurance programs.  HCPCS codes (Healthcare Common Procedure Coding System, often pronounced 'hick-picks') are standardized, alphanumeric codes used by healthcare providers to bill Medicare, Medicaid, and private insurers for non-physician services, supplies, and equipment, such as ambulance rides, durable medical equipment (DME), and drugs." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:sampleData "000100", "000102", "000103" ;
    rbcs:sourceAttribute "HCPCS_Cd" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:hcpcsCodeAddDate a owl:DatatypeProperty ;
    rbcs:prefLabel "HCPCS Code Add Date" ;
    rbcs:description "A 'HCPCS Code Add Date' is a datatype property containing the specific date on which a new Healthcare Common Procedure Coding System (HCPCS) Level II code becomes active, valid, and reportable for services. CMS updates these codes on a regular schedule, generally on a quarterly basis." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:dataFormat "MMDDYYYY" ;
    rbcs:sampleData "01011989", "01011992", "01011993" ;
    rbcs:sourceAttribute "HCPCS_Cd_Add_Dt" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:hcpcsCodeEndDate a owl:DatatypeProperty ;
    rbcs:prefLabel "HCPCS Code End Date" ;
    rbcs:description "A 'HCPCS Code End Date' is a datatype property containing the specific date on which the HCPCS/CPT code is retired." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:dataFormat "MMDDYYYY" ;
    rbcs:sampleData "12312016", "01011992", "01011993" ;
    rbcs:sourceAttribute "HCPCS_Cd_End_Dt" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:rbcsAnalysisEndDate a owl:DatatypeProperty ;
    rbcs:prefLabel "RBCS Analysis End Date" ;
    rbcs:description "An 'RBCS Analysis End Date' is a datatype property containing the latest claim calendar year that the Centers for Medicare & Medicaid Services (CMS) recommends an RBCS ID be applied to a specific HCPCS/CPT code." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:dataFormat "MMDDYYYY" ;
    rbcs:sampleData "12319999" ;
    rbcs:sourceAttribute "RBCS_Analysis_End_Dt" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:rbcsAnalysisStartDate a owl:DatatypeProperty ;
    rbcs:prefLabel "RBCS Analysis Start Date" ;
    rbcs:description "An 'RBCS Analysis Start Date' is a datatype property containing the earliest claim calendar year that the Centers for Medicare & Medicaid Services (CMS) recommends an RBCS ID be applied to a specific HCPCS/CPT code." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:dataFormat "MMDDYYYY" ;
    rbcs:sampleData "01012014", "01012019", "01012024" ;
    rbcs:sourceAttribute "RBCS_Analysis_Start_Dt" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:rbcsCategory a owl:DatatypeProperty ;
    rbcs:prefLabel "RBCS Category" ;
    rbcs:description "An 'RBCS Category' is a datatype property containing the first character of a six-character CMS code used to classify Medicare Part B HCPCS/CPT codes into clinically meaningful, high-level groups. It identifies broad service types like evaluation, procedures, or imaging, updated from the original Berenson-Eggers Type of Service (BETOS)." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:dataFormat "A" ;
    rbcs:sampleData "A", "D", "E" ;
    rbcs:sourceAttribute "RBCS_Cat" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:rbcsCategoryDescription a owl:DatatypeProperty ;
    rbcs:prefLabel "RBCS Category Description" ;
    rbcs:description "An 'RBCS Category Description' is a datatype property containing a text description of the RBCS Category." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:sampleData "Anesthesia", "DME", "E&M" ;
    rbcs:sourceAttribute "RBCS_Cat_Desc" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:rbcsEverReassignedFlag a owl:DatatypeProperty ;
    rbcs:prefLabel "RBCS Ever Reassigned Flag" ;
    rbcs:description "An 'RBCS Ever Reassigned Flag' is a datatype property containing a binary indicator that specifies if a healthcare service code has been assigned to more than one RBCS category over time.  '0': Indicates the code has maintained a single, consistent RBCS ID assignment.  '1': Indicates the HCPCS code has been assigned to more than one RBCS ID across historical datasets." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:dataFormat "N" ;
    rbcs:sampleData "0", "1" ;
    rbcs:sourceAttribute "RBCS_Id_Ever_Reassigned" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:rbcsFamilyDescription a owl:DatatypeProperty ;
    rbcs:prefLabel "RBCS Farmily Description" ;
    rbcs:description "An 'RBCS Family Description' is a datatype property that provides a granular, clinically meaningful description of Medicare Part B service groupings. It sits between subcategories and major procedure indicators, mapping specific HCPCS codes based on historical utilization and spending data." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:sampleData "No RBCS Family", "Skin Allograft", "CT/CTA - Spine" ;
    rbcs:sourceAttribute "RBCS_Family_Desc" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:rbcsFamilyNumber a owl:DatatypeProperty ;
    rbcs:prefLabel "RBCS Family Number" ;
    rbcs:description "An 'RBCS Family Number' is a datatype property containing the third, fourth, and fifth character of the six-character Restructured BETOS Classification System (RBCS) identifier. It acts as a specific identifier for the clinical 'Family' grouping within the CMS Medicare Part B taxonomy. This hierarchical code provides a standardized method to categorize HCPCS/CPT codes by clinical area, aiding in Medicare expenditure analysis." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:sampleData "0", "18", "21" ;
    rbcs:sourceAttribute "RBCS_FamNumb" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:rbcsId a owl:DatatypeProperty ;
    rdfs:subPropertyOf rbcs:identifier ;
    rbcs:prefLabel "RBCS ID" ;
    rbcs:description "An 'RBCS ID' is a datatype property containing a 6-character identifier used by Medicare to categorize healthcare service codes (HCPCS/CPT) into specific service types, such as evaluation/management, procedures, or imaging. " ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:sourceAttribute "RBCS_Id" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:rbcsLatestAssignment a owl:DatatypeProperty ;
    rbcs:prefLabel "RBCS Latest Assignment" ;
    rbcs:description "An 'RBCS Latest Assignment' is a datatype property containing the latest RBCS ID assignment for the HCPCS/CPT code. A value of '1' indicates that the RBCS ID is the most recent assignment for the HCPCS/CPT code. A value of '0' indicates that the RBCS ID is not the most recent assignment for the HCPCS/CPT code." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:sampleData "0", "1" ;
    rbcs:sourceAttribute "RBCS_Latest_Assignment" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:rbcsMajorProcedureIndicator a owl:DatatypeProperty ;
    rbcs:prefLabel "RBCS Major Procedure Indicator" ;
    rbcs:description "An 'RBCS Major Procedure Indicator' is a datatype property containing the sixth character of the RBCS ID, which represents the type of procedure as Major (M), Other (O), or a non-procedure (N). It classifies services within the Restructured BETOS Classification System (RBCS) to help analyze Medicare Part B expenditures." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:sampleData "M", "O", "N" ;
    rbcs:sourceAttribute "RBCS_Major_Ind" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:rbcsSubcategory a owl:DatatypeProperty ;
    rbcs:prefLabel "RBCS Subcategory" ;
    rbcs:description "An 'RBCS Subcategory' is a datatype property containing the first 2 characters of the RBCS ID.  The 2-character code defines the first level of hierarchical classification for Medicare Part B services (HCPCS/CPT codes) into clinically meaningful groupings, such as 'M1' for Office Visits. It acts as a primary identifier for analytical reporting of Medicare spending." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:sourceAttribute "RBCS_Cat_Subcat" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .

rbcs:rbcsSubcategoryDescription a owl:DatatypeProperty ;
    rbcs:prefLabel "RBCS Subcategory Description" ;
    rbcs:description "An 'RBCS Subcategory Description' is a datatype property containing a text description of the RBCS Category Subcategory." ;
    rdfs:domain rbcs:healthcareService ;
    rdfs:range xsd:string ;
    rbcs:sourceAttribute "RBCS_Subcat_Desc" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .
