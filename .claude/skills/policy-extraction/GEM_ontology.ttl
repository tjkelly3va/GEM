    gem:llmScopingNote """HCPCS modifier slot 4 appended to the service line's procedure code (raw STRING); part of the positional array gem:procModifier1..5. The modifier value space corresponds to gem:HCPCSmodifier individuals. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "procModifier4" ;
    gem:memberOfOntology gem:gemOntology .

gem:procModifier5 a owl:DatatypeProperty ;
    gem:prefLabel "Procedure Modifier 5" ;
    gem:description "A 'Procedure Modifier 5' is a string datatype property that contains the fifth HCPCS modifier appended to the procedure code on a Medicare claim service line, qualifying or further specifying how the procedure or item was rendered." ;
    gem:llmScopingNote """HCPCS modifier slot 5 appended to the service line's procedure code (raw STRING); part of the positional array gem:procModifier1..5. The modifier value space corresponds to gem:HCPCSmodifier individuals. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "procModifier5" ;
    gem:memberOfOntology gem:gemOntology .

gem:providerNPI a owl:DatatypeProperty ;
    gem:prefLabel "Provider NPI" ;
    gem:description "A 'Provider NPI' is a string datatype property that contains the National Provider Identifier (NPI) of the provider rendering the service billed on a Medicare claim." ;
    gem:llmScopingNote """National Provider Identifier of the rendering provider. The POLICY-side analogue for 'who may furnish' is gem:ProviderCredential (via gem:requiresProviderCredential) -- the join for checking a provider against a policy's credential requirement. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "providerNpi" ;
    gem:memberOfOntology gem:gemOntology .

gem:providerPTAN a owl:DatatypeProperty ;
    gem:prefLabel "Provider PTAN" ;
    gem:description "A 'Provider PTAN' is a string datatype property that contains the Provider Transaction Access Number (PTAN) of the provider rendering the service billed on a Medicare claim." ;
    gem:llmScopingNote """Provider's PTAN (Medicare legacy provider identifier). Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "providerPtan" ;
    gem:memberOfOntology gem:gemOntology .

gem:providerSpecialty a owl:DatatypeProperty ;
    gem:prefLabel "Provider Specialty" ;
