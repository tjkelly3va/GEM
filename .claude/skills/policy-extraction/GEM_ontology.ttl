    gem:llmScopingNote """Classification of the edit outcome (rejection / bundling / denial / review flag). Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:EditResult ;
    rdfs:range  xsd:string ;
    gem:sampleData "Rejection", "Bundling", "Denial", "Review Flag" ;
    gem:sourceAttribute "editType" ;
    gem:memberOfOntology gem:gemOntology .

