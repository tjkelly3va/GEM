    gem:llmScopingNote """ZIP code of the service facility. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "serviceFacilityZip" ;
