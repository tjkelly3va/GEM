    gem:description "A 'Referring Specialty' is a string datatype property that contains the CMS Medicare specialty code of the referring physician on a Medicare claim." ;
    gem:llmScopingNote """Referring-provider specialty. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "referSpecialty" ;
