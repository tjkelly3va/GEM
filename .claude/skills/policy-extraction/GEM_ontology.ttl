gem:financialNonCoveredCharges a owl:DatatypeProperty ;
    gem:prefLabel "Financial Non-Covered Charges" ;
    gem:description "'Financial Non-Covered Charges' is a double datatype property that contains the total dollar amount of charges on a Medicare claim that are not covered by Medicare - typically because the service is statutorily excluded or has been determined not medically necessary." ;
    gem:llmScopingNote """Charges determined non-covered. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:double ;
    gem:sourceAttribute "finNonCovChgs" ;
    gem:memberOfOntology gem:gemOntology .

gem:identifier a owl:DatatypeProperty ;
    gem:prefLabel "Identifier" ;
    gem:shortDescription "An 'Identifier' is a datatype property that contains a unique value for the data instance." ;
    gem:description "An 'Identifier' is a datatype property that contains a value that is provided by an authority, such as a vendor or public agency, that uniquely identifies an instance of data from other instances of data that are managed by the authority." ;
    gem:llmScopingNote """Generic authority-assigned unique identifier; its rdfs:domain is owl:Thing, so it appears on both policy-side and claim-side individuals. Its meaning depends on the bearer (e.g. a claim ID vs a policy ID), so interpret it in the context of the individual's type rather than globally.""" ;
    rdfs:domain owl:Thing ;
    rdfs:range  xsd:string ;
    gem:memberOfOntology gem:gemOntology .

gem:isaPrimaryClass a owl:DatatypeProperty ;
    gem:prefLabel "Is A Primary Class" ;
    gem:description "An 'Is A Primary Class' is a datatype property that contains a binary value that is used to designate a class as one of the most important or frequently used classes." ;
    gem:llmScopingNote """Boolean flag marking a class as important / frequently-used -- a schema-navigation aid, not domain content. Housekeeping; ignore when reasoning about coverage.""" ;
    rdfs:domain owl:Class ;
    rdfs:range  xsd:boolean ;
    gem:memberOfOntology gem:gemOntology .

gem:loadDate a owl:DatatypeProperty ;
    gem:prefLabel "Load Date" ;
    gem:description "A 'Load Date' is a date datatype property that contains the date on which the historic Medicare claim record was loaded into the database." ;
    gem:llmScopingNote """Date the record was loaded into the data store. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:HistoricServiceLine ;
    rdfs:range  xsd:date ;
    gem:sourceAttribute "loadDate" ;
    gem:memberOfOntology gem:gemOntology .

gem:medicarePaymentAmount a owl:DatatypeProperty ;
    gem:prefLabel "Medicare Payment Amount" ;
    gem:description "A 'Medicare Payment Amount' is a double datatype property that contains the dollar amount Medicare paid for the service billed on a claim line, after applying any deductible and coinsurance reductions to the allowed amount." ;
    gem:llmScopingNote """Amount Medicare paid. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:double ;
    gem:sourceAttribute "medicarePayAmt" ;
    gem:memberOfOntology gem:gemOntology .

gem:memberOfOntology a owl:AnnotationProperty ;
    gem:prefLabel "Member Of Ontology" ;
    gem:description "A 'Member Of Ontology' is an annotation that declares an entity's membership in a specific ontology." ;
    rdfs:range  owl:Ontology ;
    gem:llmScopingNote """Every entity in the ontology carries gem:memberOfOntology gem:gemOntology . This is a housekeeping annotation for ontology management — it does not carry semantic content relevant to answering user questions. You can safely ignore this property when reasoning about the domain.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:patientStatus a owl:DatatypeProperty ;
    gem:prefLabel "Patient Status" ;
    gem:description "A 'Patient Status' is a string datatype property that contains the Patient Discharge Status code on a Medicare institutional claim - a CMS-maintained code indicating the patient's status at the conclusion of the billing period (such as discharged home, transferred, or deceased)." ;
    gem:llmScopingNote """Patient discharge-status code (institutional); an external CMS code set, not enumerated here. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "patStatus" ;
    gem:memberOfOntology gem:gemOntology .

gem:placeServiceCode a owl:DatatypeProperty ;
    gem:prefLabel "Place Service Code" ;
    gem:description "A 'Place Service Code' is a string datatype property that contains the Place of Service (POS) code on a Medicare professional claim - a two-digit code from CMS's Place of Service code set identifying the setting in which the service was rendered (such as office, home, or hospital)." ;
    gem:llmScopingNote """Place-of-service code; an external CMS code set, not enumerated here. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "placeServCd" ;
    gem:memberOfOntology gem:gemOntology .

gem:placeServiceZipCode a owl:DatatypeProperty ;
    gem:prefLabel "Place Service Zip Code" ;
    gem:description "A 'Place Service Zip Code' is a string datatype property that contains the ZIP code of the location where the service was rendered, as reported on a Medicare claim." ;
    gem:llmScopingNote """ZIP code of the place of service. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "placeServZip" ;
    gem:memberOfOntology gem:gemOntology .

gem:prefLabel a owl:AnnotationProperty ;
    rdfs:subPropertyOf skos:prefLabel ;
    gem:prefLabel "Preferred Label" ;
    gem:description "A 'Preferred Label' is an annotation providing the human-readable display name for any ontological term or individual." ;
    gem:llmDetailedDefinition """gem:prefLabel is the canonical human-readable name for any entity in this ontology — classes, properties, and instances alike. It is a subproperty of skos:prefLabel, which means it inherits the SKOS labeling semantics: each entity has one preferred label (gem:prefLabel) and may additionally carry one or more alternative labels (skos:altLabel) representing synonyms, abbreviations, or variant names. When displaying or referring to an entity in natural language, always use the gem:prefLabel value. When searching for an entity by name, check both gem:prefLabel and any skos:altLabel values. The URI local name (the part after the colon) often resembles the preferred label in lowerCamelCase but is not guaranteed to match — always prefer the gem:prefLabel string over parsing the URI.""" ;
    gem:llmScopingNote """Every class, property, and instance in this ontology carries an gem:prefLabel. It is the single most reliable way to map between a natural-language name mentioned in a user's question and the corresponding entity in the graph. If a user refers to something by a name that does not exactly match any gem:prefLabel, check skos:altLabel values before concluding the entity is absent.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:primaryDiagnosisCode a owl:DatatypeProperty ;
    gem:prefLabel "Primary Diagnosis Code" ;
    gem:description "A 'Primary Diagnosis Code' is a string datatype property that contains the principal ICD-10-CM diagnosis code reported on a Medicare claim - the diagnosis chiefly responsible for the services rendered. The ICD-10-CM code set is maintained by the CDC's National Center for Health Statistics in cooperation with CMS, and is rebased annually effective each October 1." ;
    gem:llmScopingNote """The principal ICD-10-CM diagnosis code on a claim, stored as a raw STRING (contrast the object-link form gem:hasICDdiagnosis, whose range is the gem:ICDdiagnosis individual). Secondary positions are the positional array gem:diagnosisCode1..12. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "primDiagCd" ;
    gem:memberOfOntology gem:gemOntology .

gem:procedureCode a owl:DatatypeProperty ;
    gem:prefLabel "Procedure Code" ;
    gem:description "A 'Procedure Code' is a string datatype property that contains the HCPCS procedure or service code billed on a Medicare claim service line, identifying the procedure, service, or item rendered. HCPCS Level I (CPT) codes are maintained by the American Medical Association and Level II codes by CMS; the code set is updated quarterly with annual rebasing each January 1." ;
    gem:llmScopingNote """The service line's billed HCPCS/CPT procedure code, stored as a raw STRING (the object/graph analogue is gem:HCPCSprocedure, referenced by policy gem:coversProcedure/gem:excludesProcedure). Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "procCd" ;
    gem:memberOfOntology gem:gemOntology .

gem:procModifier1 a owl:DatatypeProperty ;
    gem:prefLabel "Procedure Modifier 1" ;
    gem:description "A 'Procedure Modifier 1' is a string datatype property that contains the first HCPCS modifier appended to the procedure code on a Medicare claim service line, qualifying or further specifying how the procedure or item was rendered." ;
    gem:llmScopingNote """HCPCS modifier slot 1 appended to the service line's procedure code (raw STRING); part of the positional array gem:procModifier1..5. The modifier value space corresponds to gem:HCPCSmodifier individuals. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "procModifier1" ;
    gem:memberOfOntology gem:gemOntology .

gem:procModifier2 a owl:DatatypeProperty ;
    gem:prefLabel "Procedure Modifier 2" ;
    gem:description "A 'Procedure Modifier 2' is a string datatype property that contains the second HCPCS modifier appended to the procedure code on a Medicare claim service line, qualifying or further specifying how the procedure or item was rendered." ;
    gem:llmScopingNote """HCPCS modifier slot 2 appended to the service line's procedure code (raw STRING); part of the positional array gem:procModifier1..5. The modifier value space corresponds to gem:HCPCSmodifier individuals. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "procModifier2" ;
    gem:memberOfOntology gem:gemOntology .

gem:procModifier3 a owl:DatatypeProperty ;
