# ============================================================================
#
#   Global Edit Model (GEM) Ontology
#
# ============================================================================
# ============================================================================
# NAMESPACE DECLARATIONS
# ============================================================================
#  This section identifies the namespaces that will be used by this ontology,
#  referring to external ontologies such as OWL, HCPCS, and ICD10, as well as
#  internal ontologies, such as GEM and RBCS.
#
#  Namespaces are assigned prefixes, making it easier to read which namespace
#  is managing each particular ontological term.  Ontological terms use 
#  prefixes to define the namespace portion of the globally unique identifier 
#  for the term.  For example, the class gem:MedicareClaim will map to the 
#  identifier <http://www.cms.hhs.gov/ontology/2026/08/GEM/MedicareClaim>, 
#  keeping the gem:MedicareClaim definition unique from any future Medicare 
#  Claim class found in an ontology that is co-located with GEM in a semantic
#  knowledge graph database.
#
# ----------------------------------------------------------------------------
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix dc:    <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

@prefix hcpcs: <http://purl.bioontology.org/ontology/HCPCS/> .
@prefix icd10: <http://purl.bioontology.org/ontology/ICD10CM/> .

@prefix gem:   <http://www.cms.hhs.gov/ontology/2026/08/GEM/> .
@prefix gemi:  <http://www.cms.hhs.gov/ontology/2026/08/GEM/instances/> .
@prefix rbcs:  <http://www.cms.hhs.gov/ontology/2026/08/RBCS/> .


# ============================================================================
# ONTOLOGY DECLARATION
# ============================================================================
# The ontology declaration creates a bounded space for the ontological terms
# and individuals (hard-coded data) that make up the ontology.
#
# owl:versionInfo is used to identify the ontology release version:
# - minor, non-breaking changes will increment the last value  x.x.###
#   namespace definitions will not change for non-breaking releases
#   and will retain a zero in the last value
# - non-minor, breaking changes will increment the second value x.###.0 while 
#   the last value may be reset to zero
# - major changes to the ontology, which typically include breaking changes, 
#   will increment the first value ###.0.0 while the second and last values 
#   may be reset to zero
#
#   1.0.0    2026-09-xx            First release
#
# -----------------------------------------------------------------------------
gem:gemOntology a owl:Ontology ;
    gem:prefLabel "GEM Ontology" ;
    dc:creator "Peraton" ;
    dc:description "An ontology that describes data and linkages between claims, GEM policy documents, and related CPT, HCPCS, ICD, and BETOS codes" ;
    owl:versionInfo "0.0.13"^^xsd:string ;
    owl:versionInfo "Distributed for review on August 7, 2026" ;
    gem:memberOfOntology gem:gemOntology .

#
#  The RBCS ontology is an "ontology within an ontology", in which all of the
#  data definitions are self-sufficient, but are managed within the GEM ontology
#  until there is a need to break out RBCS into its own standalone ontology to
#  support use cases outside of GEM.  Links between GEM and RBCS are owned by
#  the GEM ontological terms, anticipating that RBCS will someday be a separate
#  ontology.
#
rbcs:rbcsOntology a owl:Ontology ;
    rbcs:prefLabel "RBCS Ontology" ;
    dc:creator "Peraton" ;
    dc:description "An ontology that describes data and linkages between information that allows researchers to group Medicare Part B healthcare service codes into clinically meaningful categories and subcategories." ;
    owl:versionInfo "0.0.1"^^xsd:string ;
    owl:versionInfo "Distributed for review on May 22, 2026" ;
    rbcs:memberOfOntology rbcs:rbcsOntology .


# ============================================================================
# USE CASE INDIVIDUALS
# ============================================================================
#- Use Case Name
#
#- Brief Description
#
#- Pre-Conditions
#
#- Main Flow of Events
#
#- Alternative Flows
#
#- Exception Flows
#
#- Post Conditions


# ============================================================================
# BUSINESS RULE INDIVIDUALS
# ============================================================================
#- Business Rule Name
#
#- Brief Description
#
#- Full Description
#


# ============================================================================
# CORE ONTOLOGICAL TERM DEFINITIONS
# ============================================================================

# -----------------------------------------------------------------------------
#    Class Definitions
# -----------------------------------------------------------------------------
gem:BaseServiceLine a owl:Class ;
    gem:prefLabel "Base Service Line" ;
    gem:description "A 'Base Service Line' is a class that provides the fundamental, primary procedure code (the actual hospital/clinical service or pickup) that justifies and triggers separate claims for add-ons like mileage or supplemental payments." ;
    gem:llmDetailedDefinition """The base class shared by gem:ServiceLine and gem:HistoricServiceLine, holding the fundamental procedure code of a claim line. It is the domain of gem:hasICDdiagnosis -- the object-link bridge from a claim line to gem:ICDdiagnosis code individuals.""" ;
    gem:llmScopingNote """Claim-edit runtime; unpopulated in the current coverage-policy graph.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:Beneficiary a owl:Class ;
    gem:prefLabel "Beneficiary" ;
    gem:description "A 'Beneficiary' is a class that provides an individual who is enrolled in and entitled to receive health insurance benefits under the Medicare program. This typically includes U.S. citizens and permanent residents aged 65 or older, or those with certain qualifying disabilities or diseases." ;
    gem:llmScopingNote """The enrolled Medicare patient a claim is for, linked via gem:hasBeneficiary. Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    gem:isaPrimaryClass true ;
    gem:memberOfOntology gem:gemOntology .

gem:BusinessRule a owl:Class ;
    gem:prefLabel "Business Rule" ;
    gem:description "A 'Business Rule' is a class that provides brief, precise descriptions of policies or constraints that govern how an organization views and manages its data" ;
    gem:llmScopingNote """Ontology-governance / provenance construct: a gem:BusinessRule documents the guidance behind a schema term and is linked via gem:definedByBusinessRule. It is NOT Medicare coverage-domain content; ignore it when answering coverage questions.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:EditRequest a owl:Class ;
    gem:prefLabel "Edit Request" ;
    gem:description "An 'Edit Request' is a class that provides an automated, computerized rule used by the Centers for Medicare & Medicaid Services (CMS) and Medicare Administrative Contractors (MACs) to validate medical claims before payment. These rules ensure claims follow correct coding, coverage, and reimbursement policies." ;
    gem:llmDetailedDefinition """The input to the claim-edit engine: an automated pre-payment validation rule/request that wraps a gem:MedicareClaim (gem:hasMedicareClaim) plus prior gem:HistoricMedicareClaim context (gem:hasHistoricClaim). Its counterpart output is gem:EditResponse -> gem:EditResult.""" ;
    gem:llmScopingNote """The claim-edit runtime is the DOWNSTREAM adjudication model -- how extracted coverage policies would be applied to submitted claims -- not policy content. In the current corpus it is entirely UNPOPULATED (zero instances); the graph you query holds coverage-policy instance data. The join between the two worlds is the shared code space: a claim line's ICD-10, HCPCS, and modifier codes are the same gem:ICDdiagnosis / gem:HCPCSprocedure / gem:HCPCSmodifier individuals that policy covers*/excludes* predicates reference.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:EditResponse a owl:Class ;
    gem:prefLabel "Edit Response" ;
    gem:description "An 'Edit Response' is a class that provides an automated notification or rejection generated by the Centers for Medicare & Medicaid Services (CMS) or a Medicare Administrative Contractor (MAC). It informs a healthcare provider that a submitted claim contains coding errors, bundling conflicts, or policy violations, and explains why payment is being flagged, reduced, or denied." ;
    gem:llmDetailedDefinition """The edit engine's output notification for a claim -- flag, reduction, or denial with reasons. Carries one or more gem:EditResult via gem:hasEditResult, and may point to a violated claim via gem:hasViolatedMedicareClaim.""" ;
    gem:llmScopingNote """Claim-edit runtime output; unpopulated in the current coverage-policy graph.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:EditResult a owl:Class ;
    gem:prefLabel "Edit Result" ;
    gem:description "An 'Edit Result' is a class that provides the outcome generated by CMS automated software (like the Medicare Code Editor or OCE) when it scans a healthcare claim. The result indicates whether a submitted billing code is rejected, bundled, denied, or flagged for potential review based on Medicare’s national billing guidelines." ;
    gem:llmDetailedDefinition """A single outcome produced by automated edit software (e.g. Medicare Code Editor / OCE): rejected, bundled, denied, or flagged. Attaches a denial to the offending line via gem:hasDenial.""" ;
    gem:llmScopingNote """Claim-edit runtime output; unpopulated in the current coverage-policy graph.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:HistoricMedicareClaim a owl:Class ;
    gem:prefLabel "Historic Medicare Claim" ;
    gem:description "A 'Historic Medicare Claim' is a class that provides officially processed and fully adjudicated record of a past medical service, procedure, or prescription. These historic records are permanently stored in the CMS National Claims History (NCH) database for research, billing audits, and beneficiary reference." ;
    gem:llmScopingNote """An officially processed, fully adjudicated past claim (CMS National Claims History). Provided to the edit engine as prior context via gem:hasHistoricClaim. Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:HistoricServiceLine a owl:Class ;
    rdfs:subClassOf gem:BaseServiceLine ;
    gem:prefLabel "Historic Service Line" ;
    gem:description "A 'Historic Service Line' is a class that provides a distinct category of multidisciplinary clinical services tailored for a specific patient cohort that is an officially processed and fully adjudicated record of a past medical service, procedure, or prescription. Medicare defines and tracks these services through standardized Prospective Payment Systems (PPS) and HCPCS/CPT coding, determining coverage, policy, and reimbursement rates for beneficiaries." ;
    gem:llmScopingNote """An adjudicated past service line (subclass of gem:BaseServiceLine); part of the claim-history side of the edit runtime. Unpopulated in the current coverage-policy graph.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:MedicareClaim a owl:Class ;
    gem:prefLabel "Medicare Claim" ;
    gem:description "A 'Medicare Claim' is a class that provides a writing, identifying or permitting the identification of an enrollee, which requests payment for what appears to be Part B medical or other health services furnished by a physician or supplier." ;
    gem:llmDetailedDefinition """The root of the claim-edit runtime subgraph: a Part B payment-request record. Links to its billing lines via gem:hasServiceLine and to the patient via gem:hasBeneficiary; it is the object of the edit-engine's gem:hasMedicareClaim. Its diagnosis/procedure/modifier data lives in string datatype fields (gem:primaryDiagnosisCode, gem:diagnosisCode1..12, gem:procModifier1..5, gem:procedureCode) on the claim/line, with an object-link form to coded individuals via gem:hasICDdiagnosis.""" ;
    gem:llmScopingNote """The claim-edit runtime is the DOWNSTREAM adjudication model -- how extracted coverage policies would be applied to submitted claims -- not policy content. In the current corpus it is entirely UNPOPULATED (zero instances); the graph you query holds coverage-policy instance data. The join between the two worlds is the shared code space: a claim line's ICD-10, HCPCS, and modifier codes are the same gem:ICDdiagnosis / gem:HCPCSprocedure / gem:HCPCSmodifier individuals that policy covers*/excludes* predicates reference.""" ;
    gem:isaPrimaryClass true ;
    gem:memberOfOntology gem:gemOntology .

gem:ServiceLine a owl:Class ;
    rdfs:subClassOf gem:BaseServiceLine ;
    gem:prefLabel "Service Line" ;
    gem:description "A 'Service Line' is a class that provides either an individual billing line item on a Medicare medical claim or a strategic, integrated unit of care within a healthcare system organized around a specific medical condition or patient population.  A specific set of medical services grouped by condition or patient need (e.g., cardiology, oncology) to improve care delivery." ;
    gem:llmDetailedDefinition """An individual billing line item on a Medicare claim (subclass of gem:BaseServiceLine), carrying that line's procedure code, modifiers, units, amounts, and diagnosis pointers. Reached from a claim via gem:hasServiceLine; a denial attaches to it via gem:hasDenial.""" ;
    gem:llmScopingNote """Part of the claim-edit runtime model; unpopulated in the current coverage-policy graph.""" ;
    gem:memberOfOntology gem:gemOntology .

gem:UseCase a owl:Class ;
    gem:prefLabel "Use Case" ;
    gem:description "A 'Use Case' is a class that provides the textual documentation of an interaction with a business process or IT system in order to achieve something of value (a goal). There are two common formats used for creating use case descriptions. One is the narrative form which describes the interaction in paragraphs, much like telling a story. The other is the dialogue or conversational form, which describes the interaction just as two people might have dialogue, i.e., the actor does A, then the system does B in response." ;
    gem:llmScopingNote """Ontology-governance construct for dependency/impact analysis (a term is linked to a use case via gem:supportsUseCase). Not Medicare coverage-domain content; ignore for coverage answering.""" ;
    gem:memberOfOntology gem:gemOntology .

# -----------------------------------------------------------------------------
#    Relationship Definitions
# -----------------------------------------------------------------------------
gem:definedByBusinessRule a owl:ObjectProperty ;
    gem:prefLabel "Defined By Business Rule" ;
    gem:description "A 'Defined By Business Rule' is a relationship that links an ontological term to business guidance that directs its existence, purpose, and operation.  Connecting an ontological term to its business rule establishes the provinance of the ontological term's definition.  Any term may have more than one business rule guiding the definition of the term." ;
    gem:llmScopingNote """Ontology-governance / provenance predicate (domain owl:Thing) linking any schema term to the gem:BusinessRule guidance behind its definition. Not coverage-domain content; ignore for coverage answering.""" ;
    rdfs:domain owl:Thing ;    
# The use of owl:Thing here means that any ontological term (Class, ObjectProperty, DatatypeProperty, etc.) can be linked to a business rule.
    rdfs:range gem:BusinessRule ;
    gem:memberOfOntology gem:gemOntology .

gem:hasBeneficiary a owl:ObjectProperty ;
    gem:prefLabel "Has Beneficiary" ;
    gem:description "A 'Has Beneficiary' is a relationship that links a Medicare Claim to a Beneficiary." ;
    gem:llmScopingNote """Links a gem:MedicareClaim to its gem:Beneficiary. Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    rdfs:domain gem:MedicareClaim ;
    rdfs:range gem:Beneficiary ;
    gem:memberOfOntology gem:gemOntology .

gem:hasDenial a owl:ObjectProperty ;
    gem:prefLabel "Has Denial" ;
    gem:description "A 'Has Denial' is a relationship that links an Edit Result to a Service Line.  When a Medicare claim service line definition clashes with a Medicare Edit Result, the claim service line's submitted CPT/HCPCS code, units of service, or modifiers fail to satisfy Medicare's automated adjudication logic, leading to claim line rejection, denial, or bundling." ;
    gem:llmScopingNote """Links a gem:EditResult to the gem:ServiceLine it denies/rejects/bundles. Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    rdfs:domain gem:EditResult ;
    rdfs:range gem:ServiceLine ;
    gem:memberOfOntology gem:gemOntology .

gem:hasEditResult a owl:ObjectProperty ;
    gem:prefLabel "Has Edit Result" ;
    gem:description "A 'Has Edit Response' is a relationship that links an Edit Response to one or more Edit Results.  When a Medicare claim is submitted, it is reviewed by automated software like the Medicare Code Editor (MCE) or Outpatient Code Editor (OCE). An Edit Response is the system's defined reaction to an issue found in a code—such as an invalid code, age/sex conflict, or a non-covered procedure." ;
    gem:llmScopingNote """Links a gem:EditResponse to one or more gem:EditResult outcomes. Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    rdfs:domain gem:EditResponse ;
    rdfs:range gem:EditResult ;
    gem:memberOfOntology gem:gemOntology .

gem:hasHistoricClaim a owl:ObjectProperty ;
    gem:prefLabel "Has Historic Claim" ;
    gem:description "A 'Has Historic Claim' is a relationship that links an Edit Request to a Historic Medicare Claim." ;
    gem:llmScopingNote """Links an gem:EditRequest to a gem:HistoricMedicareClaim supplied as prior-adjudication context. Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    rdfs:domain gem:EditRequest ;
    rdfs:range gem:HistoricMedicareClaim ;
    gem:memberOfOntology gem:gemOntology .

gem:hasHistoricServiceLine a owl:ObjectProperty ;
    gem:prefLabel "Has Historic Service Line" ;
    gem:description "A 'Has Historic Service Line' is a relationship that links a Historic Medicare Claim to a Historic Medicare Service Line." ;
    gem:llmScopingNote """Links a claim/historic claim to a gem:HistoricServiceLine. Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    rdfs:domain gem:HistoricMedicareClaim ;
    rdfs:range gem:HistoricMedicareServiceLine ;
    gem:memberOfOntology gem:gemOntology .

gem:hasICDdiagnosis a owl:ObjectProperty ;
    gem:prefLabel "Has ICD Diagnosis" ;
    gem:description "A 'Has ICD Diagnosis' is a relationship that links a Base Service Line to an ICD-10-CM Diagnosis code.  The range value is an instance of ICD Diagnosis." ;
    gem:llmDetailedDefinition """THE object-link bridge from a claim line (domain gem:BaseServiceLine) to an ICD-10-CM code INDIVIDUAL (range gem:ICDdiagnosis). Only gem:ICDdiagnosis members are valid objects -- gem:ICDgrouping ranges are NOT. This is the claim-side counterpart to the policy-side condition links: the same gem:ICDdiagnosis individuals appear here (on a claim line) and as objects of gem:coversCondition / gem:excludesCondition / gem:exclusivelyCoversCondition (on a policy).""" ;
    gem:llmScopingNote """Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    gem:llmTraversalHint """This property is the natural join for matching a claim to policy coverage: a line's gem:hasICDdiagnosis object is the same node a policy's condition-polarity predicates point at, so 'is this claim's diagnosis covered by policy P?' unifies a claim-line gem:hasICDdiagnosis with P's gem:exclusivelyCoversCondition/gem:coversCondition on the shared gem:ICDdiagnosis individual. Note the string/object duality: the raw code string also lives in gem:primaryDiagnosisCode / gem:diagnosisCode1..12.""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range gem:ICDdiagnosis ;
    gem:memberOfOntology gem:gemOntology .

gem:hasMedicareClaim a owl:ObjectProperty ;
    gem:prefLabel "Has Medicare Claim" ;
    gem:description "A 'Has Medicare Claim' is a relationship that links a Medicare Claim to an Edit Request or an Edit Response." ;
    gem:llmScopingNote """Links an gem:EditRequest / gem:EditResponse to the gem:MedicareClaim under adjudication. Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    rdfs:domain gem:EditRequest , gem:EditResponse;
    rdfs:range gem:MedicareClaim ;
    gem:memberOfOntology gem:gemOntology .

gem:hasServiceLine a owl:ObjectProperty ;
    gem:prefLabel "Has Service Line" ;
    gem:description "A 'Has Service Line' is a relationship that links a Medicare Claim to a Medicare Service Line." ;
    gem:llmScopingNote """Links a gem:MedicareClaim to its gem:ServiceLine billing line items. Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    rdfs:domain gem:MedicareClaim ;
    rdfs:range gem:MedicareServiceLine ;
    gem:memberOfOntology gem:gemOntology .

gem:hasViolatedMedicareClaim a owl:ObjectProperty ;
    gem:prefLabel "Has Violated Medicare Claim" ;
    gem:description "A 'Has Violated Medicare Claim' is a relationship that links an Edit Response to a Violated Medicare Claim.  A violated Medicare claim (often classified as Medicare fraud or a False Claims Act violation) is any knowingly false or misrepresented bill submitted to the federal government. These claims result in unauthorized Medicare payments, intentionally attempting to collect money for services never earned or falsely certified." ;
    gem:llmScopingNote """Links a gem:EditResponse to a fraud/False-Claims-flagged gem:MedicareClaim. Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    rdfs:domain gem:EditResponse ;
    rdfs:range gem:MedicareClaim ;
    gem:memberOfOntology gem:gemOntology .

gem:hasViolatedHistoricClaim a owl:ObjectProperty ;
    gem:prefLabel "Has Violated Historic Medicare Claim" ;
    gem:description "A 'Has Violated Historic Medicare Claim' is a relationship that links an Edit Response to a Violated Historic Medicare Claim.  A Violated Historic Medicare Claim is not an official Medicare designation, but typically refers to a past claim that violated Medicare regulations, was billed fraudulently, or contained errors that led to overpayment." ;
    gem:llmScopingNote """Violation-flagged counterpart pointing to a gem:HistoricMedicareClaim. Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    rdfs:domain gem:EditResponse ;
    rdfs:range gem:HistoricMedicareClaim ;
    gem:memberOfOntology gem:gemOntology .

gem:hasViolatedBaseServiceLine a owl:ObjectProperty ;
    gem:prefLabel "Has Violated Base Service Line" ;
    gem:description "A 'Has Violated Base Service Line' is a relationship that links a Medicare Claim to a Medicare Service Line." ;
    gem:llmScopingNote """Links a claim to a violation-flagged service line. Claim-runtime; unpopulated in the current coverage-policy graph.""" ;
    rdfs:domain gem:EditResult ;
    rdfs:range gem:BaseServiceLine ;
    gem:memberOfOntology gem:gemOntology .

gem:supportsUseCase a owl:ObjectProperty ;
    gem:prefLabel "Supports Use Case" ;
    gem:description "A 'Supports Use Case' is a relationship that links an ontological term the use case that requires the term in order to operate properly.  Connecting an ontological term to its use case supports the analysis of dependency matrices, which can be used to determine the business impact of deprecating or removing the term from a future version of the ontology." ;
    gem:llmScopingNote """Ontology-governance predicate (domain owl:Thing) linking any schema term to a gem:UseCase for dependency/impact analysis. Not coverage-domain content; ignore for coverage answering.""" ;
    rdfs:domain owl:Thing ;    # The use of owl:Thing here means that any ontological term (Class, ObjectProperty, DatatypeProperty, etc.) can be linked to a use case.
    rdfs:range gem:UseCase ;
    gem:memberOfOntology gem:gemOntology .

# -----------------------------------------------------------------------------
#    Property Definitions
# -----------------------------------------------------------------------------
gem:actionCode a owl:DatatypeProperty ;
    gem:prefLabel "Action Code" ;
    gem:description "An 'Action Code' is a datatype property that contains ..." ;
    gem:llmScopingNote """A coded processing-action indicator; its value space is an external CMS code set, not enumerated in this ontology. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:integer ;
    gem:sourceAttribute "actionCode" ;
    gem:memberOfOntology gem:gemOntology .

gem:admissionDate a owl:DatatypeProperty ;
    gem:prefLabel "Admission Date" ;
    gem:description "An 'Admission Date' is a date datatype property that contains the date on which the patient was admitted to the facility billed on a Medicare institutional claim." ;
    gem:llmScopingNote """Institutional-claim admission date. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:date ;
    gem:sourceAttribute "admissionDt" ;
    gem:memberOfOntology gem:gemOntology .

gem:allowChargeAmount a owl:DatatypeProperty ;
    gem:prefLabel "Allow Charge Amount" ;
    gem:description "An 'Allow Charge Amount' is a double datatype property that contains the dollar amount Medicare allows as payment for the service billed on a claim line, as determined by the applicable Medicare fee schedule." ;
    gem:llmScopingNote """Allowed-charge amount. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:double ;
    gem:sourceAttribute "allowChgAmt" ;
    gem:memberOfOntology gem:gemOntology .

gem:attendingNPI a owl:DatatypeProperty ;
    gem:prefLabel "Attending NPI" ;
    gem:description "An 'Attending NPI' is a string datatype property that contains the National Provider Identifier (NPI) of the physician attending the patient as recorded on a Medicare institutional claim." ;
    gem:llmScopingNote """NPI of the attending provider. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "attendNpi" ;
    gem:memberOfOntology gem:gemOntology .

gem:attendingSpecialtyCode a owl:DatatypeProperty ;
    gem:prefLabel "Attending Specialty Code" ;
    gem:description "An 'Attending Specialty Code' is a string datatype property that contains the CMS Medicare specialty code of the attending physician on a Medicare institutional claim." ;
    gem:llmScopingNote """Attending-provider specialty code. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "attendSpcCd" ;
    gem:memberOfOntology gem:gemOntology .

gem:beneficiaryHICN a owl:DatatypeProperty ;
    gem:prefLabel "Beneficiary HICN" ;
    gem:description "A 'Beneficiary HICN' is a string datatype property that contains the Health Insurance Claim Number (HICN) of the Medicare beneficiary, the historical beneficiary identifier replaced by the Medicare Beneficiary Identifier (MBI) in 2020." ;
    gem:llmScopingNote """Beneficiary Health Insurance Claim Number (legacy Medicare beneficiary identifier). Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "BeneHicn" ;
    gem:memberOfOntology gem:gemOntology .

gem:billingNPI a owl:DatatypeProperty ;
    gem:prefLabel "Billing NPI" ;
    gem:description "A 'Billing NPI' is a string datatype property that contains the National Provider Identifier (NPI) of the billing provider - the entity submitting the claim and receiving payment - as recorded on a Medicare claim." ;
    gem:llmScopingNote """NPI of the billing provider. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "billNpi" ;
    gem:memberOfOntology gem:gemOntology .

gem:billingPTAN a owl:DatatypeProperty ;
    gem:prefLabel "Billing PTAN" ;
    gem:description "A 'Billing PTAN' is a string datatype property that contains the Provider Transaction Access Number (PTAN) of the billing provider on a Medicare claim, a Medicare-specific provider identifier issued by the Medicare Administrative Contractor (MAC)." ;
    gem:llmScopingNote """Billing provider's PTAN (Medicare legacy provider identifier). Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "billPtan" ;
    gem:memberOfOntology gem:gemOntology .

gem:billingType a owl:DatatypeProperty ;
    gem:prefLabel "Billing Type" ;
    gem:description "A 'Billing Type' is a string datatype property that contains the Type of Bill (TOB) code on a Medicare institutional claim - a three- or four-character code identifying the facility type, bill classification, and billing frequency." ;
    gem:llmScopingNote """Type-of-bill code (institutional claims); an external CMS/NUBC code set, not enumerated here. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "billType" ;
    gem:memberOfOntology gem:gemOntology .

