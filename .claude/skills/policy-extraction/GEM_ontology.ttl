gem:reimbursementAmount a owl:DatatypeProperty ;
    gem:prefLabel "Reimbursement Amount" ;
    gem:description "A 'Reimbursement Amount' is a datatype property that contains ..." ;
    gem:llmScopingNote """Reimbursement amount. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
