    gem:llmScopingNote """Claim statement-covers-from date (billing-period start). Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
