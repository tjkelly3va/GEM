gem:referringNPI a owl:DatatypeProperty ;
    gem:prefLabel "Referring NPI" ;
    gem:description "A 'Referring NPI' is a string datatype property that contains the National Provider Identifier (NPI) of the physician who referred the patient for the service billed on a Medicare claim." ;
