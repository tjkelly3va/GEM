    gem:prefLabel "Sequence Number" ;
    gem:description "A 'Sequence Number' is a datatype property that contains ..." ;
    gem:llmScopingNote """Sequence number ordering records. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
