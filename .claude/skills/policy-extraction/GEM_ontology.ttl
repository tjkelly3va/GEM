    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "providerSpecialty" ;
    gem:memberOfOntology gem:gemOntology .

gem:providerTaxonomy a owl:DatatypeProperty ;
    gem:prefLabel "Provider Taxonomy" ;
    gem:description "A 'Provider Taxonomy' is a string datatype property that contains the Healthcare Provider Taxonomy code (NUCC) of the provider rendering the service billed on a Medicare claim, identifying the provider's classification, specialization, or area of practice." ;
    gem:llmScopingNote """Provider taxonomy code (NUCC specialty classification). Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "providerTaxonomy" ;
    gem:memberOfOntology gem:gemOntology .

gem:providerTIN a owl:DatatypeProperty ;
    gem:prefLabel "Provider TIN" ;
    gem:description "A 'Provider TIN' is a string datatype property that contains the Tax Identification Number (TIN) of the provider entity on a Medicare claim, used by the IRS to identify the entity." ;
    gem:llmScopingNote """Provider Tax Identification Number. Claim/service-line runtime field; unpopulated in the current coverage-policy instance graph (see gem:MedicareClaim).""" ;
    rdfs:domain gem:BaseServiceLine ;
    rdfs:range  xsd:string ;
    gem:sourceAttribute "providerTin" ;
    gem:memberOfOntology gem:gemOntology .

gem:providerReimbursementAmount a owl:DatatypeProperty ;
    gem:prefLabel "Provider Reimbursement Amount" ;
    gem:description "A 'Provider Reimbursement Amount' is a datatype property that contains ..." ;
