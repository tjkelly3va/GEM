# ============================================================================
#
#   GEM Code Group Instances
#
# ============================================================================
#  This file holds gem:CodeGroup instances -- named, reusable sets of billing
#  codes (HCPCS Level II, CPT Level I, ICD-10-CM) that generalize a collection
#  of codes under a single queryable term, so a query can name the group
#  instead of enumerating individual code strings. Membership is enumerated via
#  skos:narrower (curated core) and/or, for prefix-defined groups, via
#  gem:memberCodePattern (planned). A group MAY identify gem:ClinicalConcept
#  individuals (gem:identifiesClinicalConcept) and carries a responsible party
#  (gem:codeGroupOwner; CMS-policy-derived groups carry "CMS").
#
#  This is an INSTANCES file. Schema terms (classes, properties) live in
#  GEM_ontology.ttl and are NOT redefined here. Instance URIs use the gemi:
#  namespace; schema terms use gem:. Code-member IRIs reference the external
#  HCPCS (hcpcs:), CPT (cpt:), and ICD-10-CM (icd10:) code namespaces; those
#  codes are typed by the conversion queries, not in this file.
#
# ============================================================================

# ----------------------------------------------------------------------------
# NAMESPACE DECLARATIONS
# ----------------------------------------------------------------------------
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dc:    <http://purl.org/dc/elements/1.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

@prefix hcpcs: <http://purl.bioontology.org/ontology/HCPCS/> .
@prefix icd10: <http://purl.bioontology.org/ontology/ICD10CM/> .
@prefix cpt:   <https://www.ama-assn.org/cpt#> .

@prefix gem:   <http://www.cms.hhs.gov/ontology/2026/08/GEM/> .
@prefix gemi:  <http://www.cms.hhs.gov/ontology/2026/08/GEM/instances/> .

# ----------------------------------------------------------------------------
# CODE GROUP INDIVIDUALS
# ----------------------------------------------------------------------------

gemi:codeGroupRAD a gem:CodeGroup ;
    gem:prefLabel "Respiratory Assist Devices (RADs)" ;
    gem:description "Respiratory Assist Devices (RADs): the category of bi-level positive airway pressure devices used for noninvasive ventilation in the home (HCPCS E0470-E0472), as discussed in NCD 240.9." ;
    gem:workflowDescription "Respiratory Assist Devices (RADs) -- the category of durable medical equipment comprising bi-level positive airway pressure devices used for noninvasive ventilation in the home, as discussed in NCD 240.9. Curated-core membership is the HCPCS Level II code range E0470-E0472 (E0470 without backup rate; E0471 with backup rate; E0472 with backup rate for use with an invasive interface). Membership is an SME assertion; the NCD describes the device category in prose rather than enumerating these codes verbatim." ;
    gem:codeGroupOwner "CMS" ;
    gem:identifiesClinicalConcept gemi:conceptRespiratoryAssistDevice ;
    skos:narrower hcpcs:E0470 ,
                  hcpcs:E0471 ,
                  hcpcs:E0472 ;
    gem:memberOfOntology gem:gemOntology ;
    dc:source gemi:ncd240.9 .

gemi:codeGroupOxygenDelivery a gem:CodeGroup ;
    gem:prefLabel "Oxygen Delivery Systems and Related Supplies" ;
    gem:description "Oxygen Delivery Systems and Related Supplies: the category of stationary and portable oxygen delivery systems (gaseous and liquid) and their oxygen contents, as governed by NCD 240.2." ;
    gem:workflowDescription "Oxygen Delivery Systems and Related Supplies -- the category of durable medical equipment and supplies comprising stationary and portable oxygen delivery systems (gaseous and liquid) together with their oxygen contents, as governed by NCD 240.2 (Home Use of Oxygen). Curated-core membership is the valid HCPCS Level II codes within the range E0424-E0444: E0424, E0425, E0430, E0431, E0433, E0434, E0435, E0439, E0440, E0441, E0442, E0443, E0444 (13 codes). The eight integer values within the range that are not assigned HCPCS codes (E0426, E0427, E0428, E0429, E0432, E0436, E0437, E0438) are intentionally excluded; no phantom codes are minted. Membership is an SME assertion, supplied by the project lead as a code range rather than enumerated verbatim in a single policy document." ;
    gem:codeGroupOwner "CMS" ;
    gem:identifiesClinicalConcept gemi:conceptOxygenEquipment ;
    skos:narrower hcpcs:E0424 ,
                  hcpcs:E0425 ,
                  hcpcs:E0430 ,
                  hcpcs:E0431 ,
                  hcpcs:E0433 ,
                  hcpcs:E0434 ,
                  hcpcs:E0435 ,
                  hcpcs:E0439 ,
                  hcpcs:E0440 ,
                  hcpcs:E0441 ,
                  hcpcs:E0442 ,
                  hcpcs:E0443 ,
                  hcpcs:E0444 ;
    gem:memberOfOntology gem:gemOntology ;
    dc:source gemi:ncd240.2 .

gemi:codeGroupHCPCSAcodes a gem:CodeGroup ;
    gem:prefLabel "HCPCS Level II A Codes -- Transportation, Supplies, Administrative" ;
    gem:description "HCPCS Level II A Codes -- the structural letter category of the HCPCS Level II code system. Per the project category list: Ambulance services, medical and surgical supplies, skin substitutes, and administrative items." ;
    gem:workflowDescription "Membership is pattern-defined via gem:memberCodePattern -- all HCPCS Level II procedure/item codes with the 'A' prefix (the letter followed by four digits) -- rather than an enumerated skos:narrower curated core, so the group stays a few triples instead of enumerating the full category. This is a structural division of the HCPCS code system itself, not a coverage-policy-derived group: owner CMS, no dc:source, and it identifies no single clinical concept. Introduced 2026-06-30 (Session 104)." ;
    gem:codeGroupOwner "CMS" ;
    gem:memberCodePattern "^http://purl\\.bioontology\\.org/ontology/HCPCS/A\\d{4}$" ;
    gem:memberOfOntology gem:gemOntology .

