gemi:codeGroupDiabetes a gem:CodeGroup ;
    gem:prefLabel "Diabetes" ;
    skos:altLabel "Type 2 diabetes mellitus" ;
    gem:description "Diabetes: a grouping of the ICD-10-CM diagnosis codes for type 2 diabetes mellitus, comprising the E11 category and all its subcodes." ;
    gem:workflowDescription "Diabetes -- an analyst-defined grouping of the ICD-10-CM diagnosis codes for type 2 diabetes mellitus. Membership is pattern-defined via gem:memberCodePattern: all ICD-10-CM codes in category E11 (the E11 category header and every E11.x subcode). Named colloquially -- in common use diabetes refers to type 2 diabetes mellitus (ICD-10-CM E11); type 1 diabetes (E10) and other or secondary forms (E08, E09, E13) are not members. This is the project first ICD-10-CM code group and first non-HCPCS pattern group; being an ICD-10 group it contributes no materialized gem:refersToCodeGroup links (the codegroup_link_drift guard is HCPCS-only). Owner CMS; no dc:source (a grouping over the ICD-10-CM code system, not derived from a single coverage policy). Introduced 2026-07-01 (Session 108)." ;
    gem:codeGroupOwner "CMS" ;
    gem:identifiesClinicalConcept gemi:conceptTypeIIDiabetes ;
    gem:memberCodePattern "^http://purl\\.bioontology\\.org/ontology/ICD10CM/E11(\\.[A-Za-z0-9]{1,4})?$" ;
    gem:memberOfOntology gem:gemOntology .

gemi:codeGroupOxygenEquipment a gem:CodeGroup ;
    gem:prefLabel "Oxygen Equipment" ;
    gem:description "Oxygen Equipment: a grouping of HCPCS Level II codes in the ranges E0400-E0493 and E1300-E1499." ;
    gem:workflowDescription "Oxygen Equipment -- an analyst-defined grouping of HCPCS Level II codes in the author-specified ranges E0400-E0493 and E1300-E1499. Membership is pattern-defined via two gem:memberCodePattern regexes, one per range, matched against HCPCS code IRIs; as of HCPCS 2025aa the ranges resolve to 57 currently-assigned codes (40 in E0400-E0493, 17 in E1300-E1499). The ranges are the author specification and span oxygen delivery systems and contents (E0424-E0447), oxygen accessories and concentrators (E1352-E1358, E1390-E1392, E1405-E1406), together with other respiratory and durable medical equipment falling within the ranges -- for example home ventilators (E0465-E0469), respiratory assist devices (E0470-E0472), respiratory and airway-clearance devices (E0480-E0487), neuromuscular airway devices (E0490-E0493), the immersion heater for nebulizer (E1372), whirlpool and hydrotherapy equipment (E1300-E1310), and the miscellaneous-DME code E1399. Membership is therefore by range, not a narrow oxygen-delivery-only assertion. Overlaps other groups by design: codeGroupOxygenDelivery (E0424-E0444) and codeGroupRAD (E0470-E0472) are subsets. First range-defined (non-simple-prefix) pattern group. Owner CMS; no dc:source (not derived from a single coverage policy). Introduced 2026-07-01 (Session 108)." ;
    gem:codeGroupOwner "CMS" ;
    gem:identifiesClinicalConcept gemi:conceptOxygenEquipment ;
    gem:memberCodePattern "^http://purl\\.bioontology\\.org/ontology/HCPCS/E04(0\\d|[1-8]\\d|9[0-3])$" ;
    gem:memberCodePattern "^http://purl\\.bioontology\\.org/ontology/HCPCS/E1[34]\\d{2}$" ;
    gem:memberOfOntology gem:gemOntology .
