################################################################################
# cpt.ttl — CPT Code Test Fixture
# Namespace : https://www.ama-assn.org/cpt#
# Format    : Turtle / SKOS
# Purpose   : GEM test fixture; seed codes drawn from NCS/EMG policy family
#             (A54969) and E/M office visit codes for category breadth.
#
# PROVISIONAL SCHEMA NOTE: This schema was designed for a small fixture dataset.
# The class hierarchy (cpt:CPTCode, cpt:CPTHeading), predicate set, and heading
# structure may need revision once a full AMA CPT dataset is available.
#
# Predicate mapping (UMLS CPT source representation → cpt: namespace):
#   CPT_Code (type 104)                    → cpt:code             (xsd:string)
#   Descriptor / long (type 106)           → cpt:longDescriptor   (xsd:string)
#   Medium_Descriptor / 48-char (type 110) → cpt:mediumDescriptor (xsd:string)
#   Short_Descriptor / 28-char (type 111)  → cpt:shortDescriptor  (xsd:string)
#   First_Appearance (type 101)            → cpt:firstAppearance  (xsd:gYear)
#   Last_Revised (type 120)                → cpt:lastRevised      (xsd:gYear)
#   Addon_Code (type 102)                  → cpt:addonCode        (xsd:boolean)
#   Reportable (type 103)                  → cpt:reportable       (xsd:boolean)
#   CPT_Level (type 109)                   → cpt:level            (xsd:string)
#   Moderate_Conscious_Sedation (type 105) → cpt:moderateConsciousSedation (xsd:boolean)
#
# Hierarchy: skos:broader links cpt:CPTCode individuals to cpt:CPTHeading
#   individuals (the query-writer direction: query writers know the CPT code
#   and ask for its heading). skos:narrower is the owl:inverseOf and is left
#   to the reasoner rather than asserted here. Three headings cover the seed
#   code families: NerveCondStudiesHeading, NeedleEMGHeading, EandMHeading.
#
# Retained SKOS/OWL predicates: skos:inScheme, skos:broader,
#   skos:Concept (by subclass inference), owl:Ontology on header.
#
# Sources: AMA CPT / UMLS Metathesaurus; CMS Medicare Coverage Database
#   (A54969, A56619, A57478); AANEM NCS/EMG coding guidance.
################################################################################

@prefix cpt:    <https://www.ama-assn.org/cpt#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .

################################################################################
# Ontology header
################################################################################

<https://www.ama-assn.org/cpt>
    a owl:Ontology ;
    rdfs:label "CPT Code Test Fixture"@en ;
    rdfs:comment "Small SKOS-based fixture of CPT codes for GEM triplestore testing. Seed codes are drawn from the NCS/EMG policy family (A54969) and E/M office visit category. Schema is provisional pending availability of a full AMA CPT dataset."@en .

################################################################################
# Class definitions
################################################################################

cpt:CPTCode
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "CPT Code"@en ;
    rdfs:comment "A billable AMA Current Procedural Terminology code, including add-on codes. Subclass of skos:Concept."@en .

cpt:CPTHeading
    a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "CPT Heading"@en ;
    rdfs:comment "A structural heading or subheading in the AMA CPT codebook hierarchy. Not directly billable. Subclass of skos:Concept."@en .

################################################################################
# Property definitions
################################################################################

cpt:code
    a owl:DatatypeProperty ;
    rdfs:label "CPT code"@en ;
    rdfs:comment "The 5-character AMA CPT code string. Corresponds to UMLS CPT Property Type 104 (CPT_Code)."@en ;
    rdfs:domain cpt:CPTCode ;
    rdfs:range xsd:string .

cpt:longDescriptor
    a owl:DatatypeProperty ;
    rdfs:label "long descriptor"@en ;
    rdfs:comment "Full description of the CPT concept as listed in the CPT codebook. Corresponds to UMLS CPT Property Type 106 (Descriptor), TTY=PT."@en ;
    rdfs:range xsd:string .

cpt:mediumDescriptor
    a owl:DatatypeProperty ;
    rdfs:label "medium descriptor"@en ;
    rdfs:comment "Descriptor limited to 48 characters. Corresponds to UMLS CPT Property Type 110 (Medium_Descriptor)."@en ;
    rdfs:range xsd:string .

cpt:shortDescriptor
    a owl:DatatypeProperty ;
    rdfs:label "short descriptor"@en ;
    rdfs:comment "Descriptor limited to 28 characters. Corresponds to UMLS CPT Property Type 111 (Short_Descriptor)."@en ;
    rdfs:range xsd:string .

cpt:firstAppearance
    a owl:DatatypeProperty ;
    rdfs:label "first appearance"@en ;
    rdfs:comment "The year the CPT code was first introduced. Corresponds to UMLS CPT Property Type 101 (First_Appearance)."@en ;
    rdfs:range xsd:gYear .

cpt:lastRevised
    a owl:DatatypeProperty ;
    rdfs:label "last revised"@en ;
    rdfs:comment "The year the CPT code was last revised. Corresponds to UMLS CPT Property Type 120 (Last_Revised)."@en ;
    rdfs:range xsd:gYear .

cpt:addonCode
    a owl:DatatypeProperty ;
    rdfs:label "add-on code"@en ;
    rdfs:comment "True if this CPT code is an add-on code that must be reported with a primary procedure code. Corresponds to UMLS CPT Property Type 102 (Addon_Code)."@en ;
    rdfs:domain cpt:CPTCode ;
    rdfs:range xsd:boolean .

cpt:reportable
    a owl:DatatypeProperty ;
    rdfs:label "reportable"@en ;
    rdfs:comment "True if this CPT code is reportable (billable); false for headings and subheadings. Corresponds to UMLS CPT Property Type 103 (Reportable)."@en ;
    rdfs:range xsd:boolean .

cpt:level
    a owl:DatatypeProperty ;
    rdfs:label "CPT level"@en ;
    rdfs:comment "Hierarchical level indicator from AMA CPT DTK: PC (parent code), CC (child/add-on code), H1-H6 (heading levels 1-6), HS (small-family heading). Corresponds to UMLS CPT Property Type 109 (Level)."@en ;
    rdfs:range xsd:string .

cpt:moderateConsciousSedation
    a owl:DatatypeProperty ;
    rdfs:label "moderate conscious sedation"@en ;
    rdfs:comment "True if this CPT code is marked with the moderate (conscious) sedation symbol in the AMA CPT codebook. Corresponds to UMLS CPT Property Type 105 (Moderate_Conscious_Sedation)."@en ;
    rdfs:domain cpt:CPTCode ;
    rdfs:range xsd:boolean .

cpt:provisional
    a owl:DatatypeProperty ;
    rdfs:label "provisional"@en ;
    rdfs:comment "True for codes added provisionally to this fixture: the code itself is recorded but the AMA descriptor is omitted (copyrighted) pending the CMS-managed CPT file. Distinguishes bulk-added provisional codes from the hand-curated seed codes. GEM-side; not a UMLS CPT property."@en ;
    rdfs:domain cpt:CPTCode ;
    rdfs:range xsd:boolean .

################################################################################
# Concept Scheme
################################################################################

cpt:CPTConceptScheme
    a skos:ConceptScheme ;
    rdfs:label "Current Procedural Terminology (CPT)"@en ;
    rdfs:comment "AMA Current Procedural Terminology code set, represented as a SKOS concept scheme for GEM testing."@en .

################################################################################
# Heading nodes
################################################################################

cpt:NerveCondStudiesHeading
    a cpt:CPTHeading ;
    skos:inScheme cpt:CPTConceptScheme ;
    cpt:longDescriptor "Nerve Conduction Studies"@en ;
    cpt:mediumDescriptor "Nerve Conduction Studies"@en ;
    cpt:shortDescriptor "Nerve Conduction Studies"@en ;
    cpt:reportable "false"^^xsd:boolean ;
    cpt:level "H2" .

cpt:NeedleEMGHeading
    a cpt:CPTHeading ;
    skos:inScheme cpt:CPTConceptScheme ;
    cpt:longDescriptor "Needle Electromyography"@en ;
    cpt:mediumDescriptor "Needle Electromyography"@en ;
    cpt:shortDescriptor "Needle EMG"@en ;
    cpt:reportable "false"^^xsd:boolean ;
    cpt:level "H2" .

cpt:EandMHeading
    a cpt:CPTHeading ;
    skos:inScheme cpt:CPTConceptScheme ;
    cpt:longDescriptor "Evaluation and Management - Office or Other Outpatient Services"@en ;
    cpt:mediumDescriptor "E/M Office or Outpatient Services"@en ;
    cpt:shortDescriptor "E/M Office/Outpatient"@en ;
    cpt:reportable "false"^^xsd:boolean ;
    cpt:level "H2" .

